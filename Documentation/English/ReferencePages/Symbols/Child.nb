Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A condition on the child stage cannot use a name bound in the parent stage:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<div id=\\\"x\\\"><p>one</p></div><div id=\\\"y\\\"><p>two</p></div>\",{\"HTML\",\"XMLObject\"}];
XMLCases[tree,Child[XMLPattern[\"div\",\"id\"->id_],XMLPattern[\"p\"]/;id===\"x\"]]"], "Input"],

