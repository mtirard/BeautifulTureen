Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A name on the constraint itself issues a message:", "ExampleText"], Cell[BoxData["lists = ImportString[\"<ul><li>Home</li></ul>\", {\"HTML\", \"XMLObject\"}];
XMLCases[lists, XMLPattern[\"ul\"][x : Child[XMLPattern[\"li\"]]] :> x]"], "Input"],

Cell["Child::name: x:Child[XMLPattern[\"li\"]] names a Child constraint, which has nothing to bind: between an element and its child there is no element. Name the child instead, as in Child[n : p].", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["Name the child instead:", "ExampleText"],

Cell[BoxData["XMLCases[lists, XMLPattern[\"ul\"][Child[x : XMLPattern[\"li\"]]] :> x]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Home\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Child takes one pattern:", "ExampleText"], Cell[BoxData["page = ImportString[\"<dl><dt>Term</dt><dd>Definition</dd></dl>\", {\"HTML\", \"XMLObject\"}];
XMLCases[page, XMLPattern[\"dl\"][Child[XMLPattern[\"dt\"], XMLPattern[\"dd\"]]]]"], "Input"],

Cell["Child::args: Child[XMLPattern[\"dt\"], XMLPattern[\"dd\"]] is not a constraint: Child takes one pattern. For children that match several patterns, give several constraints, as in XMLPattern[tag][Child[a], Child[b]], or, for children in an order, a list, as in XMLPattern[tag][{___, a, ___, b, ___}].", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["Give two constraints for children in any order:", "ExampleText"],

Cell[BoxData["XMLCases[page, XMLPattern[\"dl\"][Child[XMLPattern[\"dd\"]], Child[XMLPattern[\"dt\"]]]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"dl\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"dt\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Term\"", "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"dd\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Definition\"", "}"}]}], "]"}]}], "}"}]}], "]"}], "}"}]], "Output"],

Cell["Give a list for children in an order, here next to each other:", "ExampleText"],

Cell[BoxData["XMLCases[page, XMLPattern[\"dl\"][{___, XMLPattern[\"dt\"], XMLPattern[\"dd\"], ___}]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"dl\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"dt\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Term\"", "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"dd\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Definition\"", "}"}]}], "]"}]}], "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Child is a constraint, so the version 3 form as a query issues a message:", "ExampleText"], Cell[BoxData["lists = ImportString[\"<ul><li>Home</li><li>Docs</li></ul>\", {\"HTML\", \"XMLObject\"}];
XMLCases[lists, Child[XMLPattern[\"ul\"], XMLPattern[\"li\"]]]"], "Input"],

Cell["Child::place: Child[XMLPattern[\"ul\"], XMLPattern[\"li\"]] is not a pattern. Child is a constraint, which can only be an argument of the bracket after XMLPattern[tag, attrs] or of XMLDocument: XMLPattern[\"ul\"][Child[x : XMLPattern[\"li\"]]] :> x gives the li children of each ul. In version 3, Child[a, b] gave the children that match b of the elements that match a; in version 4 that is the rule above. Child takes one pattern: for children that match several patterns, give several constraints, Child[a], Child[b], or a list, {___, a, ___, b, ___}.", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["Nest the patterns as the document is, and name what to give:", "ExampleText"],

