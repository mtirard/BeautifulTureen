Cell[CellGroupData[{
Cell["Child", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]is a constraint on an element in an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", met when some element child of it matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " is a constraint: an argument of the second bracket of ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", or of ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], ". ", Cell[BoxData[RowBox[{RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "\"ul\"", "]"}], "[", RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", "x : XMLPattern[\"li\"]", "]"}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]], "InlineFormula"], " gives each li child of a ul, as the CSS selector ", Cell[BoxData["\"ul > li\""], "InlineFormula"], " does."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " is the list constraint ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", StyleBox["p", "TI"], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], ", and gives the same results in the same order. Text among the children is left out."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern, a CSS selector string that describes one element, or alternatives of these. Each can be named, have a condition or have a test, and can have constraints of its own."}], "Notes"],

Cell[TextData[{"Under ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], ", the children are the top elements of the input."}], "Notes"],

Cell[TextData[{"Several ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " constraints on one element are independent, and one child may meet several of them. For children in an order, or next to each other, give a list constraint, such as ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", StyleBox["a", "TI"], ",", StyleBox["___", "TR"], ",", StyleBox["b", "TI"], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], " or ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", StyleBox["a", "TI"], ",", StyleBox["b", "TI"], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A name or a test goes inside the constraint, as in ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", "n$ : p$", "]"}]], "InlineFormula"], " or ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", "p$?f$", "]"}]], "InlineFormula"], ". On the constraint itself, as in ", Cell[BoxData["n$ : Child[p$]"], "InlineFormula"], " or ", Cell[BoxData["Child[p$]?f$"], "InlineFormula"], ", it gives a message, as there is nothing between an element and its child to bind or test."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " takes one pattern. ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " with no pattern or several gives ", Cell[BoxData["Child::args"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " can only be an argument of the second bracket of ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", or of ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], ". Elsewhere, such as the whole pattern or an entry of a list pattern, it gives a message."}], "Notes"],

Cell[TextData[{"The version 3 form ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox["a", "TI"], ",", StyleBox["b", "TI"]}], "]"}]], "InlineFormula"], ", the children that match ", Cell[BoxData[StyleBox["b", "TI"]], "InlineFormula"], " of the elements that match ", Cell[BoxData[StyleBox["a", "TI"]], "InlineFormula"], ", is ", Cell[BoxData[RowBox[{RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["t", "TI"], "]"}], "[", RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", "x : b$", "]"}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]], "InlineFormula"], " in version 4, where ", Cell[BoxData[StyleBox["t", "TI"]], "InlineFormula"], " is the tag of ", Cell[BoxData[StyleBox["a", "TI"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

