Cell[BoxData["XMLFirstCase[tree,Child[XMLPattern[\"article\"],XMLPattern[\"p\"]]]"], "Input"],

Cell[BoxData[RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"First para.\"", "}"}]}], "]"}]], "Output"],

Cell["Remove matching direct children with XMLDeleteCases:", "ExampleText"],

Cell[BoxData["XMLCases[XMLDeleteCases[tree,Child[XMLPattern[\"article\"],XMLPattern[\"p\"]]],XMLPattern[\"p\"]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Nested para.\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Use a name bound in the parent stage in a rule body:", "ExampleText"], Cell[BoxData["lists=ImportString[\"<ul id=\\\"soups\\\"><li>Miso</li><li>Pho</li></ul><ul id=\\\"sides\\\"><li>Rice</li></ul>\",{\"HTML\",\"XMLObject\"}];
XMLCases[lists,Child[XMLPattern[\"ul\",\"id\"->list_],item:XMLPattern[\"li\"]]:>list->HTMLTextContent[item]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"\"soups\"", "\[Rule]", "\"Miso\""}], ",", RowBox[{"\"soups\"", "\[Rule]", "\"Pho\""}], ",", RowBox[{"\"sides\"", "\[Rule]", "\"Rice\""}]}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Use a combinator as a stage to chain three stages, as in the CSS selector article section > p:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<article><p>Top.</p><section><p>Nested.</p><div><p>Deeper.</p></div></section></article>\",{\"HTML\",\"XMLObject\"}];
XMLCases[tree,Descendant[XMLPattern[\"article\"],Child[XMLPattern[\"section\"],XMLPattern[\"p\"]]]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Nested.\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Put a condition on the whole combinator to compare values bound in both stages:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<div lang=\\\"en\\\"><p lang=\\\"en\\\">Hello</p><p lang=\\\"fr\\\">Bonjour</p></div>\",{\"HTML\",\"XMLObject\"}];
XMLCases[tree,Child[XMLPattern[\"div\",\"lang\"->outer_],XMLPattern[\"p\",\"lang\"->inner_]]/;inner=!=outer]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"lang\"", "\[Rule]", "\"fr\""}], "}"}], ",", RowBox[{"{", "\"Bonjour\"", "}"}]}], "]"}], "}"}]], "Output"],

Cell["Use the same name in both stages to require equal values:", "ExampleText"],

Cell[BoxData["XMLCases[tree,Child[XMLPattern[\"div\",\"lang\"->lang_],XMLPattern[\"p\",\"lang\"->lang_]]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"lang\"", "\[Rule]", "\"en\""}], "}"}], ",", RowBox[{"{", "\"Hello\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["The root of a bare XMLElement may match the parent stage:", "ExampleText"], Cell[BoxData["body=XMLElement[\"body\",{},{XMLElement[\"div\",{},{\"one\"}],XMLElement[\"p\",{},{XMLElement[\"div\",{},{\"two\"}]}]}];
XMLCases[body,Child[XMLPattern[\"body\"],XMLPattern[\"div\"]]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"div\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"one\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell[TextData[{"Select the first ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " of each list, as li:first-child does:"}], "ExampleText"], Cell[BoxData["lists=ImportString[\"<ul><li>Miso</li><li>Pho</li></ul><ol><li>Rice</li><li>Bread</li></ol>\",{\"HTML\",\"XMLObject\"}];
XMLCases[lists,Child[XMLPattern[_],{item:XMLPattern[\"li\"],___}]:>HTMLTextContent[item]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"Miso\"", ",", "\"Rice\""}], "}"}]], "Output"],

Cell[TextData[{"Select the last ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], ", as li:last-child does:"}], "ExampleText"],

Cell[BoxData["XMLCases[lists,Child[XMLPattern[_],{___,item:XMLPattern[\"li\"]}]:>HTMLTextContent[item]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"Pho\"", ",", "\"Bread\""}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Select the odd rows, as tr:nth-child(2n+1) does:", "ExampleText"], Cell[BoxData["table=ImportString[\"<table><tr><td>1</td></tr><tr><td>2</td></tr><tr><td>3</td></tr><tr><td>4</td></tr><tr><td>5</td></tr></table>\",{\"HTML\",\"XMLObject\"}];
XMLCases[table,Child[XMLPattern[_],{PatternSequence[_,_]...,row:XMLPattern[\"tr\"],___}]:>HTMLTextContent[row]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"1\"", ",", "\"3\"", ",", "\"5\""}], "}"}]], "Output"],

Cell["Select the last three rows, as tr:nth-last-child(-n+3) does:", "ExampleText"],

Cell[BoxData["XMLCases[table,Child[XMLPattern[_],{___,row:XMLPattern[\"tr\"],Repeated[_,{0,2}]}]:>HTMLTextContent[row]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"3\"", ",", "\"4\"", ",", "\"5\""}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Select the second paragraph among its siblings, as p:nth-of-type(2) does:", "ExampleText"], Cell[BoxData["doc=ImportString[\"<div><h2>Title</h2><p>first</p><img src=\\\"a.png\\\"><p>second</p><p>third</p></div>\",{\"HTML\",\"XMLObject\"}];
XMLCases[doc,Child[XMLPattern[_],{Except[XMLPattern[\"p\"]]...,XMLPattern[\"p\"],Except[XMLPattern[\"p\"]]...,para:XMLPattern[\"p\"],___}]:>HTMLTextContent[para]]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"second\"", "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Continue the chain after a list, as in li:first-child a:", "ExampleText"], Cell[BoxData["menu=ImportString[\"<ul><li><a href=\\\"/soup\\\">Soup</a> <a href=\\\"/stew\\\">Stew</a></li><li><a href=\\\"/salad\\\">Salad</a></li></ul>\",{\"HTML\",\"XMLObject\"}];
XMLCases[menu,Descendant[Child[XMLPattern[_],{XMLPattern[\"li\"],___}],XMLPattern[\"a\",\"href\"->target_]]:>target]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/soup\"", ",", "\"/stew\""}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Names on the other entries reach a rule body. Pair each paragraph with the heading right before it:", "ExampleText"], Cell[BoxData["doc=ImportString[\"<section><h2>A</h2><p>a1</p><p>a2</p><h2>B</h2><p>b1</p></section>\",{\"HTML\",\"XMLObject\"}];
