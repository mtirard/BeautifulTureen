Cell[CellGroupData[{
Cell["Child", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{StyleBox["parentPat", "TI"], ",", " ", StyleBox["childPat", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents any element that matches ", Cell[BoxData[StyleBox["childPat", "TI"]], "InlineFormula"], " and is a direct child of an element that matches ", Cell[BoxData[StyleBox["parentPat", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{SubscriptBox[StyleBox["pat", "TI"], StyleBox["1", "TR"]], ",", " ", SubscriptBox[StyleBox["pat", "TI"], StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", SubscriptBox[StyleBox["pat", "TI"], StyleBox["n", "TI"]]}], "]"}]], "InlineFormula"], " \[LineSeparator]is the chain ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{SubscriptBox[StyleBox["pat", "TI"], StyleBox["1", "TR"]], ",", " ", RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{SubscriptBox[StyleBox["pat", "TI"], StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", SubscriptBox[StyleBox["pat", "TI"], StyleBox["n", "TI"]]}], "]"}]}], "]"}]], "InlineFormula"], " of ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " stages."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], " is a combinator for ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ", like the CSS child combinator parent > child. Each argument is a stage: an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], ", another combinator, a CSS selector string, or alternatives of these, with or without a condition (", Cell[BoxData["/;"], "InlineFormula"], "). A stage that is alternatives holding a combinator is each of them in turn."}], "Notes"],

Cell[TextData[{"Stages chain left to right, as in a CSS selector. ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{StyleBox["b", "TR"], ",", " ", StyleBox["c", "TR"]}], "]"}]}], "]"}]], "InlineFormula"], " and ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"]}], "]"}], ",", " ", StyleBox["c", "TR"]}], "]"}]], "InlineFormula"], " both stand for the selector a b > c and select the same elements."}], "Notes"],

Cell[TextData[{"A combinator has at least two stages. With more, each stage is related to the next by the same combinator: ", Cell[BoxData["Child[a, b, c]"], "InlineFormula"], " is ", Cell[BoxData["Child[a, Child[b, c]]"], "InlineFormula"], ", the selector a > b > c."}], "Notes"],

Cell["A combinator gives the elements that match its last stage, each once, in document order.", "Notes"],

Cell[TextData[{"A condition on a stage can use only the names bound in that stage. A condition on the whole combinator, as in ", Cell[BoxData["Descendant[d : XMLPattern[\"div\"], p : XMLPattern[\"p\"]] /; test"], "InlineFormula"], ", can use the names bound in all its stages."}], "Notes"],

Cell["A name used in two stages must be bound to the same value in both.", "Notes"],

Cell[TextData[{"An ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " or alternatives of them can be named, as in ", Cell[BoxData["p : XMLPattern[\"p\"]"], "InlineFormula"], ". A combinator cannot be named, and alternatives cannot contain a combinator."}], "Notes"],

Cell[TextData[{"A name bound in ", Cell[BoxData[StyleBox["parentPat", "TI"]], "InlineFormula"], " gives the parent of the selected element."}], "Notes"],

Cell[TextData[{"When the tree searched is a bare ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", its root is never returned, but it may match ", Cell[BoxData[StyleBox["parentPat", "TI"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

