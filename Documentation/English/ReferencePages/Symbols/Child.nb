Cell[BoxData["$Failed"], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["After an element pattern, a list does not select the root element of a document, which is no element's child:", "ExampleText"], Cell[BoxData["doc=ImportString[\"<html><body><p>a</p></body></html>\",{\"HTML\",\"XMLObject\"}];
