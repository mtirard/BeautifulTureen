Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Identical siblings are told apart by their place among the children:", "ExampleText"], Cell[BoxData["rows=ImportString[\"<table><tr><td>x</td></tr><tr><td>x</td></tr><tr><td>x</td></tr></table>\",{\"HTML\",\"XMLObject\"}];
Length/@{XMLCases[rows,Child[XMLPattern[_],{___,XMLPattern[\"tr\"]}]],XMLCases[XMLDeleteCases[rows,Child[XMLPattern[_],{___,XMLPattern[\"tr\"]}]],XMLPattern[\"tr\"]]}"], "Input"],

