Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]is a constraint on an element in an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", met when some element child of it matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " is a ", StyleBox["constraint", FontWeight->"Bold"], ": a condition on what is below an element, given as an argument of the second bracket of ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or of ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], ". Elsewhere, such as the whole pattern or an entry of a list pattern, it gives a message."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " is the list pattern ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", StyleBox["p", "TI"], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], ", and gives the same results in the same order. Text among the children is left out."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern, a CSS selector for one element, or alternatives of these. Each can be named, have a condition or have a test. An ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or CSS selector in ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], " can have constraints of its own."}], "Notes"],

Cell[TextData[{"Under ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], ", the children are the top-level elements of the tree."}], "Notes"],

Cell[TextData[{"Several ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " constraints on one element are independent, and one child may meet several of them. For children in an order, or next to each other, give a list pattern, such as ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", StyleBox["a", "TI"], ",", StyleBox["___", "TR"], ",", StyleBox["b", "TI"], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], " or ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", StyleBox["a", "TI"], ",", StyleBox["b", "TI"], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"Unlike ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " takes no name or test on itself. Give them to the child, as in ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", "x : XMLPattern[\"li\"]", "]"}]], "InlineFormula"], "."}], "Notes"]
