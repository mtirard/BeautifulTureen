Cell[BoxData["doc=ImportString[\"<p>One</p>\",{\"HTML\",\"XMLObject\"}];
XMLCases[doc,Child[XMLDocument[]|XMLPattern[_],{XMLPattern[\"html\"],___}]]//Map[First]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"html\"", "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A list sees element children only. A named sequence entry gives the elements before the selected one, without the text between them:", "ExampleText"], Cell[BoxData["para=ImportString[\"<p>Hello <i>dear</i> <b>world</b></p>\",{\"HTML\",\"XMLObject\"}];
XMLCases[para,Child[XMLPattern[\"p\"],{before___,XMLPattern[\"b\"]}]:>{before}]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"i\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"dear\"", "}"}]}], "]"}], "}"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A list with two unbounded gaps around its entries is tried in every way it can match, so its time grows with the square of the number of children:", "ExampleText"], Cell[BoxData["rows[n_]:=XMLElement[\"table\",{},Table[XMLElement[\"tr\",{\"class\"->If[OddQ[i],\"a\",\"b\"]},{}],{i,n}]];
Table[First@AbsoluteTiming[XMLCases[{rows[n]},Child[XMLPattern[_],{___,XMLPattern[\"tr\",\"class\"->\"a\"],___,XMLPattern[\"tr\",\"class\"->\"b\"],___}]]],{n,{200,400}}]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"0.027407`", ",", "0.201442`"}], "}"}]], "Output"],

Cell[TextData[{Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"]], "InlineFormula"], " gives the same elements without that cost:"}], "ExampleText"],

Cell[BoxData["Table[First@AbsoluteTiming[XMLCases[{rows[n]},Sibling[XMLPattern[\"tr\",\"class\"->\"a\"],XMLPattern[\"tr\",\"class\"->\"b\"]]]],{n,{200,400}}]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"0.001108`", ",", "0.001479`"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A combinator before the selecting entry is a test that searches below each candidate child, as :has() does:", "ExampleText"], Cell[BoxData["doc=ImportString[\"<div><h2><span>new</span>A</h2><p>a1</p><h2>B</h2><p>b1</p></div>\",{\"HTML\",\"XMLObject\"}];
XMLCases[doc,Child[XMLPattern[_],{___,Descendant[XMLPattern[\"h2\"],XMLPattern[\"span\"]],para:XMLPattern[\"p\"],___}]:>HTMLTextContent[para]]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"a1\"", "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A list is not a pattern on its own, and is not read as alternatives:", "ExampleText"], Cell[BoxData["doc=ImportString[\"<div><p>a</p><p>b</p></div>\",{\"HTML\",\"XMLObject\"}];
XMLCases[doc,{XMLPattern[\"p\"],___}]"], "Input"],

Cell["XMLCases::liststage: {XMLPattern[\"p\"], ___} is a list of patterns for an element's children. \"It can only follow Child or Descendant, as in Child[XMLPattern[_], {XMLPattern[\\\"li\\\"], ___}], and is not a pattern on its own. For alternatives, use p1 | p2.\"", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

