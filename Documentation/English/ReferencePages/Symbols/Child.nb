Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["XMLMatchQ does not accept Child, since a lone element has no parent:", "ExampleText"], Cell[BoxData["XMLMatchQ[XMLElement[\"p\",{},{\"x\"}],Child[XMLPattern[\"div\"],XMLPattern[\"p\"]]]"], "Input"],

