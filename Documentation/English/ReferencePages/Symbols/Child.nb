Notebook[{

Cell[CellGroupData[{
Cell["Child", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox["parentPat", "TI"], ",", " ", StyleBox["childPat", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents any element that matches ", Cell[BoxData[StyleBox["childPat", "TI"]], "InlineFormula"], " and is a direct child of an element that matches ", Cell[BoxData[StyleBox["parentPat", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox["parentPat", "TI"], ",", " ", RowBox[{"{", RowBox[{StyleBox[SubscriptBox["e", StyleBox["1", "TR"]], "TI"], ",", " ", StyleBox[SubscriptBox["e", StyleBox["2", "TR"]], "TI"], ",", " ", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents the element in the place of the last XML pattern among the ", Cell[BoxData[StyleBox[SubscriptBox["e", StyleBox["i", "TI"]], "TI"]], "InlineFormula"], ", when the list matches the element children of an element that matches ", Cell[BoxData[StyleBox["parentPat", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox[SubscriptBox["pat", StyleBox["1", "TR"]], "TI"], ",", " ", StyleBox[SubscriptBox["pat", StyleBox["2", "TR"]], "TI"], ",", " ", StyleBox["\[Ellipsis]", "TR"], ",", " ", StyleBox[SubscriptBox["pat", StyleBox["n", "TI"]], "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]is the chain ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox[SubscriptBox["pat", StyleBox["1", "TR"]], "TI"], ",", " ", RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox[SubscriptBox["pat", StyleBox["2", "TR"]], "TI"], ",", " ", StyleBox["\[Ellipsis]", "TR"], ",", " ", StyleBox[SubscriptBox["pat", StyleBox["n", "TI"]], "TI"]}], "]"}]}], "]"}]], "InlineFormula"], " of ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " stages."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " is a combinator for ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFirstCase"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"]], "InlineFormula"], ", like the CSS child combinator parent > child. Each argument is a stage: an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", another combinator, a CSS selector string, or alternatives of these, with or without a condition (", Cell[BoxData["/;"], "InlineFormula"], "). A stage that is alternatives holding a combinator is each of them in turn."}], "Notes"],

Cell[TextData[{"Stages chain left to right, as in a CSS selector. ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox["b", "TR"], ",", " ", StyleBox["c", "TR"]}], "]"}]}], "]"}]], "InlineFormula"], " and ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"]}], "]"}], ",", " ", StyleBox["c", "TR"]}], "]"}]], "InlineFormula"], " both stand for the selector a b > c and select the same elements."}], "Notes"],

Cell[TextData[{"A combinator has at least two stages. With more, each stage is related to the next by the same combinator: ", Cell[BoxData["Child[a, b, c]"], "InlineFormula"], " is ", Cell[BoxData["Child[a, Child[b, c]]"], "InlineFormula"], ", the selector a > b > c."}], "Notes"],

Cell["A combinator gives the elements that match its last stage, each once, in document order.", "Notes"],

Cell[TextData[{"A condition on a stage can use only the names bound in that stage. A condition on the whole combinator, as in ", Cell[BoxData["Descendant[d : XMLPattern[\"div\"], p : XMLPattern[\"p\"]] /; test"], "InlineFormula"], ", can use the names bound in all its stages."}], "Notes"],

Cell["A name used in two stages must be bound to the same value in both.", "Notes"],

Cell[TextData[{"An ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or alternatives of them can be named, as in ", Cell[BoxData["p : XMLPattern[\"p\"]"], "InlineFormula"], ". A combinator cannot be named, and alternatives cannot contain a combinator."}], "Notes"],

Cell[TextData[{"A name bound in ", Cell[BoxData[StyleBox["parentPat", "TI"]], "InlineFormula"], " gives the parent of the selected element."}], "Notes"],

Cell[TextData[{"When the tree searched is a bare ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", its root is never returned, but it may match ", Cell[BoxData[StyleBox["parentPat", "TI"]], "InlineFormula"], ". ", Cell[BoxData[StyleBox["parentPat", "TI"]], "InlineFormula"], " can be ", Cell[BoxData[RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", "]"}]], "InlineFormula"], ", the parent of the top-level elements of the tree, alone or in alternatives."}], "Notes"],

Cell[TextData[{"After ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], ", a stage can be a list of patterns. The list is matched against the element children of each parent, leaving out text, as a WL list pattern is matched against a list: ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["_", "TR"], "]"}], ",", " ", RowBox[{"{", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["\"li\"", "TR"], "]"}], ",", " ", StyleBox["___", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " matches each ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " that is the first element child of its parent, as the CSS selector li:first-child does."}], "Notes"],

Cell[TextData[{"The entry that selects is the last top-level entry that is an XML pattern: an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", a combinator, a CSS selector string, or alternatives of these, with or without a name, a condition or a test. Every other entry describes the children around it, and can be ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["___", "TR"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Repeated", BaseStyle -> "Link", ButtonData -> "paclet:ref/Repeated"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["PatternSequence", BaseStyle -> "Link", ButtonData -> "paclet:ref/PatternSequence"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Optional", BaseStyle -> "Link", ButtonData -> "paclet:ref/Optional"]], "InlineFormula"], ", a condition or a test over entries. A list with no XML-pattern entry, such as ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", StyleBox["_", "TR"]}], "}"}]], "InlineFormula"], ", is refused, so the last element child of any tag is ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["_", "TR"], "]"}]}], "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A combinator entry stands in the list for its first stage. When it is the entry that selects, the chain continues to its last stage: ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["b", "TR"], ",", " ", StyleBox["c", "TR"]}], "]"}], ",", " ", StyleBox["___", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " selects the same elements as ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["b", "TR"], ",", " ", StyleBox["c", "TR"]}], "]"}]}], "]"}]], "InlineFormula"], ". Before it, the rest of its chain is a test that starts at that child: ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["_", "TR"], "]"}], ",", " ", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["b", "TR"], ",", " ", StyleBox["c", "TR"]}], "]"}], ",", " ", StyleBox["x", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " is the CSS selector b:has(c) + x."}], "Notes"],

Cell[TextData[{"Names in a list are bound as in a WL list pattern. When the list matches in several ways, the first way that WL tries binds them, and a condition or a rule body that rejects it moves on to the next. A named sequence entry, as ", Cell[BoxData["pre___"], "InlineFormula"], " in ", Cell[BoxData[RowBox[{"{", RowBox[{"pre___", ",", " ", StyleBox["c", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], ", binds the elements before ", Cell[BoxData[StyleBox["c", "TR"]], "InlineFormula"], ", and a name on the list, as in ", Cell[BoxData["s : {___, c}"], "InlineFormula"], ", binds the ", Cell[BoxData[ButtonBox["List", BaseStyle -> "Link", ButtonData -> "paclet:ref/List"]], "InlineFormula"], " of element children."}], "Notes"],

Cell[TextData[{"Alternatives of lists, as in ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["_", "TR"], "]"}], ",", " ", "{c, ___} | {___, c}"}], "]"}]], "InlineFormula"], ", are a stage, and each alternative has its own selecting entry. A list cannot be the whole pattern, the first stage of a combinator, or a stage after ", Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Adjacent"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Adjacent"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"]], "InlineFormula"], " are shorthands for lists: ", Cell[BoxData[RowBox[{ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Adjacent"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"]}], "]"}]], "InlineFormula"], " gives the same as ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{"XMLDocument[] | XMLPattern[_]", ",", " ", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], ", and ", Cell[BoxData[RowBox[{ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"]}], "]"}]], "InlineFormula"], " the same as ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{"XMLDocument[] | XMLPattern[_]", ",", " ", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", StyleBox["a", "TR"], ",", " ", StyleBox["___", "TR"], ",", " ", StyleBox["b", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

