Notebook[{

Cell[CellGroupData[{
Cell["HTMLInnerText", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]gives the readable text of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", with whitespace collapsed and each block-level element on its own line.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Roles\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]uses ", Cell[BoxData[StyleBox["rules", "TI"]], "InlineFormula"], " to set the role of elements, such as \"Block\" or \"Skip\"."}], "Usage"],

Cell[TextData[{"Each element has a role that depends only on its tag, as given by the built-in user-agent stylesheet, a copy of the default styles of the HTML standard. CSS is not read, including the ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], " attribute."}], "Notes"],

Cell[TextData[{"The role sets how the text of an element is placed:

| role | text | built-in tags |
| --- | --- | --- |
| \"Block\" | on its own line | ", Cell[BoxData[StyleBox["div", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["p", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["h1", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], ", etc. |
| \"Inline\" | in the surrounding line | all other tags, such as ", Cell[BoxData[StyleBox["span", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["b", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " |
| \"Preformatted\" | on its own lines, with whitespace kept as written | ", Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["xmp", "TR"]], "InlineFormula"], ", etc. |
| \"LineBreak\" | a newline | ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " |
| \"Skip\" | dropped with its content | ", Cell[BoxData[StyleBox["script", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["head", "TR"]], "InlineFormula"], ", etc. |"}], "Notes"],

Cell[TextData[{"Outside preformatted elements, each run of spaces, tabs and newlines becomes one space. A no-break space, such as one written ", Cell[BoxData["&nbsp;"], "InlineFormula"], ", is kept. The result is trimmed at both ends."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " may be an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " document, a string, or a list of elements and strings."}], "Notes"],

Cell[TextData[{"The following options can be given:

| option | default | description |
| --- | --- | --- |
| \"Roles\" | ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " | rules that set the role of elements |
| \"BlockSeparator\" | ", Cell[BoxData[StyleBox["\"\\n\"", "TR"]], "InlineFormula"], " | string inserted between blocks |
| \"AttributeReadings\" | ", Cell[BoxData[StyleBox["<||>", "TR"]], "InlineFormula"], " | readings to add to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " for this call |"}], "Notes"],

Cell[TextData[{"Each rule of \"Roles\" has the form ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " or ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[RuleDelayed]", StyleBox["val", "TI"]}]], "InlineFormula"], ", and the rules may also be given as an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], ". ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " is one of two kinds:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["key", "TableText"], FontSlant->"Italic"], StyleBox[Cell["selects", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"an element test: an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern, a CSS selector string that describes one element, or alternatives of these, each of which can be named, have a condition or have a test"}], "TableText"], Cell[TextData[{"each element that matches it as the top of the pattern; its names can be used in ", Cell[BoxData[StyleBox["val", "TI"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"a query: a rule such as ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{"\"nav\"", ",", StyleBox["_", "TR"], ",", RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", "x : XMLPattern[\"a\"]", "]"}]}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]], "InlineFormula"], ", or a CSS selector string that matches an element by what is above it, such as ", Cell[BoxData["\"nav a\""], "InlineFormula"]}], "TableText"], Cell[TextData[{"the elements that the names on its right-hand side match, found once in the whole of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], "; its names cannot be used in ", Cell[BoxData[StyleBox["val", "TI"]], "InlineFormula"]}], "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"The first rule that selects an element sets its role, whichever kind its key is. An element that no rule selects gets its role from the built-in user-agent stylesheet. A query must select elements only, and an ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " pattern can only be used in a query."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " may use list keys, which stand for an attribute value split into a list of strings. The list key \"classList\" gives the classes of the element, and \"AttributeReadings\" adds list keys for other attributes, such as \"relList\" for ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A name in an element test, such as ", Cell[BoxData[StyleBox["e", "TI"]], "InlineFormula"], " in ", Cell[BoxData["e$ : XMLPattern[\"li\"] /; test$"], "InlineFormula"], ", is bound to the element as it is in ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", without list keys."}], "Notes"],

Cell[TextData[{"Each ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " element gives one newline, whatever the setting of \"BlockSeparator\", so two in a row leave a blank line."}], "Notes"],

Cell[TextData[{"If ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", the root element of a document, or an element at the top level of a list has the role \"Skip\", its whole text is given, as ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLTextContent"]], "InlineFormula"], " gives it but trimmed at both ends. A web browser does the same for an element that is not displayed. This applies whether the role comes from the built-in user-agent stylesheet or from a \"Roles\" rule. So the text of a ", Cell[BoxData[StyleBox["title", "TR"]], "InlineFormula"], " element is its title, although a ", Cell[BoxData[StyleBox["title", "TR"]], "InlineFormula"], " inside ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " is dropped."}], "Notes"]
}, Open  ]],

