Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Collapse internal whitespace and flow inline children:", "ExampleText"], Cell[BoxData["HTMLInnerText[ImportString[\"<p>Hi   <em>there</em>,\\n  world</p>\", {\"HTML\", \"XMLObject\"}]]"], "Input"],

Cell[BoxData["\"Hi there, world\""], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Block-level tags are placed on their own lines:", "ExampleText"], Cell[BoxData["HTMLInnerText[XMLElement[\"div\", {}, {
  XMLElement[\"h2\", {}, {\"Title\"}],
  XMLElement[\"p\", {}, {\"First para.\"}],
  XMLElement[\"p\", {}, {\"Second \", XMLElement[\"b\", {}, {\"bold\"}], \" para.\"}]}]]"], "Input"],

Cell[BoxData["\"Title\\nFirst para.\\nSecond bold para.\""], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["BlockSeparator widens the gap between blocks:", "ExampleText"], Cell[BoxData["HTMLInnerText[XMLElement[\"div\", {}, {
  XMLElement[\"p\", {}, {\"First.\"}], XMLElement[\"p\", {}, {\"Second.\"}]}],
  \"BlockSeparator\" -> \"\\n\\n\"]"], "Input"],

Cell[BoxData["\"First.\\n\\nSecond.\""], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Preformatted content is preserved verbatim:", "ExampleText"], Cell[BoxData["HTMLInnerText[XMLElement[\"div\", {}, {\"code:\", XMLElement[\"pre\", {}, {\"  for x:\\n    print x\"}], \"done\"}]]"], "Input"],

Cell[BoxData["\"code:\\n  for x:\\n    print x\\ndone\""], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Non-rendered tags such as script are dropped:", "ExampleText"], Cell[BoxData["HTMLInnerText[ImportString[\"<section><script>var x=1;</script><p>Visible.</p></section>\", {\"HTML\", \"XMLObject\"}]]"], "Input"],

Cell[BoxData["\"Visible.\""], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Override roles to drop screenreader-only spans by class:", "ExampleText"], Cell[BoxData["HTMLInnerText[
  XMLElement[\"div\", {}, {\"keep \", XMLElement[\"span\", {\"class\" -> \"sr-only\"}, {\"screenreader\"}], \"this\"}],
  \"Roles\" -> {XMLPattern[\"span\", CSSClass[\"sr-only\"]] -> \"Skip\"}]"], "Input"],

Cell[BoxData["\"keep this\""], "Output"]}, Open]]
