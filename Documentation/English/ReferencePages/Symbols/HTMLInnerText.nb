Notebook[{

Cell[CellGroupData[{
Cell["HTMLInnerText", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]gives the readable text of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ": internal whitespace collapsed, block-level tags on their own lines, ", Cell[BoxData["br"], "InlineFormula"], " as newlines, ", Cell[BoxData["pre"], "InlineFormula"], " preserved verbatim, non-rendered tags dropped, and the result trimmed.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Roles\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]classifies elements using ", Cell[BoxData[StyleBox["rules", "TI"]], "InlineFormula"], " before falling back to the frozen user-agent table."}], "Usage"],

Cell[TextData[{"Each element is classified by tag alone into a display role, using a frozen snapshot of the WHATWG HTML default user-agent stylesheet. CSS \\[LongDash] classes, ", Cell[BoxData["style"], "InlineFormula"], " blocks, external sheets, and even inline ", Cell[BoxData["style"], "InlineFormula"], " \\[LongDash] is never consulted, so ", Cell[BoxData[TemplateBox[{Cell[TextData["HTMLInnerText"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " reproduces HTML under default styles, not a particular page as rendered."}], "Notes"],

Cell[TextData[{"Whitespace runs collapse to a single space; block-level tags such as ", Cell[BoxData["div"], "InlineFormula"], ", ", Cell[BoxData["p"], "InlineFormula"], ", headings and list items are placed on their own lines; ", Cell[BoxData["br"], "InlineFormula"], " becomes a newline; ", Cell[BoxData["pre"], "InlineFormula"], " and other preformatted tags keep their content verbatim; non-rendered tags such as ", Cell[BoxData["script"], "InlineFormula"], " and ", Cell[BoxData["style"], "InlineFormula"], " are dropped with their subtrees; and both ends are trimmed."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " may be an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], ", an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLObject"]], "paclet:ref/XMLObject"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " document (its root element is used), a list of these, or a bare string."}], "Notes"],

Cell[TextData[{"The option \"Roles\" -> ", Cell[BoxData[StyleBox["rules", "TI"]], "InlineFormula"], " overrides the classification. Each rule is ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " -> ", Cell[BoxData[StyleBox["role", "TI"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " :> ", Cell[BoxData[StyleBox["role", "TI"]], "InlineFormula"], ", where ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLPattern"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " (a bare string sugars to ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLPattern"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["string", "TI"]], "InlineFormula"], "]); an ", Cell[BoxData[TemplateBox[{Cell[TextData["Association"]], "paclet:ref/Association"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " sugars to an ordered rule list. Rules are tried in order, first match wins; an element matching no rule defers to the frozen table, and an unknown tag defaults to inline."}], "Notes"],

Cell["The five role tokens are \"Block\", \"Inline\", \"Preformatted\", \"LineBreak\", and \"Skip\". A rule producing anything else issues a message and is ignored, deferring to the frozen table.", "Notes"],

Cell[TextData[{"The option \"BlockSeparator\" -> ", Cell[BoxData[StyleBox["sep", "TI"]], "InlineFormula"], " (default \"\\n\") sets the string inserted between block boundaries; \"\\n\\n\" gives paragraph-style gaps. A ", Cell[BoxData["br"], "InlineFormula"], " is always a single newline, independent of this option."}], "Notes"],

Cell[TextData[{Cell[BoxData[TemplateBox[{Cell[TextData["HTMLInnerText"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " approximates the DOM innerText projection; for the raw, lossless concatenation of every descendant string use ", Cell[BoxData[TemplateBox[{Cell[TextData["HTMLTextContent"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

