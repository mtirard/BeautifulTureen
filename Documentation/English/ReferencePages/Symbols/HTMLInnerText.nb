Notebook[{

Cell[CellGroupData[{
Cell["HTMLInnerText", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]gives the readable text of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", with whitespace collapsed and each block-level element on its own line."}], "Usage"],

Cell["Each element has a role, which sets how its text is placed:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["role", "TableText"], FontSlant->"Italic"], StyleBox[Cell["text", "TableText"], FontSlant->"Italic"], StyleBox[Cell["built-in tags", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell["\"Block\"", "TableText"], Cell["on its own line", "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["div", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["p", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["h1", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], ", etc."}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"Inline\"", "TableText"], Cell["in the surrounding line", "TableText"], Cell[TextData[{"all other tags, such as ", Cell[BoxData[StyleBox["span", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["b", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"Preformatted\"", "TableText"], Cell["on its own lines, with whitespace kept as written", "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["xmp", "TR"]], "InlineFormula"], ", etc."}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"LineBreak\"", "TableText"], Cell["a newline", "TableText"], StyleBox["br", "TR"]},
{Cell["      ", "ModInfo"], Cell["\"Skip\"", "TableText"], Cell["dropped with its content", "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["script", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["head", "TR"]], "InlineFormula"], ", etc."}], "TableText"]}
}]], "3ColumnTableMod"],

Cell[TextData[{"Without a \"Roles\" rule, the role of an element depends only on its tag, as given by the built-in user-agent stylesheet, a copy of the default styles of the HTML standard. CSS is not read, including the ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], " attribute."}], "Notes"],

Cell[TextData[{"Outside preformatted elements, each run of spaces, tabs and newlines becomes one space. A no-break space, such as one written ", Cell[BoxData["&nbsp;"], "InlineFormula"], ", is kept. The result is trimmed at both ends."}], "Notes"],

Cell[TextData[{"Each ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " element gives one newline, whatever the setting of \"BlockSeparator\", so two in a row leave a blank line."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", a string, or a list of elements and strings."}], "Notes"],

Cell[TextData[{"If ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", the root element of a document, or a top-level element of a list has the role \"Skip\", as a ", Cell[BoxData[StyleBox["title", "TR"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["script", "TR"]], "InlineFormula"], " element does, its whole text is given as ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLTextContent"]], "InlineFormula"], " gives it, trimmed at both ends."}], "Notes"],

Cell["The following options can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell["\"Roles\"", "TableText"], RowBox[{"{", "}"}], Cell["rules that set the role of elements", "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"BlockSeparator\"", "TableText"], "\"\\n\"", Cell["string inserted between blocks", "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"AttributeReadings\"", "TableText"], StyleBox["<||>", "TR"], Cell[TextData[{"attributes to split into lists of tokens for this call, in addition to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"],

Cell[TextData[{"Each rule of \"Roles\" has the form ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " or ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[RuleDelayed]", StyleBox["val", "TI"]}]], "InlineFormula"], ", and the rules can also be given as an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " is an element test or a query. An ", StyleBox["element test", FontWeight->"Bold"], ", such as an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or the CSS selector ", Cell[BoxData["\"div.ad\""], "InlineFormula"], ", is tested on each element, and depends only on the element and what is below it."}], "Notes"],

Cell[TextData[{"A ", StyleBox["query", FontWeight->"Bold"], " is a rule such as ", Cell[BoxData[RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["x", "TI"]}]], "InlineFormula"], ", or a CSS selector that depends on what is above or beside its element, such as ", Cell[BoxData["\"nav a\""], "InlineFormula"], ". It applies to the elements that ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " gives for it in ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ". For more on both kinds, see ", ButtonBox["Scraping HTML with Patterns", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/tutorial/ScrapingHTMLWithPatterns"], "."}], "Notes"]
}, Open  ]],

