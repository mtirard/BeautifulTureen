Notebook[{

Cell[CellGroupData[{
Cell["HTMLInnerText", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]gives the readable text of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ": internal whitespace collapsed, block-level tags on their own lines, ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " as newlines, ", Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], " preserved verbatim, non-rendered tags dropped, and the result trimmed.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Roles\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]classifies elements using ", Cell[BoxData[StyleBox["rules", "TI"]], "InlineFormula"], ", each an XML pattern paired with a display role, before falling back to the frozen user-agent table."}], "Usage"],

Cell[TextData[{"Each element is classified by tag alone into a display role, using a frozen snapshot of the WHATWG HTML default user-agent stylesheet. CSS \[LongDash] classes, ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], " blocks, external sheets, and even inline ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], " \[LongDash] is never consulted, so ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " reproduces HTML under default styles, not a particular page as rendered."}], "Notes"],

Cell[TextData[{"Whitespace runs collapse to a single space; block-level tags such as ", Cell[BoxData[StyleBox["div", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["p", "TR"]], "InlineFormula"], ", headings and list items are placed on their own lines; ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " becomes a newline; ", Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], " and other preformatted tags keep their content verbatim; non-rendered tags such as ", Cell[BoxData[StyleBox["script", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], " are dropped with their subtrees; and both ends are trimmed."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " may be an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " document (its root element is used), a list of ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " objects, or a bare string."}], "Notes"],

Cell[TextData[{"The option \"Roles\" -> ", Cell[BoxData[StyleBox["rules", "TI"]], "InlineFormula"], " overrides the classification. Each rule is ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " -> ", Cell[BoxData[StyleBox["role", "TI"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " :> ", Cell[BoxData[StyleBox["role", "TI"]], "InlineFormula"], ", where ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is an element pattern: an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of them, or a conditioned pattern ", Cell[BoxData["pat$ /; test$"], "InlineFormula"], ". A bare string sugars to ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", StyleBox["string", "TI"], "]"}]], "InlineFormula"], ", and an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " sugars to an ordered rule list. Rules are tried in order, first match wins; an element matching no rule defers to the frozen table, and an unknown tag defaults to inline."}], "Notes"],

Cell["The five role tokens are \"Block\", \"Inline\", \"Preformatted\", \"LineBreak\", and \"Skip\". A rule producing anything else issues a message and is ignored, deferring to the frozen table.", "Notes"],

Cell[TextData[{"A rule pattern may use a list key such as \"classList\", which matches the token list of the element's ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute. Names bound in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", including a name on the whole element (", Cell[BoxData["e$ : XMLPattern[$$]"], "InlineFormula"], "), see the element as it is in ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A rule is tried against one element at a time, so a combinator (", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineFormula"], "), conditioned or not, cannot be a rule pattern; ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The option \"AttributeReadings\" -> ", Cell[BoxData[StyleBox["readings", "TI"]], "InlineFormula"], " (default ", Cell[BoxData[StyleBox["<||>", "TR"]], "InlineFormula"], ") adds readings to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " for the rules' patterns, so that they can use list keys other than \"classList\"."}], "Notes"],

Cell[TextData[{"The option \"BlockSeparator\" -> ", Cell[BoxData[StyleBox["sep", "TI"]], "InlineFormula"], " (default \"\\n\") sets the string inserted between block boundaries; \"\\n\\n\" gives paragraph-style gaps. A ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " is always a single newline, independent of this option."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " approximates the DOM innerText projection; for the raw, lossless concatenation of every descendant string use ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

