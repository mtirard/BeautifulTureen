Cell[BoxData["$Failed"], "Output"],

Cell[TextData[{"Remove those elements first with ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ", which accepts ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], ":"}], "ExampleText"],

Cell[BoxData["HTMLInnerText[XMLDeleteCases[XMLElement[\"div\",{},{XMLElement[\"nav\",{},{XMLElement[\"a\",{},{\"Home\"}]}],XMLElement[\"p\",{},{\"Body.\"}]}],Child[XMLPattern[\"nav\"],XMLPattern[\"a\"]]]]"], "Input"],

Cell[BoxData["\"Body.\""], "Output"]}, Open]]}, Open]],

