Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A rule on \"class\" matches the whole attribute string, so it misses a span with two classes; \"classList\" does not:", "ExampleText"], Cell[BoxData["fragment=XMLElement[\"div\",{},{\"keep \",XMLElement[\"span\",{\"class\"->\"sr-only visually-hidden\"},{\"screenreader\"}],\" this\"}];
