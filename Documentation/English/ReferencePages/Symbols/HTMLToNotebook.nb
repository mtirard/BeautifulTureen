Notebook[{

Cell[CellGroupData[{
Cell["HTMLToNotebook", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]converts ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " to a ", Cell[BoxData[ButtonBox["Notebook", BaseStyle -> "Link", ButtonData -> "paclet:ref/Notebook"]], "InlineFormula"], " expression, which can be displayed or exported to Markdown, PDF, etc. with ", Cell[BoxData[ButtonBox["Export", BaseStyle -> "Link", ButtonData -> "paclet:ref/Export"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Roles\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]uses ", Cell[BoxData[StyleBox["rules", "TI"]], "InlineFormula"], " to set the role of elements, such as \"Block\" or \"Skip\".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Constructs\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]uses ", Cell[BoxData[StyleBox["rules", "TI"]], "InlineFormula"], " to set what elements become, such as a cell style or a function that gives a ", Cell[BoxData[ButtonBox["Cell", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cell"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{"Block-level elements become cells, and inline elements become formatted text in the surrounding cell. By default:

| tag | result |
| --- | --- |
| ", Cell[BoxData[StyleBox["h1", "TR"]], "InlineFormula"], " to ", Cell[BoxData[StyleBox["h6", "TR"]], "InlineFormula"], " | \"Title\", \"Chapter\", \"Section\", \"Subsection\", \"Subsubsection\" and \"Subsubsubsection\" cells |
| ", Cell[BoxData[StyleBox["p", "TR"]], "InlineFormula"], " | a \"Text\" cell |
| ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " | an \"Item\", \"Subitem\" or \"Subsubitem\" cell, by depth, or \"ItemNumbered\", etc. inside ", Cell[BoxData[StyleBox["ol", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData[StyleBox["blockquote", "TR"]], "InlineFormula"], " | a framed quote |
| ", Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], " | a \"Program\" cell |
| ", Cell[BoxData[StyleBox["table", "TR"]], "InlineFormula"], " | a ", Cell[BoxData[ButtonBox["Dataset", BaseStyle -> "Link", ButtonData -> "paclet:ref/Dataset"]], "InlineFormula"], " if the first row has only ", Cell[BoxData[StyleBox["th", "TR"]], "InlineFormula"], " cells with distinct labels, otherwise a ", Cell[BoxData[ButtonBox["Grid", BaseStyle -> "Link", ButtonData -> "paclet:ref/Grid"]], "InlineFormula"], "; its ", Cell[BoxData[StyleBox["caption", "TR"]], "InlineFormula"], " is a \"Text\" cell before it |
| ", Cell[BoxData[StyleBox["hr", "TR"]], "InlineFormula"], " | a horizontal line |
| ", Cell[BoxData[StyleBox["b", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["strong", "TR"]], "InlineFormula"], " | bold |
| ", Cell[BoxData[StyleBox["i", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["em", "TR"]], "InlineFormula"], " | italic |
| ", Cell[BoxData[StyleBox["u", "TR"]], "InlineFormula"], " | underlined |
| ", Cell[BoxData[StyleBox["s", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["del", "TR"]], "InlineFormula"], " | struck through |
| ", Cell[BoxData[StyleBox["code", "TR"]], "InlineFormula"], " | inline code |
| ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " | a hyperlink |
| ", Cell[BoxData[StyleBox["img", "TR"]], "InlineFormula"], " | its alt text, linked to its ", Cell[BoxData[StyleBox["src", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData[StyleBox["span", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["mark", "TR"]], "InlineFormula"], ", etc. | plain text |"}], "Notes"],

Cell[TextData[{"Each element has a role that depends only on its tag, as given by the built-in user-agent stylesheet, a copy of the default styles of the HTML standard. CSS is not read, including the ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], " attribute."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " may be an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " document, a string, or a list of elements and strings. Text outside any block-level element goes in a \"Text\" cell."}], "Notes"],

Cell[TextData[{"The following options can be given:

| option | default | description |
| --- | --- | --- |
| \"Roles\" | ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " | rules that set the role of elements |
| \"Constructs\" | ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " | rules that set what elements become |
| \"AttributeReadings\" | ", Cell[BoxData[StyleBox["<||>", "TR"]], "InlineFormula"], " | readings to add to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " for the patterns in \"Roles\" and \"Constructs\" |"}], "Notes"],

Cell[TextData[{"The role sets what an element becomes:

| role | result | built-in tags |
| --- | --- | --- |
| \"Block\" | one or more cells | ", Cell[BoxData[StyleBox["div", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["p", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["h1", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], ", etc. |
| \"Inline\" | formatted text in the surrounding cell | all other tags, such as ", Cell[BoxData[StyleBox["span", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["b", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " |
| \"Preformatted\" | a \"Program\" cell, with whitespace kept as written | ", Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["textarea", "TR"]], "InlineFormula"], ", etc. |
| \"LineBreak\" | a newline in the surrounding cell | ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " |
| \"Skip\" | dropped with its content | ", Cell[BoxData[StyleBox["script", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["head", "TR"]], "InlineFormula"], ", etc. |"}], "Notes"],

Cell[TextData[{"Each rule of \"Roles\" or \"Constructs\" has the form ", Cell[BoxData[RowBox[{StyleBox["pattern", "TI"], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " or ", Cell[BoxData[RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["val", "TI"]}]], "InlineFormula"], ", and the rules may also be given as an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], ". ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " may be a tag string, an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], ", alternatives of them, or either with a condition ", Cell[BoxData["pat$ /; test$"], "InlineFormula"], "."}], "Notes"],

Cell["In each option, the first rule that matches an element applies. An element that no rule matches gets its role from the built-in user-agent stylesheet, and its result from the first table above.", "Notes"],

Cell[TextData[{"The value of a \"Constructs\" rule may have the following forms:

| value | result |
| --- | --- |
| \"Bold\", \"Italic\", \"Underline\", \"StrikeThrough\", \"Code\" | formatted text |
| \"Hyperlink\" | a link to the ", Cell[BoxData[StyleBox["href", "TR"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["src", "TR"]], "InlineFormula"], " attribute, or plain text if there is none |
| \"Plain\" | plain text |
| any other string, such as \"Section\" | a cell with that style |
| ", Cell[BoxData[StyleBox["f", "TI"]], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["f", "TI"], "[", StyleBox["elem", "TI"], "]"}]], "InlineFormula"], ", which should give a ", Cell[BoxData[ButtonBox["Cell", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cell"]], "InlineFormula"], " or boxes |"}], "Notes"],

Cell[TextData[{"The role decides whether an element becomes a cell or text in a cell. For a block-level element, give a cell style or a function that returns a ", Cell[BoxData[ButtonBox["Cell", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cell"]], "InlineFormula"], ". For an inline element, give a formatting string or a function that returns boxes."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " may use list keys, which stand for an attribute value split into a list of strings. The list key \"classList\" gives the classes of the element, and \"AttributeReadings\" adds list keys for other attributes, such as \"relList\" for ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A name in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is bound to the element as it is in ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", without list keys. A function ", Cell[BoxData[StyleBox["f", "TI"]], "InlineFormula"], " is applied to the same element."}], "Notes"]
}, Open  ]],

