Notebook[{

Cell[CellGroupData[{
Cell["HTMLToNotebook", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]converts the HTML/XML ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " into a ", Cell[BoxData[ButtonBox["Notebook", BaseStyle -> "Link", ButtonData -> "paclet:ref/Notebook"]], "InlineFormula"], " expression, from which Markdown, PDF, RTF, and display follow via ", Cell[BoxData[ButtonBox["Export", BaseStyle -> "Link", ButtonData -> "paclet:ref/Export"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Roles\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]overrides the block/inline classification before falling back to the frozen user-agent table.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Constructs\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]overrides the form each element takes \[LongDash] an inline token, a cell-style string, or a constructor function."}], "Usage"],

Cell[TextData[{"Block-level tags become cells and inline tags become boxes inside the surrounding cell. Classification is by tag alone, using a frozen snapshot of the WHATWG HTML default user-agent stylesheet; CSS is never consulted. ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], " makes projection choices (it is lossy and one-directional), unlike ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], ", which read near-canonical text off the tree."}], "Notes"],

Cell[TextData[{"Headings ", Cell[BoxData[StyleBox["h1", "TR"]], "InlineFormula"], " through ", Cell[BoxData[StyleBox["h6", "TR"]], "InlineFormula"], " map to the cell styles \"Title\", \"Chapter\", \"Section\", \"Subsection\", \"Subsubsection\", and \"Subsubsubsection\"; ", Cell[BoxData[StyleBox["p", "TR"]], "InlineFormula"], " to \"Text\"; and ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " to depth-aware \"Item\"/\"Subitem\"/\"Subsubitem\" styles (with a \"Numbered\" suffix inside ", Cell[BoxData[StyleBox["ol", "TR"]], "InlineFormula"], ")."}], "Notes"],

Cell[TextData[{"Inline tags map to boxes: ", Cell[BoxData[StyleBox["b", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["strong", "TR"]], "InlineFormula"], " to bold, ", Cell[BoxData[StyleBox["i", "TR"]], "InlineFormula"], "/", Cell[BoxData[StyleBox["em", "TR"]], "InlineFormula"], " to italic, ", Cell[BoxData[StyleBox["code", "TR"]], "InlineFormula"], " to inline code, ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " to a hyperlink, ", Cell[BoxData[StyleBox["s", "TR"]], "InlineFormula"], "/", Cell[BoxData[StyleBox["del", "TR"]], "InlineFormula"], " to strike-through, ", Cell[BoxData[StyleBox["u", "TR"]], "InlineFormula"], " to underline. Tags with no rendering distinction (", Cell[BoxData[StyleBox["span", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["mark", "TR"]], "InlineFormula"], ", \[Ellipsis]) splice their content in plain."}], "Notes"],

Cell[TextData[{"The leaf-collapsing tags ", Cell[BoxData[StyleBox["blockquote", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], ", and ", Cell[BoxData[StyleBox["table", "TR"]], "InlineFormula"], " collapse their whole subtree into one cell rather than recursing: a framed quote, a verbatim ", Cell[BoxData[StyleBox["\"Program\"", "TR"]], "InlineFormula"], " cell, and a ", Cell[BoxData[ButtonBox["Dataset", BaseStyle -> "Link", ButtonData -> "paclet:ref/Dataset"]], "InlineFormula"], " (unique header labels) or ", Cell[BoxData[ButtonBox["Grid", BaseStyle -> "Link", ButtonData -> "paclet:ref/Grid"]], "InlineFormula"], " (otherwise, lossless) respectively."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " may be an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " document, a list of ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " objects, or a bare string; a bare string or top-level inline content is wrapped in a \"Text\" cell."}], "Notes"],

Cell[TextData[{"Each \"Constructs\" rule is ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " -> ", Cell[BoxData[StyleBox["construct", "TI"]], "InlineFormula"], " (or ", Cell[BoxData[":>"], "InlineFormula"], "), where ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " (a bare string sugars to ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", StyleBox["string", "TI"], "]"}]], "InlineFormula"], "). Rules are tried in order, first match wins. The RHS is a cell-style string, an inline token (\"Bold\", \"Italic\", \"Underline\", \"StrikeThrough\", \"Code\", \"Hyperlink\", \"Plain\"), or a constructor function ", Cell[BoxData[StyleBox["element", "TI"]], "InlineFormula"], " :> ", Cell[BoxData["Cell/boxes"], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

