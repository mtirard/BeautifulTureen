Notebook[{

Cell[CellGroupData[{
Cell["HTMLToNotebook", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]converts the HTML/XML ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " into a ", Cell[BoxData[TemplateBox[{Cell[TextData["Notebook"]], "paclet:ref/Notebook"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " expression, from which Markdown, PDF, RTF, and display follow via ", Cell[BoxData[TemplateBox[{Cell[TextData["Export"]], "paclet:ref/Export"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Roles\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]overrides the block/inline classification before falling back to the frozen user-agent table.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", RowBox[{StyleBox["\"Constructs\"", "TR"], "\[Rule]", StyleBox["rules", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]overrides the form each element takes \[LongDash] an inline token, a cell-style string, or a constructor function."}], "Usage"],

Cell[TextData[{
 "Block-level tags become cells and inline tags become boxes inside the \
surrounding cell. Classification is by tag alone, using a frozen snapshot of \
the WHATWG HTML default user-agent stylesheet; CSS is never consulted. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HTMLToNotebook"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " makes projection choices (it is lossy and one-directional), unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HTMLTextContent"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["HTMLInnerText"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 ", which read near-canonical text off the tree."
}], "Notes"],

Cell[TextData[{
 "Headings ",
 Cell[BoxData[
 "h1"], "InlineFormula"],
 " through ",
 Cell[BoxData[
 "h6"], "InlineFormula"],
 " map to the cell styles \"Title\", \"Chapter\", \"Section\", \
\"Subsection\", \"Subsubsection\", and \"Subsubsubsection\"; ",
 Cell[BoxData[
 "p"], "InlineFormula"],
 " to \"Text\"; and ",
 Cell[BoxData[
 "li"], "InlineFormula"],
 " to depth-aware \"Item\"/\"Subitem\"/\"Subsubitem\" styles (with a \
\"Numbered\" suffix inside ",
 Cell[BoxData[
 "ol"], "InlineFormula"],
 ")."
}], "Notes"],

Cell[TextData[{
 "Inline tags map to boxes: ",
 Cell[BoxData[
 "b"], "InlineFormula"],
 " and ",
 Cell[BoxData[
 "strong"], "InlineFormula"],
 " to bold, ",
 Cell[BoxData[
 "i"], "InlineFormula"],
 "/",
 Cell[BoxData[
 "em"], "InlineFormula"],
 " to italic, ",
 Cell[BoxData[
 "code"], "InlineFormula"],
 " to inline code, ",
 Cell[BoxData[
 "a"], "InlineFormula"],
 " to a hyperlink, ",
 Cell[BoxData[
 "s"], "InlineFormula"],
 "/",
 Cell[BoxData[
 "del"], "InlineFormula"],
 " to strike-through, ",
 Cell[BoxData[
 "u"], "InlineFormula"],
 " to underline. Tags with no rendering distinction (",
 Cell[BoxData[
 "span"], "InlineFormula"],
 ", ",
 Cell[BoxData[
 "mark"], "InlineFormula"],
 ", \[Ellipsis]) splice their content in plain."
}], "Notes"],

Cell[TextData[{
 "The leaf-collapsing tags ",
 Cell[BoxData[
 "blockquote"], "InlineFormula"],
 ", ",
 Cell[BoxData[
 "pre"], "InlineFormula"],
 ", and ",
 Cell[BoxData[
 "table"], "InlineFormula"],
 " collapse their whole subtree into one cell rather than recursing: a framed \
quote, a verbatim ",
 Cell[BoxData["\"\<Program\>\""], "InlineFormula"],
 " cell, and a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Dataset"]], "paclet:ref/Dataset"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " (unique header labels) or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Grid"]], "paclet:ref/Grid"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " (otherwise, lossless) respectively."
}], "Notes"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["tree", "TI"]], "InlineFormula"],
 " may be an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["XMLElement"]], "paclet:ref/XMLElement"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 ", an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["XMLObject"]], "paclet:ref/XMLObject"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " document, a list of these, or a bare string; a bare string or top-level \
inline content is wrapped in a \"Text\" cell."
}], "Notes"],

Cell[TextData[{
 "Each \"Constructs\" rule is ",
 Cell[BoxData[
  StyleBox["pattern", "TI"]], "InlineFormula"],
 " -> ",
 Cell[BoxData[
  StyleBox["construct", "TI"]], "InlineFormula"],
 " (or ",
 Cell[BoxData[":>"], "InlineFormula"],
 "), where ",
 Cell[BoxData[
  StyleBox["pattern", "TI"]], "InlineFormula"],
 " is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["XMLPattern"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " (a bare string sugars to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["XMLPattern"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 "[",
 Cell[BoxData[
  StyleBox["string", "TI"]], "InlineFormula"],
 "]). Rules are tried in order, first match wins. The RHS is a cell-style \
string, an inline token (\"Bold\", \"Italic\", \"Underline\", \"StrikeThrough\
\", \"Code\", \"Hyperlink\", \"Plain\"), or a constructor function ",
 Cell[BoxData[
  StyleBox["element", "TI"]], "InlineFormula"],
 " :> ",
 Cell[BoxData[
  RowBox[{"Cell", "/", "boxes"}]], "InlineFormula"],
 "."
}], "Notes"]
}, Open  ]],

