   RowBox[{"HTMLToNotebook", "[", 
    RowBox[{"ImportString", "[", 
     RowBox[{"\"\<<table><thead><tr><th>Name</th><th>Role</th></tr></thead><\
tbody><tr><td>Ann</td><td>Dev</td></tr></tbody></table>\>\"", ",", " ", 
      RowBox[{"{", 
