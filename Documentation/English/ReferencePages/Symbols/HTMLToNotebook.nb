Cell["\<\
Override a construct to render a paragraph as a Section heading:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"ExportString", "[", 
  RowBox[{
   RowBox[{"HTMLToNotebook", "[", 
    RowBox[{
     RowBox[{"ImportString", "[", 
      RowBox[{"\"\<<p>x</p>\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<HTML\>\"", ",", " ", "\"\<XMLObject\>\""}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"\"\<Constructs\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", " ", "->", " ", "\"\<Section\>\""}], "}"}]}]}], 
    "]"}], ",", " ", "\"\<Markdown\>\""}], "]"}]], "Input"],

Cell[BoxData["\<\"### x\"\>"], "Output"]
