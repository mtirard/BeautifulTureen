     "]"}], "]"}], ",", " ", "\"\<Markdown\>\""}], "]"}]], "Input",ExpressionU\
UID->"958caba1-989f-46d1-93cb-6584c4d13546"],

Cell[BoxData["\<\"| Name | Role |\\n| - | - |\\n| Ann | Dev |\"\>"], "Output"]
