Cell["\<\
Convert a heading and a paragraph with inline formatting to Markdown:\
\>", "ExampleText"],

Cell[BoxData[
 RowBox[{"ExportString", "[", 
  RowBox[{
   RowBox[{"HTMLToNotebook", "[", 
    RowBox[{"ImportString", "[", 
     RowBox[{"\"\<<h1>Welcome</h1><p>A short <b>intro</b> with a <a \
href=\"https://wolfram.com\">link</a>.</p>\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<HTML\>\"", ",", " ", "\"\<XMLObject\>\""}], "}"}]}], 
     "]"}], "]"}], ",", " ", "\"\<Markdown\>\""}], "]"}]], "Input",ExpressionU\
UID->"7520aa32-2300-4616-9a85-acc7d6f5390e"],

Cell[BoxData["\<\"# Welcome\\n\\nA short **intro** with a \
[link](https://wolfram.com).\"\>"], "Output"]
}, Open  ]],

