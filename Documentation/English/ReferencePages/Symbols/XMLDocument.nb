Cell[CellGroupData[{
Cell["XMLDocument", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", RowBox[{SubscriptBox[StyleBox["c", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " \[LineSeparator]is a pattern for the document above the top elements of a tree, which requires what is below it to meet each constraint ", Cell[BoxData[SubscriptBox[StyleBox["c", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", "]"}]], "InlineFormula"], " \[LineSeparator]matches any document."}], "Usage"],

Cell[TextData[{"The top elements of a tree are the root element of an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", each ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " in a list, or a bare ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " itself. ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " stands for the document above them."}], "Notes"],

Cell[TextData[{"Each ", Cell[BoxData[SubscriptBox[StyleBox["c", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], " is a constraint, as in ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ": a list pattern over the top elements, with text left out, ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], ", ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["p", "TI"], ",", StyleBox["levelspec", "TI"]}], "]"}]], "InlineFormula"], ", or alternatives of these."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " can only be the ", StyleBox["pattern root", FontWeight->"Bold"], ", the top of a pattern: the whole pattern, named, with a condition or a test, or a branch of alternatives at the top, as in ", Cell[BoxData[RowBox[{ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"], "[", RowBox[{RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["_", "TR"], "]"}], "[", StyleBox["l", "TI"], "]"}], ",", RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", StyleBox["l", "TI"], "]"}]}], "]"}]], "InlineFormula"], ". Elsewhere it gives a message."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", "x : p$", ",", StyleBox["___", "TR"]}], "}"}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]], "InlineFormula"], " gives the top elements that match ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], ". ", Cell[BoxData[RowBox[{ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"], "[", RowBox[{RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["_", "TR"], "]"}], "[", StyleBox["l", "TI"], "]"}], ",", RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", StyleBox["l", "TI"], "]"}]}], "]"}]], "InlineFormula"], " lets the list pattern ", Cell[BoxData[StyleBox["l", "TI"]], "InlineFormula"], " match the children of any element or the top elements."}], "Notes"],

Cell[TextData[{"Under ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], ", a named ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], " constraint, as in ", Cell[BoxData["path : Descendant[p$]"], "InlineFormula"], ", gives every ancestor of the match. A test on the constraint, such as ", Cell[BoxData["Descendant[p$]?(NoneTrue[XMLMatchQ[\"nav\"]])"], "InlineFormula"], ", tests them all."}], "Notes"],

Cell[TextData[{"The position of the document is ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], ". A name for the whole ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " pattern gives the tree for an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " or a list, and ", Cell[BoxData[RowBox[{"{", StyleBox["e", "TI"], "}"}]], "InlineFormula"], " for a bare element ", Cell[BoxData[StyleBox["e", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", StyleBox["\[Ellipsis]", "TR"], "]"}]}], "]"}]], "InlineFormula"], " tests an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ". An element tested against an ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " pattern gives ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", "]"}]], "InlineFormula"], " with no constraints matches any document."}], "Notes"]
}, Open  ]],

