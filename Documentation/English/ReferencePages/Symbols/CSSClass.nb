Notebook[{

Cell[CellGroupData[{
Cell["CSSClass", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["cls", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]represents a constraint, for use in ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], ", matching elements whose class list contains a class matching the string pattern ", Cell[BoxData[StyleBox["cls", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{StyleBox[SubscriptBox["cls", StyleBox["1", "TR"]], "TI"], ",", " ", StyleBox[SubscriptBox["cls", StyleBox["2", "TR"]], "TI"], ",", " ", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents a constraint matching elements that carry a class matching each of ", Cell[BoxData[StyleBox[SubscriptBox["cls", StyleBox["1", "TR"]], "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox[SubscriptBox["cls", StyleBox["2", "TR"]], "TI"]], "InlineFormula"], ", \[Ellipsis].", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["cls", "TI"], "]"}], "]"}]], "InlineFormula"], " \[LineSeparator]represents a constraint matching elements that carry no class matching ", Cell[BoxData[StyleBox["cls", "TI"]], "InlineFormula"], ", including elements with no ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute at all."}], "Usage"],

Cell[TextData[{"A ", Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], " constraint selects on the element's ", StyleBox["class list", FontWeight->"Bold"], ": the whitespace-separated tokens of its ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute. An element with ", Cell[BoxData["class=\"lead disclaimer\""], "InlineFormula"], " has the class list ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["\"lead\"", "TR"], ",", " ", StyleBox["\"disclaimer\"", "TR"]}], "}"}]], "InlineFormula"], ", and ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["cls", "TI"], "]"}]], "InlineFormula"], " holds when some class in that list matches ", Cell[BoxData[StyleBox["cls", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"Each argument is an ordinary string pattern matched against ", StyleBox["one class", FontWeight->"Bold"], ", never against the whole attribute value: ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], " is one character, ", Cell[BoxData[StyleBox["__", "TR"]], "InlineFormula"], " one or more, and ", Cell[BoxData[StyleBox["___", "TR"]], "InlineFormula"], " zero or more, exactly as for ", Cell[BoxData[ButtonBox["StringMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringMatchQ"]], "InlineFormula"], ". So ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", "\"col-\" ~~ __", "]"}]], "InlineFormula"], " matches a class beginning with ", Cell[BoxData["col-"], "InlineFormula"], " and cannot run past the space into the next class, ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["___", "TR"], "]"}]], "InlineFormula"], " matches any class at all, and ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["_", "TR"], "]"}]], "InlineFormula"], " asks for a one-character class."}], "Notes"],

Cell[TextData[{"Multiple arguments are combined with AND: ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{StyleBox["a", "TI"], ",", " ", StyleBox["b", "TI"]}], "]"}]], "InlineFormula"], " matches only elements carrying a class matching ", Cell[BoxData[StyleBox["a", "TI"]], "InlineFormula"], " and a class matching ", Cell[BoxData[StyleBox["b", "TI"]], "InlineFormula"], ". Use an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " for OR semantics."}], "Notes"],

Cell[TextData[{"Each argument may be a string, a ", Cell[BoxData[ButtonBox["StringExpression", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringExpression"]], "InlineFormula"], " string pattern, an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], ", a ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["__", "TR"]], "InlineFormula"], ", or ", Cell[BoxData[StyleBox["___", "TR"]], "InlineFormula"], ", or an ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], " of any of these. A single list argument ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{"{", RowBox[{StyleBox["a", "TI"], ",", " ", StyleBox["b", "TI"]}], "}"}], "]"}]], "InlineFormula"], " is treated the same as the flattened sequence ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{StyleBox["a", "TI"], ",", " ", StyleBox["b", "TI"]}], "]"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"Wrapping an argument in ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], " negates it. A negation reads a missing ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute as an ", StyleBox["empty class list", FontWeight->"Bold"], ", so ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["cls", "TI"], "]"}], "]"}]], "InlineFormula"], " also matches an element carrying no ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " at all, as CSS ", Cell[BoxData[":not(.cls)"], "InlineFormula"], " does. ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["___", "TR"], "]"}], "]"}]], "InlineFormula"], " therefore reads as \"carries no classes\" \[LongDash] the mirror of ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["___", "TR"], "]"}]], "InlineFormula"], ", \"carries at least one class\". ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], " may be mixed with positive arguments to combine required and forbidden classes."}], "Notes"],

Cell[TextData[{"The three ways an element ends up carrying no classes \[LongDash] no ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute, ", Cell[BoxData["class=\"\""], "InlineFormula"], ", and a whitespace-only value \[LongDash] give the same empty class list, so no ", Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], " constraint distinguishes them. Presence of the ", StyleBox["attribute", FontSlant->"Italic"], " is a different question, asked with the bare-attribute shorthand ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["\"p\"", "TR"], ",", " ", StyleBox["\"class\"", "TR"]}], "]"}]], "InlineFormula"], ", which ", Cell[BoxData["class=\"\""], "InlineFormula"], " satisfies."}], "Notes"],

Cell[TextData[{"A ", Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], " of positive arguments evaluates to an ordinary attribute ", Cell[BoxData[ButtonBox["Rule", BaseStyle -> "Link", ButtonData -> "paclet:ref/Rule"]], "InlineFormula"], " and may be used anywhere such a rule is valid. A constraint containing an ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], " is ", StyleBox["not", FontSlant->"Italic"], " a rule: ", Cell[BoxData[ButtonBox["KeyValuePattern", BaseStyle -> "Link", ButtonData -> "paclet:ref/KeyValuePattern"]], "InlineFormula"], " consults a value pattern only once the key is present, which is what would make a negation miss classless elements, so a negation is meaningful only inside ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], ", which lifts it to a test on the whole attribute list."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], " returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " and issues ", Cell[BoxData["CSSClass::badarg"], "InlineFormula"], " when given an argument that is not a string, string pattern, ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], ", blank, or ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

