Cell[CellGroupData[{
Cell["CSSClass", "ObjectName"],

Cell[TextData[{
 Cell["   ", "ModInfo"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CSSClass",
    BaseStyle->"Link",
    ButtonData->"paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", 
   
   StyleBox["cls", "TI"], "]"}]], "InlineFormula"],
 " \[LineSeparator]represents a constraint matching elements whose ",
 Cell[BoxData[
 "class"], "InlineFormula"],
 " attribute contains the class ",
 Cell[BoxData[
  StyleBox["cls", "TI"]], "InlineFormula"],
 ".\n",
 Cell["   ", "ModInfo"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CSSClass",
    BaseStyle->"Link",
    ButtonData->"paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", 
   
   RowBox[{
    StyleBox[
     SubscriptBox[
      StyleBox["cls", "TI"], "1"], "TI"], ",", " ", 
    StyleBox[
     SubscriptBox[
      StyleBox["cls", "TI"], "2"], "TI"], ",", " ", 
    StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"],
 " \[LineSeparator]represents a constraint matching elements that carry all \
of the classes ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["cls", "TI"], "1"], "TI"]], "InlineFormula"],
 ", ",
 Cell[BoxData[
  StyleBox[
   SubscriptBox[
    StyleBox["cls", "TI"], "2"], "TI"]], "InlineFormula"],
 ", \[Ellipsis]."
}], "Usage"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CSSClass"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 "[",
 Cell[BoxData[
  StyleBox["cls", "TI"]], "InlineFormula"],
 "] produces a \"class\" attribute pattern that matches when the element \
class list contains ",
 Cell[BoxData[
  StyleBox["cls", "TI"]], "InlineFormula"],
 " as a whitespace-delimited token, so it matches one class within a \
multi-class attribute such as \"lead disclaimer\"."
}], "Notes"],

Cell[TextData[{
 "Multiple arguments are combined with AND: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CSSClass"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 "[",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula"],
 ", ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula"],
 "] matches only elements carrying both classes. Use an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Alternatives"]], "paclet:ref/Alternatives"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " for OR semantics."
}], "Notes"],

Cell[TextData[{
 "Wrapping an argument in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Except"]], "paclet:ref/Except"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " negates it, so ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CSSClass"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " with ",
 Cell[BoxData[
  RowBox[{"Except", "[", "cls", "]"}]], "InlineFormula"],
 " matches elements that do not carry ",
 Cell[BoxData[
  StyleBox["cls", "TI"]], "InlineFormula"],
 ". ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Except"]], "paclet:ref/Except"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " may also be mixed with positive arguments to combine required and \
forbidden classes."
}], "Notes"],

Cell[TextData[{
 "Each argument may be a string, a string pattern, an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Alternatives"]], "paclet:ref/Alternatives"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 ", or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Except"]], "paclet:ref/Except"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 "[",
 Cell[BoxData[
  StyleBox["cls", "TI"]], "InlineFormula"],
 "]. A single list argument ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CSSClass"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 "[{",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula"],
 ", ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula"],
 "}] is treated the same as the flattened sequence ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CSSClass"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 "[",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula"],
 ", ",
 Cell[BoxData[
  StyleBox["b", "TI"]], "InlineFormula"],
 "]."
}], "Notes"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CSSClass"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " is normally used as a constraint inside ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["XMLPattern"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 ", but it evaluates to an ordinary attribute rule and may be used anywhere \
such a rule is valid."
}], "Notes"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CSSClass"]], 
    "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 " returns ",
 Cell[BoxData[
 "$Failed"], "InlineFormula"],
 " and issues ",
 Cell[BoxData[
  RowBox[{"CSSClass", "::", "badarg"}]], "InlineFormula"],
 " when given an argument that is not a string, string pattern, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Alternatives"]], "paclet:ref/Alternatives"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 ", or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Except"]], "paclet:ref/Except"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula"],
 "."
}], "Notes"]
