Cell["Match an element whose class list contains the given class:", \
"ExampleText"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatchQ", "[", 
  RowBox[{
   RowBox[{"XMLElement", "[", 
    RowBox[{"\"\<p\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<class\>\"", " ", "->", " ", "\"\<lead disclaimer\>\""}], 
      "}"}], ",", " ", 
     RowBox[{"{", "}"}]}], "]"}], ",", " ", 
   RowBox[{"XMLPattern", "[", 
    RowBox[{"\"\<p\>\"", ",", " ", 
     RowBox[{"CSSClass", "[", "\"\<lead\>\"", "]"}]}], "]"}]}], 
  "]"}]], "Input"],

Cell[BoxData["True"], "Output"]
}, Open  ]]
}, Open  ]],

