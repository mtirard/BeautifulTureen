Cell[CellGroupData[{
Cell["CSSClass", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["cls", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]represents a constraint matching elements whose ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute contains the class ", Cell[BoxData[StyleBox["cls", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{StyleBox[SubscriptBox["cls", StyleBox["1", "TR"]], "TI"], ",", " ", StyleBox[SubscriptBox["cls", StyleBox["2", "TR"]], "TI"], ",", " ", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents a constraint matching elements that carry all of the classes ", Cell[BoxData[StyleBox[SubscriptBox["cls", StyleBox["1", "TR"]], "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox[SubscriptBox["cls", StyleBox["2", "TR"]], "TI"]], "InlineFormula"], ", \[Ellipsis]."}], "Usage"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["cls", "TI"], "]"}]], "InlineFormula"], " produces a \"class\" attribute pattern that matches when the element class list contains ", Cell[BoxData[StyleBox["cls", "TI"]], "InlineFormula"], " as a whitespace-delimited token, so it matches one class within a multi-class attribute such as \"lead disclaimer\"."}], "Notes"],

Cell[TextData[{"Multiple arguments are combined with AND: ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{StyleBox["a", "TI"], ",", " ", StyleBox["b", "TI"]}], "]"}]], "InlineFormula"], " matches only elements carrying both classes. Use an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " for OR semantics."}], "Notes"],

Cell[TextData[{"Wrapping an argument in ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], " negates it, so ", Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], " with ", Cell[BoxData[RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["cls", "TR"], "]"}]], "InlineFormula"], " matches elements that do not carry ", Cell[BoxData[StyleBox["cls", "TI"]], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], " may also be mixed with positive arguments to combine required and forbidden classes."}], "Notes"],

Cell[TextData[{"Each argument may be a string, a string pattern, an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], ", or ", Cell[BoxData[RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["cls", "TI"], "]"}]], "InlineFormula"], ". A single list argument ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{"{", RowBox[{StyleBox["a", "TI"], ",", " ", StyleBox["b", "TI"]}], "}"}], "]"}]], "InlineFormula"], " is treated the same as the flattened sequence ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{StyleBox["a", "TI"], ",", " ", StyleBox["b", "TI"]}], "]"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], " is normally used as a constraint inside ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], ", but it evaluates to an ordinary attribute rule and may be used anywhere such a rule is valid."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], " returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " and issues ", Cell[BoxData["CSSClass::badarg"], "InlineFormula"], " when given an argument that is not a string, string pattern, ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], ", or ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

