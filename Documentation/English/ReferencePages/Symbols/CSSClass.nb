| ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["___", "TR"], "]"}], "]"}]], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", RowBox[{"{", "}"}]}]], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{"The value at ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], " is an ordinary pattern matched against the whole class list, not a string pattern matched against one class. A literal string, or an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of literal strings, is the one exception: it means that the list contains that class."}], "Notes"],

Cell[TextData[{"A missing ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute gives the class list ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], ", so ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "_?(FreeQ[\"a\"])"}]], "InlineFormula"], " matches an element with no ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], ", as ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["\"a\"", "TR"], "]"}], "]"}]], "InlineFormula"], " did."}], "Notes"],

Cell[TextData[{"Several constraints, formerly separate arguments of ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], ", are given as one list: ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["\"a\"", "TR"], ",", " ", RowBox[{"{", RowBox[{RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", StyleBox["\"btn\"", "TR"]}], ",", " ", StyleBox["\"href\"", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " replaces ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["\"a\"", "TR"], ",", " ", RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["\"btn\"", "TR"], "]"}], ",", " ", StyleBox["\"href\"", "TR"]}], "]"}]], "InlineFormula"], "."}], "Notes"]
