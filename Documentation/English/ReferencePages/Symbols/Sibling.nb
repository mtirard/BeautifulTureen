Notebook[{

Cell[CellGroupData[{
Cell["Sibling", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"], "[", RowBox[{StyleBox["beforePat", "TI"], ",", " ", StyleBox["afterPat", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents any element that matches ", Cell[BoxData[StyleBox["afterPat", "TI"]], "InlineFormula"], " and follows a sibling that matches ", Cell[BoxData[StyleBox["beforePat", "TI"]], "InlineFormula"], ", at any distance.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"], "[", RowBox[{SubscriptBox[StyleBox["pat", "TI"], StyleBox["1", "TR"]], ",", " ", SubscriptBox[StyleBox["pat", "TI"], StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", SubscriptBox[StyleBox["pat", "TI"], StyleBox["n", "TI"]]}], "]"}]], "InlineFormula"], " \[LineSeparator]is the chain ", Cell[BoxData[RowBox[{ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"], "[", RowBox[{SubscriptBox[StyleBox["pat", "TI"], StyleBox["1", "TR"]], ",", " ", RowBox[{ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"], "[", RowBox[{SubscriptBox[StyleBox["pat", "TI"], StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", SubscriptBox[StyleBox["pat", "TI"], StyleBox["n", "TI"]]}], "]"}]}], "]"}]], "InlineFormula"], " of ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " stages."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"]], "InlineFormula"], " is a combinator for ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFirstCase"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"]], "InlineFormula"], ", like the CSS subsequent-sibling combinator before ~ after. Each argument is a stage: an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", another combinator, a CSS selector string, or alternatives of these, with or without a condition (", Cell[BoxData["/;"], "InlineFormula"], "). A stage that is alternatives holding a combinator is each of them in turn."}], "Notes"],

Cell[TextData[{"Stages chain left to right, as in a CSS selector. ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{StyleBox["b", "TR"], ",", " ", StyleBox["c", "TR"]}], "]"}]}], "]"}]], "InlineFormula"], " and ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"]}], "]"}], ",", " ", StyleBox["c", "TR"]}], "]"}]], "InlineFormula"], " both stand for the selector a b > c and select the same elements."}], "Notes"],

Cell[TextData[{"A combinator has at least two stages. With more, each stage is related to the next by the same combinator: ", Cell[BoxData["Sibling[a, b, c]"], "InlineFormula"], " is ", Cell[BoxData["Sibling[a, Sibling[b, c]]"], "InlineFormula"], ", the selector a ~ b ~ c."}], "Notes"],

Cell["A combinator gives the elements that match its last stage, each once, in document order.", "Notes"],

Cell[TextData[{"A condition on a stage can use only the names bound in that stage. A condition on the whole combinator, as in ", Cell[BoxData["Descendant[d : XMLPattern[\"div\"], p : XMLPattern[\"p\"]] /; test"], "InlineFormula"], ", can use the names bound in all its stages."}], "Notes"],

Cell["A name used in two stages must be bound to the same value in both.", "Notes"],

Cell[TextData[{"An ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or alternatives of them can be named, as in ", Cell[BoxData["p : XMLPattern[\"p\"]"], "InlineFormula"], ". A combinator cannot be named, and alternatives cannot contain a combinator."}], "Notes"],

Cell[TextData[{"A name bound in ", Cell[BoxData[StyleBox["beforePat", "TI"]], "InlineFormula"], " gives the first matching earlier sibling in document order, not the nearest one."}], "Notes"],

Cell[TextData[{"When the combinator has a condition, or a name is used in both stages, a name bound in ", Cell[BoxData[StyleBox["beforePat", "TI"]], "InlineFormula"], " gives the first earlier sibling for which the whole pattern matches."}], "Notes"],

Cell[TextData[{"The top-level elements of a list given as the tree are siblings. A bare ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " given as the tree, and the root element of an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", have no siblings."}], "Notes"],

Cell[TextData[{"Only elements count as siblings, not the text between them. ", Cell[BoxData[RowBox[{ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"]}], "]"}]], "InlineFormula"], " is a shorthand for ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{"XMLDocument[] | XMLPattern[_]", ",", " ", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", StyleBox["a", "TR"], ",", " ", StyleBox["___", "TR"], ",", " ", StyleBox["b", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], ", a list of patterns for the children of any element or of the document above the top-level elements, and after another stage the list is over the children of that stage's parent: ", Cell[BoxData[RowBox[{ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Sibling"], "[", RowBox[{RowBox[{ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Adjacent"], "[", RowBox[{StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"]}], "]"}], ",", " ", StyleBox["c", "TR"]}], "]"}]], "InlineFormula"], " is ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", RowBox[{"XMLDocument[] | XMLPattern[_]", ",", " ", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", StyleBox["a", "TR"], ",", " ", StyleBox["b", "TR"], ",", " ", StyleBox["___", "TR"], ",", " ", StyleBox["c", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

