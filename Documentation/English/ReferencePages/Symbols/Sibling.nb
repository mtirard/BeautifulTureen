XMLCases[row,(Sibling[XMLPattern[\"li\",\"value\"->v1_],item:XMLPattern[\"li\",\"value\"->v2_]]/;ToExpression[v2]<ToExpression[v1]):>HTMLTextContent[item]]"], "Input"],

