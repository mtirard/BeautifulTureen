Cell[CellGroupData[{
Cell["HTMLTextContent", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]gives the text content of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ": the lossless concatenation, in document order, of every descendant string, with no whitespace inserted or removed."}], "Usage"],

Cell[TextData[{"In ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", every descendant string is joined in document order. No whitespace is inserted at block boundaries and ", Cell[BoxData["br"], "InlineFormula"], " elements do not become newlines, so adjacent inline text may run together."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " may be an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], ", an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLObject"]], "paclet:ref/XMLObject"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " document (its root element is used), a list of these, or a bare string."}], "Notes"],

Cell[TextData[{"Concatenation is lossless: source indentation, newlines, and ", Cell[BoxData["pre"], "InlineFormula"], " whitespace all survive unchanged. For readable text \\[LongDash] collapsed whitespace, block tags on their own lines, ", Cell[BoxData["br"], "InlineFormula"], " as newlines \\[LongDash] use ", Cell[BoxData[TemplateBox[{Cell[TextData["HTMLInnerText"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "."}], "Notes"],

Cell["Stray nodes that are neither elements nor strings, such as comments, contribute the empty string \"\".", "Notes"],

Cell[TextData[{"Given an argument that is not a valid tree, ", Cell[BoxData[TemplateBox[{Cell[TextData["HTMLTextContent"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " returns ", Cell[BoxData[TemplateBox[{Cell[TextData["$Failed"]], "paclet:ref/$Failed"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " and issues a message."}], "Notes"],

Cell[TextData[{Cell[BoxData[TemplateBox[{Cell[TextData["HTMLTextContent"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " is commonly applied to the results of ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLCases"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " or ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLFirstCase"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " to extract text from matched elements."}], "Notes"]
}, Open  ]],

