Cell[CellGroupData[{
Cell["HTMLTextContent", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]gives the text content of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ": the lossless concatenation, in document order, of every descendant string, with no whitespace inserted or removed."}], "Usage"],

Cell[TextData[{"In ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", every descendant string is joined in document order. No whitespace is inserted at block boundaries and ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " elements do not become newlines, so adjacent inline text may run together."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " may be an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " document (its root element is used), a list of ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " objects, or a bare string."}], "Notes"],

Cell[TextData[{"Concatenation is lossless: source indentation, newlines, and ", Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], " whitespace all survive unchanged. For readable text \[LongDash] collapsed whitespace, block tags on their own lines, ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " as newlines \[LongDash] use ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], "."}], "Notes"],

Cell["Stray nodes that are neither elements nor strings, such as comments, contribute the empty string \"\".", "Notes"],

Cell[TextData[{"Given an argument that is not a valid tree, ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineFormula"], " returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " and issues a message."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineFormula"], " is commonly applied to the results of ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], " to extract text from matched elements."}], "Notes"]
}, Open  ]],

