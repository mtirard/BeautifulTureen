Notebook[{

Cell[CellGroupData[{
Cell["HTMLWhitespace", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], " \[LineSeparator]represents a run of one or more HTML ASCII whitespace characters in a string pattern."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], " matches a run of one or more of the five characters that HTML counts as ASCII whitespace:

| character | code |
| --- | --- |
| space | 32 |
| tab ", Cell[BoxData[StyleBox["\"\\t\"", "TR"]], "InlineFormula"], " | 9 |
| line feed ", Cell[BoxData[StyleBox["\"\\n\"", "TR"]], "InlineFormula"], " | 10 |
| form feed ", Cell[BoxData[StyleBox["\"\\f\"", "TR"]], "InlineFormula"], " | 12 |
| carriage return ", Cell[BoxData[StyleBox["\"\\r\"", "TR"]], "InlineFormula"], " | 13 |"}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], " is the delimiter of HTML's space-separated attributes, such as ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], ". ", Cell[BoxData[RowBox[{ButtonBox["StringSplit", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringSplit"], "[", RowBox[{StyleBox["value", "TI"], ",", " ", ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]}], "]"}]], "InlineFormula"], " splits such a value as a browser does."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["Whitespace", BaseStyle -> "Link", ButtonData -> "paclet:ref/Whitespace"]], "InlineFormula"], ", and the default of ", Cell[BoxData[ButtonBox["StringSplit", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringSplit"]], "InlineFormula"], ", also match no-break space, the vertical tab, and other Unicode whitespace characters. HTML treats none of these as a delimiter, so a no-break space inside a ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " value is part of a class name."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], " is a run, as ", Cell[BoxData[ButtonBox["Whitespace", BaseStyle -> "Link", ButtonData -> "paclet:ref/Whitespace"]], "InlineFormula"], " is, rather than a single character, as ", Cell[BoxData[ButtonBox["WhitespaceCharacter", BaseStyle -> "Link", ButtonData -> "paclet:ref/WhitespaceCharacter"]], "InlineFormula"], " is. Splitting on it never gives an empty token between two adjacent whitespace characters. ", Cell[BoxData["HTMLWhitespace .."], "InlineFormula"], " matches the same strings."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], " can be used wherever a string pattern can, as in ", Cell[BoxData[ButtonBox["StringTrim", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringTrim"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["StringReplace", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringReplace"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["StringCount", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringCount"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["StringMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringMatchQ"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " and the space-separated method of ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " split on ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], ", and the comma-separated method trims it from each token."}], "Notes"]
}, Open  ]],

