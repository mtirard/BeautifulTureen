Cell["XMLMatchQ", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"], "[", RowBox[{StyleBox["element", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"], " if ", Cell[BoxData[StyleBox["element", "TI"]], "InlineFormula"], " matches ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " as the top of the pattern, and ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], " otherwise.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"], "[", RowBox[{StyleBox["document", "TI"], ",", RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", StyleBox["\[Ellipsis]", "TR"], "]"}]}], "]"}]], "InlineFormula"], " \[LineSeparator]tests an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " document.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"], "[", RowBox[{RowBox[{"{", RowBox[{SubscriptBox[StyleBox["e", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["e", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}], ",", StyleBox["listpattern", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]tests a list of elements against a list pattern, leaving strings out.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"], "[", StyleBox["pattern", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]represents an operator form of ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], " that can be applied to an element."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], " tests the element itself as the ", StyleBox["pattern root", FontWeight->"Bold"], ", the top of the pattern, as ", Cell[BoxData[ButtonBox["StringMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringMatchQ"]], "InlineFormula"], " tests a whole string. Constraints in the pattern test the elements below it. To search a tree, use ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], "; to test whether any element of a tree matches, use ", Cell[BoxData[ButtonBox["XMLFreeQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFreeQ"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], " treats an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " as a literal expression, as it treats a string pattern."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " can have the following forms, each of which can be named, have a condition, as in ", Cell[BoxData["pattern$ /; test$"], "InlineFormula"], ", or have a test, as in ", Cell[BoxData["pattern$?f$"], "InlineFormula"], ":"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["form", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["\[Ellipsis]", "TR"], "]"}], Cell["an element pattern, which can have constraints on the elements below it", "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"], "[", StyleBox["\[Ellipsis]", "TR"], "]"}], Cell["an element pattern matched exactly as written, text included", "TableText"]},
{Cell["      ", "ModInfo"], "\"\<\!\(\*StyleBox[\"selector\", \"TI\"]\)\>\"", Cell[TextData[{"a CSS selector string that describes one element, such as ", Cell[BoxData["\"a.external\""], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", StyleBox["\[Ellipsis]", "TR"], "]"}], Cell[TextData[{"a pattern for a document, which tests an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{"{", RowBox[{SubscriptBox[StyleBox["p", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["p", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}], Cell["a list pattern, which tests a list of elements, with strings left out", "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"], "[", RowBox[{SubscriptBox[StyleBox["p", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["p", "TI"], StyleBox["2", "TR"]]}], "]"}], Cell["any of the patterns", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"A kind mismatch gives ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], ": an element tested against an ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " or list pattern, or a document or list tested against an element pattern. An expression that is not an element, a document or a list gives ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A name in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " selects nothing, but it can be used in a condition."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " if ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is a malformed ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", a rule such as ", Cell[BoxData[RowBox[{StyleBox["p", "TI"], "\[RuleDelayed]", StyleBox["body", "TI"]}]], "InlineFormula"], ", or a CSS selector that matches an element by what is above or beside it, such as ", Cell[BoxData["\"nav a\""], "InlineFormula"], " or ", Cell[BoxData["\"li:first-child\""], "InlineFormula"], "."}], "Notes"],

Cell["The following option can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "\"AttributeReadings\"", StyleBox["<||>", "TR"], Cell[TextData[{"entries to add to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " for this test"}], "TableText"]}
}]], "3ColumnTableMod"],

Cell[TextData[{"In the operator form, give options with the pattern: ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"], "[", RowBox[{StyleBox["pattern", "TI"], ",", RowBox[{StyleBox["opts", "TI"], StyleBox["\[Ellipsis]", "TR"]}]}], "]"}], "[", StyleBox["element", "TI"], "]"}]], "InlineFormula"], "."}], "Notes"]
