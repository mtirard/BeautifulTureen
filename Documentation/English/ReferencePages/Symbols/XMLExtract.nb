Cell[TextData[{"When ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches, ", Cell[BoxData[RowBox[{ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]}], "]"}]], "InlineFormula"], " gives what ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " gives. When nothing matches, ", Cell[BoxData[ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"]], "InlineFormula"], " gives ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], ", which ", Cell[BoxData[ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"]], "InlineFormula"], " reads as the position of the document."}], "Notes"],

Cell[TextData[{"A position is a list of indices among element children, starting at the document at ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], ". The root element of an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", and an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " given as the tree, are at ", Cell[BoxData[RowBox[{"{", StyleBox["1", "TR"], "}"}]], "InlineFormula"], "; the ", Cell[BoxData[StyleBox["i", "TI"]], "InlineFormula"], "-th element of a list is at ", Cell[BoxData[RowBox[{"{", StyleBox["i", "TI"], "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A position for an element is a list of indices ", Cell[BoxData[RowBox[{"{", RowBox[{SubscriptBox[StyleBox["i", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["i", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]], "InlineFormula"], ". Other positions end in one of the following:"}], "Notes"],

