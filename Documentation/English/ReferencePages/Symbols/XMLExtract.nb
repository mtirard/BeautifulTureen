Cell["XMLExtract", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pos", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives the part of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " at the position ", Cell[BoxData[StyleBox["pos", "TI"]], "InlineFormula"], ", as ", Cell[BoxData[ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"]], "InlineFormula"], " gives positions.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{"{", RowBox[{SubscriptBox[StyleBox["pos", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["pos", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives a list of the parts at each ", Cell[BoxData[SubscriptBox[StyleBox["pos", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"]], "InlineFormula"], " reads the positions that ", Cell[BoxData[ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"]], "InlineFormula"], " gives. ", Cell[BoxData[RowBox[{ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]}], "]"}]], "InlineFormula"], " gives what ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " gives."}], "Notes"],

Cell[TextData[{"A position counts ", StyleBox["element children only", FontWeight->"Bold"], ", from the document. ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " is the document, the root element of an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " or a bare ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " given as the tree is ", Cell[BoxData[RowBox[{"{", StyleBox["1", "TR"], "}"}]], "InlineFormula"], ", and the ", Cell[BoxData[StyleBox["i", "TR"]], "InlineFormula"], "-th element of a list is ", Cell[BoxData[RowBox[{"{", StyleBox["i", "TR"], "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A position for an element is a list of indices ", Cell[BoxData[RowBox[{"{", RowBox[{SubscriptBox[StyleBox["i", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["i", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]], "InlineFormula"], ". Other positions end in one of the following, and give the following parts:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["end", "TableText"], FontSlant->"Italic"], StyleBox[Cell["part", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "0", Cell["the tag", "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Key", BaseStyle -> "Link", ButtonData -> "paclet:ref/Key"], "[", ButtonBox["All", BaseStyle -> "Link", ButtonData -> "paclet:ref/All"], "]"}], Cell["the attribute list", "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Key", BaseStyle -> "Link", ButtonData -> "paclet:ref/Key"], "[", "\"\<\!\(\*StyleBox[\"key\", \"TI\"]\)\>\"", "]"}], Cell[TextData[{"the value of an attribute, or the list of tokens of a list key such as ", Cell[BoxData["\"classList\""], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "Key[\"key$\"], i$", Cell[TextData[{"the ", Cell[BoxData[StyleBox["i", "TI"]], "InlineFormula"], "-th token of a list key"}], "TableText"]},
{Cell["      ", "ModInfo"], ButtonBox["All", BaseStyle -> "Link", ButtonData -> "paclet:ref/All"], Cell["the contents, text included", "TableText"]},
{Cell["      ", "ModInfo"], "m$ ;; n$", Cell[TextData[{"the element children ", Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula"], " to ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], ", as a sequence"}], "TableText"]},
{Cell["      ", "ModInfo"], "n$ ;; n$-1", Cell[TextData[{"the empty place before element child ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], ", as ", Cell[BoxData[RowBox[{ButtonBox["Sequence", BaseStyle -> "Link", ButtonData -> "paclet:ref/Sequence"], "[", "]"}]], "InlineFormula"]}], "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"], "[", RowBox[{StyleBox["tree", "TI"], ",", "upper$ ;; lower$"}], "]"}]], "InlineFormula"], " gives the list of the elements strictly between the element at ", Cell[BoxData[StyleBox["upper", "TI"]], "InlineFormula"], " and the element at ", Cell[BoxData[StyleBox["lower", "TI"]], "InlineFormula"], ", outermost first, as a named path in ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], " does. ", Cell[BoxData[StyleBox["upper", "TI"]], "InlineFormula"], " is ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " or a position above ", Cell[BoxData[StyleBox["lower", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{"{", RowBox[{SubscriptBox[StyleBox["pos", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["pos", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " gives a list of parts. A list is read as several positions when every entry is a list or a path."}], "Notes"],

Cell[TextData[{"A position that is not of these forms gives ", Cell[BoxData["XMLExtract::pos"], "InlineFormula"], ". A position of these forms that the tree does not have gives ", Cell[BoxData["XMLExtract::nopos"], "InlineFormula"], ". Both return ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"],

