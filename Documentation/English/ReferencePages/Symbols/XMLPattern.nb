Notebook[{

Cell[CellGroupData[{
Cell["XMLPattern", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["tag", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]is an XML pattern that represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attrs", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " and whose attributes match ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["tag", "TI"], "]"}], "[", RowBox[{SubscriptBox[StyleBox["c", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " and below which each constraint ", Cell[BoxData[SubscriptBox[StyleBox["c", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], " is met, such as a list pattern over its element children, ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " or ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attrs", "TI"]}], "]"}], "[", RowBox[{SubscriptBox[StyleBox["c", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " \[LineSeparator]also requires the attributes to match ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " is not an ordinary pattern: ", Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ReplaceAll", BaseStyle -> "Link", ButtonData -> "paclet:ref/ReplaceAll"]], "InlineFormula"], ", etc. treat it as a literal expression. Only the functions of this paclet interpret it, such as ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " may have the following forms:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["form", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "\"name\"", Cell[TextData[{"an element with the tag ", Cell[BoxData["\"name\""], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", StyleBox["name", "TI"]}], "}"}], Cell["an element with a namespaced tag", "TableText"]},
{Cell["      ", "ModInfo"], "\"h1\" | \"h2\"", Cell["an element with any of the given tags", "TableText"]},
{Cell["      ", "ModInfo"], StyleBox["patt", "TI"], Cell[TextData[{"an element whose tag matches the pattern ", Cell[BoxData[StyleBox["patt", "TI"]], "InlineFormula"], ", such as ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], ", ", Cell[BoxData["t_"], "InlineFormula"], " or ", Cell[BoxData["_?(StringMatchQ[\"h\" ~~ DigitCharacter])"], "InlineFormula"]}], "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " may have the following forms:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["form", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], StyleBox["_", "TR"], Cell[TextData[{"any attributes, the same as leaving out ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}], Cell[TextData[{"an attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " whose value matches ", Cell[BoxData[StyleBox["val", "TI"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], StyleBox["key", "TI"], Cell[TextData[{"an attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " with any value, equivalent to ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["_", "TR"]}]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{"{", RowBox[{"{", RowBox[{StyleBox["ns", "TI"], ",", StyleBox["name", "TI"]}], "}"}], "}"}], Cell["a namespaced attribute with any value", "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{"{", RowBox[{SubscriptBox[StyleBox["a", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["a", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}], Cell[TextData[{"attributes that match each of ", Cell[BoxData[SubscriptBox[StyleBox["a", "TI"], StyleBox["1", "TR"]]], "InlineFormula"], ", ", Cell[BoxData[SubscriptBox[StyleBox["a", "TI"], StyleBox["2", "TR"]]], "InlineFormula"], ", etc."}], "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"The order of the attribute constraints ", Cell[BoxData[SubscriptBox[StyleBox["a", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], " does not matter, and the element may have other attributes as well."}], "Notes"],

Cell[TextData[{"A value may be any pattern. It is matched against the whole attribute value, so ", Cell[BoxData[RowBox[{"\"class\"", "\[Rule]", "\"lead\""}]], "InlineFormula"], " matches ", Cell[BoxData["class=\"lead\""], "InlineFormula"], " but not ", Cell[BoxData["class=\"lead intro\""], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A key must be a string, a ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " pair, or alternatives of these, such as ", Cell[BoxData[RowBox[{RowBox[{"(", "\"href\" | \"src\"", ")"}], "\[Rule]", "url_"}]], "InlineFormula"], ". A pattern such as ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], " or ", Cell[BoxData["_?StringQ"], "InlineFormula"], " cannot be a key."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " may also be named or tested as a whole, as in ", Cell[BoxData["attrs : {\"id\" -> _}"], "InlineFormula"], " or ", Cell[BoxData["_?(Keys /* AnyTrue[StringStartsQ[\"data-\"]])"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A ", StyleBox["list key", FontWeight->"Bold"], " is a key, such as ", Cell[BoxData["\"classList\""], "InlineFormula"], ", whose value is a list of tokens taken from an attribute. For ", Cell[BoxData["\"classList\""], "InlineFormula"], ", the list is the value of ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " split on ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLWhitespace"]], "InlineFormula"], ", or ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " for an element without classes. Entries in ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " add list keys for other attributes."}], "Notes"],

Cell[TextData[{"At a list key, a string, or alternatives of strings, matches one token among several: ", Cell[BoxData[RowBox[{"\"classList\"", "\[Rule]", "\"lead\""}]], "InlineFormula"], " matches any element that has the class ", Cell[BoxData[StyleBox["lead", "TR"]], "InlineFormula"], ". Any other value is matched against the whole list, as in ", Cell[BoxData[RowBox[{"\"classList\"", "\[Rule]", RowBox[{"{", RowBox[{"\"lead\"", ",", StyleBox["___", "TR"]}], "}"}]}]], "InlineFormula"], " for a first class ", Cell[BoxData[StyleBox["lead", "TR"]], "InlineFormula"], ", or ", Cell[BoxData[RowBox[{"\"classList\"", "\[Rule]", "c_"}]], "InlineFormula"], ", which binds ", Cell[BoxData[StyleBox["c", "TR"]], "InlineFormula"], " to the list."}], "Notes"],

Cell[TextData[{"To check for classes in any order, use functions such as ", Cell[BoxData[ButtonBox["MemberQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MemberQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["FreeQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/FreeQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsAll", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAll"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["ContainsNone", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsNone"]], "InlineFormula"], ". The following table gives some CSS class selectors and their equivalents:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["CSS", "TableText"], FontSlant->"Italic"], StyleBox[Cell["``attrs$``", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], ".a", RowBox[{"\"classList\"", "\[Rule]", "\"a\""}]},
{Cell["      ", "ModInfo"], ".a.b", RowBox[{"\"classList\"", "\[Rule]", "_?(ContainsAll[{\"a\", \"b\"}])"}]},
{Cell["      ", "ModInfo"], ".a, .b", RowBox[{"\"classList\"", "\[Rule]", "\"a\" | \"b\""}]},
{Cell["      ", "ModInfo"], ":not(.a)", RowBox[{"\"classList\"", "\[Rule]", "_?(FreeQ[\"a\"])"}]},
{Cell["      ", "ModInfo"], "[class]", "\"class\""},
{Cell["      ", "ModInfo"], ":not([class])", "_?(FreeQ[\"class\" -> _])"}
}]], "2ColumnTableMod"],

Cell[TextData[{"A ", StyleBox["constraint", FontWeight->"Bold"], " is a condition on what is below an element. ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attrs", "TI"]}], "]"}], "[", RowBox[{SubscriptBox[StyleBox["c", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " matches an element when each constraint ", Cell[BoxData[SubscriptBox[StyleBox["c", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], " holds below it, so patterns are nested as the document is."}], "Notes"],

Cell[TextData[{"A constraint ", Cell[BoxData[SubscriptBox[StyleBox["c", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], " may have the following forms:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["form", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], RowBox[{"{", RowBox[{SubscriptBox[StyleBox["p", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["p", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}], Cell["the element children, text left out, match the list pattern", "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", StyleBox["p", "TI"], "]"}], Cell[TextData[{"some element child matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], ", the same as ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", StyleBox["p", "TI"], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", StyleBox["p", "TI"], "]"}], Cell[TextData[{"some element anywhere below matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["p", "TI"], ",", StyleBox["levelspec", "TI"]}], "]"}], Cell[TextData[{"some element at the depths in ", Cell[BoxData[StyleBox["levelspec", "TI"]], "InlineFormula"], " matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], ", with the children at depth 1"}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"], "[", RowBox[{SubscriptBox[StyleBox["c", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["2", "TR"]]}], "]"}], Cell["either constraint holds", "TableText"]}
}]], "2ColumnTableMod"],

Cell["All the constraints must hold, in any order. They are independent, so one element below may meet several of them. A name used in two constraints must match the same part in both.", "Notes"],

Cell[TextData[{"An entry of a list pattern can be an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern, a CSS selector for one element, ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], " for any one element child, or a sequence pattern such as ", Cell[BoxData[StyleBox["___", "TR"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Repeated", BaseStyle -> "Link", ButtonData -> "paclet:ref/Repeated"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["PatternSequence", BaseStyle -> "Link", ButtonData -> "paclet:ref/PatternSequence"]], "InlineFormula"], ". So ", Cell[BoxData[RowBox[{"{", RowBox[{"x : XMLPattern[\"li\"]", ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], " matches an element whose first element child is an ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A list pattern can be named, as in ", Cell[BoxData["s : {___}"], "InlineFormula"], ", have a condition, or have a test."}], "Notes"],

Cell[TextData[{"A name inside a constraint can be bound to an element below, to its attributes, to a run of children, etc. Use it on the right-hand side of a rule in functions such as ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A CSS selector for one element, one that depends only on its element and what is below it, such as ", Cell[BoxData["\"ul.menu\""], "InlineFormula"], ", can be given in place of an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ". It takes constraints in the same way, as in ", Cell[BoxData["\"ul.menu\"[{x : \"li\", ___}]"], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " gives the ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " for a selector."}], "Notes"]
}, Open  ]],

