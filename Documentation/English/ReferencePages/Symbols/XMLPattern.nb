Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Of two attributes with the same name, HTML import keeps the last, where a browser keeps the first:", "ExampleText"], Cell[BoxData["XMLCases[ImportString[\"<p class=\\\"first\\\" class=\\\"second\\\">x</p>\",{\"HTML\",\"XMLObject\"}],XMLPattern[\"p\",\"classList\"->c_]:>c]"], "Input"],

