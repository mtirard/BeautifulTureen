Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A string matches one class only at a key whose alternatives are all list keys:", "ExampleText"], Cell[BoxData["element=XMLElement[\"div\",{\"class\"->\"lead\"},{}];
{XMLMatchQ[element,XMLPattern[\"div\",(\"classList\"|\"id\")->\"lead\"]],XMLMatchQ[element,XMLPattern[\"div\",\"classList\"->\"lead\"]]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"False", ",", "True"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell[TextData[{"In a hand-built tree, the list key ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], " hides an attribute of that name:"}], "ExampleText"], Cell[BoxData["element=XMLElement[\"p\",{\"classList\"->\"x\",\"class\"->\"lead\"},{}];
{XMLMatchQ[element,XMLPattern[\"p\",\"classList\"->\"x\"]],XMLMatchQ[element,XMLPattern[\"p\",\"classList\"->\"lead\"]]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"False", ",", "True"}], "}"}]], "Output"],

