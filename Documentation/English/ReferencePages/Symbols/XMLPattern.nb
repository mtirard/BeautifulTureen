Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", StyleBox["tag", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]is a pattern object that represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", RowBox[{StyleBox["constraints", "TI"], StyleBox["\[Ellipsis]", "TR"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " and whose attributes satisfy the given ", Cell[BoxData[StyleBox["constraints", "TI"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", StyleBox["tag", "TI"], "]"}]], "InlineFormula"], " expands to the ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern ", Cell[BoxData[RowBox[{ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", StyleBox["_", "TR"], ",", " ", StyleBox["_", "TR"]}], "]"}]], "InlineFormula"], ", matching any element with the given tag regardless of attributes or content."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", RowBox[{StyleBox["constraints", "TI"], StyleBox["\[Ellipsis]", "TR"]}]}], "]"}]], "InlineFormula"], " adds attribute constraints, expanding to an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern whose attributes are matched with ", Cell[BoxData[ButtonBox["KeyValuePattern", BaseStyle -> "Link", ButtonData -> "paclet:ref/KeyValuePattern"]], "InlineFormula"], ".

Each constraint may take one of these forms:

| form | description |
| --- | --- |
| ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " | an attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " whose value matches ", Cell[BoxData[StyleBox["val", "TI"]], "InlineFormula"], " |
| ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " | an attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " with any value (shorthand for ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["_", "TR"]}]], "InlineFormula"], ") |
| ", Cell[BoxData[RowBox[{ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"], "[", StyleBox["cls", "TI"], "]"}]], "InlineFormula"], " | a ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute containing ", Cell[BoxData[StyleBox["cls", "TI"]], "InlineFormula"], " |

In ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " the value ", Cell[BoxData[StyleBox["val", "TI"]], "InlineFormula"], " is itself a pattern \[LongDash] a literal string for an exact value, ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], " for any value, a named pattern such as ", Cell[BoxData["v_"], "InlineFormula"], " to capture it, or an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of allowed values. The key ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " is normally an attribute name, but ", Cell[BoxData[ButtonBox["Import", BaseStyle -> "Link", ButtonData -> "paclet:ref/Import"]], "InlineFormula"], " represents a namespaced attribute such as ", Cell[BoxData["xlink:href"], "InlineFormula"], " with a ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " pair key; match it by writing the key as a two-element list \[LongDash] for example ", Cell[BoxData[RowBox[{RowBox[{"{", RowBox[{StyleBox["_", "TR"], ",", " ", StyleBox["\"href\"", "TR"]}], "}"}], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " to match the local name in any namespace."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " may be a string, an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of strings, or an ordinary pattern matched against the element's tag \[LongDash] a ", Cell[BoxData[ButtonBox["Blank", BaseStyle -> "Link", ButtonData -> "paclet:ref/Blank"]], "InlineFormula"], " ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], ", a named pattern such as ", Cell[BoxData["t_"], "InlineFormula"], ", a typed blank such as ", Cell[BoxData[StyleBox["_String", "TR"]], "InlineFormula"], ", or a predicate form such as ", Cell[BoxData["_?test"], "InlineFormula"], " or ", Cell[BoxData["t_ /; test"], "InlineFormula"], ". A ", Cell[BoxData[ButtonBox["StringExpression", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringExpression"]], "InlineFormula"], " string pattern is not accepted for the tag; to match by tag shape, use an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " for a fixed set or a ", Cell[BoxData[ButtonBox["StringMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringMatchQ"]], "InlineFormula"], " predicate such as ", Cell[BoxData["_?(StringMatchQ[\"h\" ~~ DigitCharacter])"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " with ", Cell[BoxData["XMLPattern::badtag"], "InlineFormula"], " for an invalid tag, or ", Cell[BoxData["XMLPattern::badconstraint"], "InlineFormula"], " (naming the offending constraint) when a constraint is neither a rule nor an attribute-existence string."}], "Notes"]
