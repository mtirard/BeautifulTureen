Notebook[{

Cell[CellGroupData[{
Cell["XMLPattern", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", StyleBox["tag", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]is an XML pattern that represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", StyleBox["attrs", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " and whose attributes match ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " is not an ordinary pattern: ", Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ReplaceAll", BaseStyle -> "Link", ButtonData -> "paclet:ref/ReplaceAll"]], "InlineFormula"], ", etc. treat it as a literal expression. Only the functions of this paclet interpret it, notably those whose names start with XML, such as ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " may have the following forms:

| form | description |
| --- | --- |
| ", Cell[BoxData[StyleBox["\"name\"", "TR"]], "InlineFormula"], " | an element with the tag ", Cell[BoxData[StyleBox["\"name\"", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " | an element with a namespaced tag |
| ", Cell[BoxData["\"h1\" | \"h2\""], "InlineFormula"], " | an element with any of the given tags |
| ", Cell[BoxData[StyleBox["patt", "TI"]], "InlineFormula"], " | an element whose tag matches the pattern ", Cell[BoxData[StyleBox["patt", "TI"]], "InlineFormula"], ", such as ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], ", ", Cell[BoxData["t_"], "InlineFormula"], " or ", Cell[BoxData["_?(StringMatchQ[\"h\" ~~ DigitCharacter])"], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " may have the following forms:

| form | description |
| --- | --- |
| ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " | an attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " whose value matches ", Cell[BoxData[StyleBox["val", "TI"]], "InlineFormula"], " |
| ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " | an attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " with any value, equivalent to ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["_", "TR"]}]], "InlineFormula"], " |
| ", Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{StyleBox["ns", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}], "}"}]], "InlineFormula"], " | a namespaced attribute with any value |
| ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox[SubscriptBox["c", StyleBox["1", "TR"]], "TI"], ",", " ", StyleBox[SubscriptBox["c", StyleBox["2", "TR"]], "TI"], ",", " ", StyleBox["\[Ellipsis]", "TR"]}], "}"}]], "InlineFormula"], " | attributes matching each of the constraints ", Cell[BoxData[StyleBox[SubscriptBox["c", StyleBox["i", "TI"]], "TI"]], "InlineFormula"], " |"}], "Notes"],

Cell["The order of the constraints does not matter, and the element may have other attributes as well.", "Notes"],

Cell[TextData[{"A value may be any pattern. It is matched against the whole attribute value, so ", Cell[BoxData[RowBox[{StyleBox["\"class\"", "TR"], "\[Rule]", StyleBox["\"lead\"", "TR"]}]], "InlineFormula"], " matches ", Cell[BoxData["class=\"lead\""], "InlineFormula"], " but not ", Cell[BoxData["class=\"lead intro\""], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The ", StyleBox["list key", FontWeight->"Bold"], " ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], " stands for the element's classes as a list of strings: the value of ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " split on ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], ", or ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " for an element without classes. ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " can add list keys for other attributes."}], "Notes"],

Cell[TextData[{"At a list key, the value is matched against the whole list: ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", RowBox[{"{", RowBox[{StyleBox["\"lead\"", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]}]], "InlineFormula"], " matches an element whose first class is ", Cell[BoxData[StyleBox["lead", "TR"]], "InlineFormula"], ", and ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "c_"}]], "InlineFormula"], " binds ", Cell[BoxData[StyleBox["c", "TR"]], "InlineFormula"], " to the list."}], "Notes"],

Cell[TextData[{"A string at a list key is the exception: ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", StyleBox["\"lead\"", "TR"]}]], "InlineFormula"], " matches any element that has the class ", Cell[BoxData[StyleBox["lead", "TR"]], "InlineFormula"], ", as if written ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", StyleBox["\"lead\"", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], ". The same holds for alternatives of strings, such as ", Cell[BoxData["\"lead\" | \"intro\""], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A list pattern such as ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["\"lead\"", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], " depends on the order of the classes. To check membership in any order, use functions such as ", Cell[BoxData[ButtonBox["MemberQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MemberQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["FreeQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/FreeQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsAll", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAll"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsAny", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAny"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["ContainsNone", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsNone"]], "InlineFormula"], ". The following table gives some CSS class selectors and their equivalents:

| CSS | ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " |
| --- | --- |
| ", Cell[BoxData[".a"], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", StyleBox["\"a\"", "TR"]}]], "InlineFormula"], " |
| ", Cell[BoxData[".a.b"], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "_?(ContainsAll[{\"a\", \"b\"}])"}]], "InlineFormula"], " |
| ", Cell[BoxData[".a, .b"], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "\"a\" | \"b\""}]], "InlineFormula"], " |
| ", Cell[BoxData[":not(.a)"], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "_?(FreeQ[\"a\"])"}]], "InlineFormula"], " |
| ", Cell[BoxData["[class]"], "InlineFormula"], " | ", Cell[BoxData[StyleBox["\"class\"", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData[":not([class])"], "InlineFormula"], " | ", Cell[BoxData["_?(FreeQ[\"class\" -> _])"], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{"A key must be a string, a ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " pair, or alternatives of these, such as ", Cell[BoxData[RowBox[{RowBox[{"(", "\"href\" | \"src\"", ")"}], "\[Rule]", "url_"}]], "InlineFormula"], ". A pattern such as ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], " or ", Cell[BoxData["_?StringQ"], "InlineFormula"], " cannot be a key."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " may also be named or tested as a whole, as in ", Cell[BoxData["attrs : {\"id\" -> _}"], "InlineFormula"], " or ", Cell[BoxData["_?(Keys /* AnyTrue[StringStartsQ[\"data-\"]])"], "InlineFormula"], ". Use this to check all the attributes at once, for example for an attribute name starting with ", Cell[BoxData["data-"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A name for the whole element, as in ", Cell[BoxData["e : XMLPattern[\"p\"]"], "InlineFormula"], ", gives the element as it is in the tree, without list keys such as ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], ". So does a name for ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A malformed ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " is reported only when a function interprets it. That function issues a message, such as ", Cell[BoxData["XMLPattern::badkey"], "InlineFormula"], ", and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

