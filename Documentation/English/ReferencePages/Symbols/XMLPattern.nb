Notebook[{

Cell[CellGroupData[{
Cell["XMLPattern", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", StyleBox["tag", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]is an XML pattern that represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", StyleBox["attrs", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]represents any ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " whose tag matches ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " and whose attribute map matches ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " is inert: it has no definitions and stays unevaluated. Only ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], " and the ", Cell[BoxData[StyleBox["\"Roles\"", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["\"Constructs\"", "TR"]], "InlineFormula"], " options of ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], " interpret it."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Position", BaseStyle -> "Link", ButtonData -> "paclet:ref/Position"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["ReplaceAll", BaseStyle -> "Link", ButtonData -> "paclet:ref/ReplaceAll"]], "InlineFormula"], " treat an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " as a literal expression, as ", Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], " treats a string pattern. To test one element, use ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"Everything written inside an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " is an ordinary Wolfram Language pattern, matched as ", Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], " would match it, with one exception at a list key, described below."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " may be a string, a ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " pair, an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of these, or any ordinary pattern matched against the tag, such as ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], ", ", Cell[BoxData["t_"], "InlineFormula"], " or ", Cell[BoxData["_?(StringMatchQ[\"h\" ~~ DigitCharacter])"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " is what ", Cell[BoxData[ButtonBox["KeyValuePattern", BaseStyle -> "Link", ButtonData -> "paclet:ref/KeyValuePattern"]], "InlineFormula"], " takes, and may have the following forms:

| form | description |
| --- | --- |
| ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " | an attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " whose value matches ", Cell[BoxData[StyleBox["val", "TI"]], "InlineFormula"], " |
| ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " | an attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], " with any value, equivalent to ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["_", "TR"]}]], "InlineFormula"], " |
| ", Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{StyleBox["ns", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}], "}"}]], "InlineFormula"], " | a namespaced attribute with any value |
| ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox[SubscriptBox["c", StyleBox["1", "TR"]], "TI"], ",", " ", StyleBox[SubscriptBox["c", StyleBox["2", "TR"]], "TI"], ",", " ", StyleBox["\[Ellipsis]", "TR"]}], "}"}]], "InlineFormula"], " | attributes matching each of the constraints ", Cell[BoxData[StyleBox[SubscriptBox["c", StyleBox["i", "TI"]], "TI"]], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{"The attribute constraints are matched as ", Cell[BoxData[ButtonBox["KeyValuePattern", BaseStyle -> "Link", ButtonData -> "paclet:ref/KeyValuePattern"]], "InlineFormula"], " matches them: in any order, and permitting attributes that no constraint mentions."}], "Notes"],

Cell[TextData[{"A list is always a list of constraints, so ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["ns", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " alone means the two bare keys ", Cell[BoxData[StyleBox["ns", "TI"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["name", "TI"]], "InlineFormula"], ". A bare namespaced key is written ", Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{StyleBox["ns", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}], "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " may be named or tested as a whole, as in ", Cell[BoxData["attrs : {\"id\" -> _}"], "InlineFormula"], " or ", Cell[BoxData["_?(Keys /* AnyTrue[StringStartsQ[\"data-\"]])"], "InlineFormula"], ". This is how a question about the whole attribute map is asked, such as whether some attribute name starts with ", Cell[BoxData["data-"], "InlineFormula"], ". The name or test sees the element's attribute map as it is in the tree."}], "Notes"],

Cell[TextData[{"Keys are literal: a string, a ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " pair, or an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of these, such as ", Cell[BoxData[RowBox[{RowBox[{"(", "\"href\" | \"src\"", ")"}], "\[Rule]", "url_"}]], "InlineFormula"], ". A key that is a pattern, such as ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], " or ", Cell[BoxData["_?StringQ"], "InlineFormula"], ", is refused."}], "Notes"],

Cell["Each key may be constrained at most once. Combine several constraints on one key into one value pattern.", "Notes"],

Cell[TextData[{"A value is any pattern, matched against the attribute's raw string value. ", Cell[BoxData[RowBox[{StyleBox["\"class\"", "TR"], "\[Rule]", StyleBox["\"lead\"", "TR"]}]], "InlineFormula"], " requires a ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " of exactly ", Cell[BoxData[StyleBox["\"lead\"", "TR"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A key with a reading in ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " also has a ", StyleBox["list key", FontWeight->"Bold"], ", under which its token list is reached. The built-in reading gives ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], ", the class list of ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], ": its value split on ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], ". An element with no ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], ", ", Cell[BoxData["class=\"\""], "InlineFormula"], " or a whitespace-only ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " has the class list ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"At a list key, a value is matched against the token list, so ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", RowBox[{"{", RowBox[{StyleBox["\"lead\"", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]}]], "InlineFormula"], " asks for a first class ", Cell[BoxData[StyleBox["lead", "TR"]], "InlineFormula"], ", and ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "c_"}]], "InlineFormula"], " binds the whole list."}], "Notes"],

Cell[TextData[{"At a list key, a literal string or an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of literal strings ", Cell[BoxData[StyleBox["s", "TI"]], "InlineFormula"], " means ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", StyleBox["s", "TI"], ",", " ", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], ": the list contains the token ", Cell[BoxData[StyleBox["s", "TI"]], "InlineFormula"], ". No other value is rewritten: ", Cell[BoxData[RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["\"ad\"", "TR"], "]"}]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], " and ", Cell[BoxData["_?(FreeQ[\"ad\"])"], "InlineFormula"], " keep their plain meaning. At an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " key, the rewriting applies only when every alternative is a list key."}], "Notes"],

Cell[TextData[{"A list pattern is positional. Questions about membership that ignore order are asked with list predicates such as ", Cell[BoxData[ButtonBox["MemberQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MemberQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["FreeQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/FreeQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsAll", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAll"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsAny", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAny"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsNone", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsNone"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsExactly", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsExactly"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["SubsetQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/SubsetQ"]], "InlineFormula"], ". The following table gives some CSS class selectors and their spellings:

| CSS | ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " |
| --- | --- |
| ", Cell[BoxData[".a"], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", StyleBox["\"a\"", "TR"]}]], "InlineFormula"], " |
| ", Cell[BoxData[".a.b"], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "_?(ContainsAll[{\"a\", \"b\"}])"}]], "InlineFormula"], " |
| ", Cell[BoxData[".a, .b"], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "\"a\" | \"b\""}]], "InlineFormula"], " |
| ", Cell[BoxData[":not(.a)"], "InlineFormula"], " | ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", "_?(FreeQ[\"a\"])"}]], "InlineFormula"], " |
| ", Cell[BoxData["[class]"], "InlineFormula"], " | ", Cell[BoxData[StyleBox["\"class\"", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData[":not([class])"], "InlineFormula"], " | ", Cell[BoxData["_?(FreeQ[\"class\" -> _])"], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{"The ", Cell[BoxData["Contains*"], "InlineFormula"], " functions compare with ", Cell[BoxData[ButtonBox["SameQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/SameQ"]], "InlineFormula"], " by default. With ", Cell[BoxData[RowBox[{ButtonBox["SameTest", BaseStyle -> "Link", ButtonData -> "paclet:ref/SameTest"], "\[Rule]", ButtonBox["StringMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringMatchQ"]}]], "InlineFormula"], ", they take string patterns, as in ", Cell[BoxData["_?(ContainsAll[{\"col-\" ~~ __}, SameTest -> StringMatchQ])"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A string pattern such as ", Cell[BoxData["\"col-\" ~~ __"], "InlineFormula"], " is never matched against a string by an ordinary pattern, and is refused wherever it is written. Write ", Cell[BoxData["_?(StringMatchQ[\"col-\" ~~ __])"], "InlineFormula"], " or ", Cell[BoxData["_?(StringStartsQ[\"col-\"])"], "InlineFormula"], " instead."}], "Notes"],

Cell[TextData[{"A name bound to the whole element, such as ", Cell[BoxData[StyleBox["e", "TR"]], "InlineFormula"], " in ", Cell[BoxData["e : XMLPattern[\"p\"]"], "InlineFormula"], ", always refers to the element as it is in the tree, without its list keys."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " takes no options. Readings are added for one query with the ", Cell[BoxData[StyleBox["\"AttributeReadings\"", "TR"]], "InlineFormula"], " option of the consuming function."}], "Notes"],

Cell[TextData[{"A malformed ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " is reported when a consuming function interprets it, not when it is written. The consuming function issues one of the messages ", Cell[BoxData["XMLPattern::badtag"], "InlineFormula"], ", ", Cell[BoxData["::badattrs"], "InlineFormula"], ", ", Cell[BoxData["::badkey"], "InlineFormula"], ", ", Cell[BoxData["::dupkey"], "InlineFormula"], ", ", Cell[BoxData["::nargs"], "InlineFormula"], " or ", Cell[BoxData["::strpat"], "InlineFormula"], " and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

