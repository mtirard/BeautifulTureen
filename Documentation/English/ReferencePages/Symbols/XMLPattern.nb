Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["An argument of the second bracket is a constraint, so an attribute key there issues a message:", "ExampleText"], Cell[BoxData[RowBox[{"XMLMatchQ", "[", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"input\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"type\"", "->", "\"text\""}], ",", RowBox[{"\"required\"", "->", "\"\""}]}], "}"}], ",", RowBox[{"{", "}"}]}], "]"}], ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"input\"", ",", RowBox[{"\"type\"", "->", "\"text\""}]}], "]"}], "[", "\"required\"", "]"}]}], "]"}]], "Input"],

Cell["XMLPattern::constraint: \"required\" is not a constraint. The arguments of XMLPattern after the attributes are constraints on what is below the element: a list pattern over its element children, as in {___, p, ___}, or Descendant[p] for an element anywhere below. Several attribute constraints go in one list: XMLPattern[tag, {c1, c2, ...}].", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["Give the attribute constraints as a list in the first bracket:", "ExampleText"],

Cell[BoxData["XMLMatchQ[XMLElement[\"input\",{\"type\"->\"text\",\"required\"->\"\"},{}],XMLPattern[\"input\",{\"type\"->\"text\",\"required\"}]]"], "Input"],

Cell[BoxData["True"], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell[TextData[{"A malformed ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " evaluates without a message:"}], "ExampleText"], Cell[BoxData["pattern=XMLPattern[\"p\",_->\"x\"]"], "Input"],

