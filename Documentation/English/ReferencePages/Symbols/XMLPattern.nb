Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A key cannot be a pattern:", "ExampleText"], Cell[BoxData["XMLMatchQ[XMLElement[\"div\",{\"data-id\"->\"7\"},{}],XMLPattern[\"div\",_?(StringStartsQ[\"data-\"])->_]]"], "Input"],

Cell["XMLPattern::badkey: An attribute key should be a string, a {namespace, name} pair of strings, or alternatives of these. Got _?(StringStartsQ[\"data-\"]). To test the keys, test the attributes as a whole: XMLPattern[tag, attrs_?test].", "Message", "MSG"],

