Cell[CellGroupData[{
Cell["HTMLClassList", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"], "[", StyleBox["element", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]gives the class list of the ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " ", Cell[BoxData[StyleBox["element", "TI"]], "InlineFormula"], ": the tokens of its ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute, in order."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " splits the value of the ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute on ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], ", a run of the five HTML ASCII whitespace characters, as a browser does. A no-break space or other Unicode whitespace is part of a token."}], "Notes"],

Cell[TextData[{"An element with no ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " attribute, with ", Cell[BoxData["class=\"\""], "InlineFormula"], ", or with a ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " of whitespace only gives ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], ". Whether the attribute is present is a separate question, asked with ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", StyleBox["\"class\"", "TR"]}], "]"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The tokens are given in the order they appear in the attribute value, with duplicates kept. The attribute value, which the DOM also stores, keeps its duplicates; only a browser's ", Cell[BoxData[StyleBox["classList", "TR"]], "InlineFormula"], " view removes them. ", Cell[BoxData[RowBox[{ButtonBox["DeleteDuplicates", BaseStyle -> "Link", ButtonData -> "paclet:ref/DeleteDuplicates"], "[", RowBox[{ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"], "[", StyleBox["element", "TI"], "]"}], "]"}]], "InlineFormula"], " gives that view."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"], "[", StyleBox["element", "TI"], "]"}]], "InlineFormula"], " is the list that the ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], " key of ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " matches against for the same element."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " always uses the built-in class reading, whatever ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " contains."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " takes a single ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ". For many elements, use ", Cell[BoxData["HTMLClassList /@ XMLCases[tree$, pattern$]"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A list, an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " document or a string is refused with the message ", Cell[BoxData["HTMLClassList::notelement"], "InlineFormula"], ", and ", Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

