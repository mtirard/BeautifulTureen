Cell[CellGroupData[{
Cell["Descendant", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]is a constraint on an element in an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", met when some element anywhere below it matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{StyleBox["p", "TI"], ",", StyleBox["levelspec", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]is met when some element at the depths in ", Cell[BoxData[StyleBox["levelspec", "TI"]], "InlineFormula"], " below the element matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], " is a ", StyleBox["constraint", FontWeight->"Bold"], ": a condition on what is below an element, given as an argument of the second bracket of ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or of ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], ". Elsewhere, such as the whole pattern or an entry of a list pattern, it gives a message."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern, a CSS selector for one element, or alternatives of these. Each can be named, have a condition or have a test. An ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or CSS selector in ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], " can have constraints of its own."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["levelspec", "TI"]], "InlineFormula"], " counts depth below the element that the constraint is on, with its children at depth 1, its grandchildren at depth 2, and so on. It has the following forms:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["form", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], StyleBox["n", "TI"], Cell[TextData[{"depths 1 to ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{"{", StyleBox["n", "TI"], "}"}], Cell[TextData[{"depth ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " only"}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{"{", RowBox[{StyleBox["m", "TI"], ",", StyleBox["n", "TI"]}], "}"}], Cell[TextData[{"depths ", Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula"], " to ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], ButtonBox["Infinity", BaseStyle -> "Link", ButtonData -> "paclet:ref/Infinity"], Cell["all depths, the default", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], " matches elements only, not text."}], "Notes"],

Cell[TextData[{"Several ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], " constraints on one element are independent, and one element below may meet several of them."}], "Notes"],

Cell[TextData[{"A name on the constraint, as in ", Cell[BoxData["path : Descendant[XMLPattern[\"a\"]]"], "InlineFormula"], ", is bound to the list of the elements strictly between the element and the match, outermost first, or ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " for a child. Under ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], ", the list holds every ancestor of the match."}], "Notes"],

Cell[TextData[{"A test on the constraint, as in ", Cell[BoxData["Descendant[XMLPattern[\"a\"]]?f"], "InlineFormula"], ", tests that list."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["Shortest", BaseStyle -> "Link", ButtonData -> "paclet:ref/Shortest"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Longest", BaseStyle -> "Link", ButtonData -> "paclet:ref/Longest"]], "InlineFormula"], " on the constraint pair each match with only one element that meets the whole pattern: the nearest or the outermost."}], "Notes"]
}, Open  ]],

