Cell["Give the constraints to the selector string:", "ExampleText"],

Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"menus", ",", RowBox[{RowBox[{"\"ul.menu, ol\"", "[", RowBox[{"{", RowBox[{RowBox[{"x", ":", "\"li\""}], ",", "___"}], "}"}], "]"}], ":>", RowBox[{"HTMLTextContent", "[", "x", "]"}]}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"Home\"", ",", "\"One\""}], "}"}]], "Output"]}, Open]]}, Open]],

