Cell[CellGroupData[{
Cell["FromCSSSelector", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", "\"\<\!\(\*StyleBox[\"selector\", \"TI\"]\)\>\"", "]"}]], "InlineFormula"], " \[LineSeparator]gives the XML pattern for a CSS selector that depends only on its element and what is below it, such as ", Cell[BoxData["\"a.note\""], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", RowBox[{StyleBox["n", "TI"], ":", "\"\<\!\(\*StyleBox[\"selector\", \"TI\"]\)\>\""}], "]"}]], "InlineFormula"], " \[LineSeparator]gives the pattern with the element that ", Cell[BoxData[StyleBox["selector", "TI"]], "InlineFormula"], " selects named ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], ", for any selector."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " gives an XML pattern for functions such as ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A CSS selector for one element depends only on its element and what is below it, such as ", Cell[BoxData["\"a.note\""], "InlineFormula"], " or ", Cell[BoxData["\"div:has(> table)\""], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " gives its pattern, named if the selector is named."}], "Notes"],

Cell[TextData[{"Other selectors depend on what is above or beside their element, such as ", Cell[BoxData["\"nav a\""], "InlineFormula"], " or ", Cell[BoxData["\"li:first-child\""], "InlineFormula"], ". Their pattern describes an element higher up, so the element they select needs a name: ", Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", "n : \"nav a\"", "]"}]], "InlineFormula"], " gives ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "\"nav\"", "]"}], "[", RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", "n : XMLPattern[\"a\"]", "]"}], "]"}]], "InlineFormula"], "."}], "Notes"],

Cell["A CSS selector string can be given directly wherever a pattern goes, and means its translation:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["where", "TableText"], FontSlant->"Italic"], StyleBox[Cell["selector for one element", "TableText"], FontSlant->"Italic"], StyleBox[Cell["other selector", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"the whole pattern of ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], ", etc."}], "TableText"], Cell["the elements it selects", "TableText"], Cell["the elements it selects", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"left of a rule, named, as in ", Cell[BoxData[RowBox[{"n : \"p a\"", "\[RuleDelayed]", StyleBox["n", "TR"]}]], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["n", "TR"]], "InlineFormula"], " is the selected element"}], "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["n", "TR"]], "InlineFormula"], " is the selected element"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"left of a rule, unnamed, as in ", Cell[BoxData[RowBox[{"\"a\"", "\[RuleDelayed]", StyleBox["1", "TR"]}]], "InlineFormula"]}], "TableText"], Cell["the pattern, unnamed; name it to use the element on the right-hand side", "TableText"], Cell["not accepted", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"a key in ", Cell[BoxData["\"Roles\""], "InlineFormula"], " or ", Cell[BoxData["\"Constructs\""], "InlineFormula"]}], "TableText"], Cell["a test of each element", "TableText"], Cell["each element it selects in the tree", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFreeQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFreeQ"]], "InlineFormula"], ", a list entry, ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"]}], "TableText"], Cell["a test of the element", "TableText"], Cell["not accepted", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"with constraints, as in ", Cell[BoxData["\"ul\"[Child[\"li\"]]"], "InlineFormula"]}], "TableText"], Cell[TextData[{"the pattern with the constraints added to each ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " in it"}], "TableText"], Cell["not accepted", "TableText"]}
}]], "3ColumnTableMod"],

Cell["The selector is matched as written against the imported tree, so letter case matters in tag names, attribute names and attribute values.", "Notes"],

Cell["The following parts of a selector are translated:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["selector", "TableText"], FontSlant->"Italic"], StyleBox[Cell["elements described", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], ", ", Cell[BoxData["*"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements with the tag ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], ", or any element"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[".c"], "InlineFormula"], ", ", Cell[BoxData[StyleBox["#x", "TR"]], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements with the class ", Cell[BoxData[StyleBox["c", "TR"]], "InlineFormula"], ", or with the id ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["[a]"], "InlineFormula"], ", ", Cell[BoxData["[a=v]"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements with the attribute ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], ", or with ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " equal to ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "[a~=v]", Cell[TextData[{"elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], ", split at whitespace, holds the token ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "[a|=v]", Cell[TextData[{"elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " is ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"], " or starts with ", Cell[BoxData["v-"], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["[a^=v]"], "InlineFormula"], ", ", Cell[BoxData["[a$=v]"], "InlineFormula"], ", ", Cell[BoxData["[a*=v]"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " starts with, ends with or contains ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["[a=v i]"], "InlineFormula"], ", ", Cell[BoxData["[a=v s]"], "InlineFormula"]}], "TableText"], Cell["the same, with the letters A to Z matched in either case, or as written", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["E F"], "InlineFormula"], ", ", Cell[BoxData["E > F"], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[ButtonBox["F", BaseStyle -> "Link", ButtonData -> "paclet:ref/F"]], "InlineFormula"], " elements inside an ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], " element, or children of one"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["E + F"], "InlineFormula"], ", ", Cell[BoxData["E ~ F"], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[ButtonBox["F", BaseStyle -> "Link", ButtonData -> "paclet:ref/F"]], "InlineFormula"], " elements right after an ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], " sibling, or after one"}], "TableText"]},
{Cell["      ", "ModInfo"], ":not(s$1, s$2, $$)", Cell[TextData[{"elements that match none of the ", Cell[BoxData[SubscriptBox[StyleBox["s", "TI"], StyleBox["i", "TI"]]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":is(s$1, s$2, $$)"], "InlineFormula"], ", ", Cell[BoxData[":where(s$1, s$2, $$)"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements that match any of the ", Cell[BoxData[SubscriptBox[StyleBox["s", "TI"], StyleBox["i", "TI"]]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], ":has(r$1, r$2, $$)", Cell[TextData[{"elements with a descendant that an ", Cell[BoxData[SubscriptBox[StyleBox["r", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], " describes, a child for ", Cell[BoxData[">"], "InlineFormula"], ", or a later sibling for ", Cell[BoxData["+"], "InlineFormula"], " and ", Cell[BoxData["~"], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], ":empty", Cell["elements with no element and no text other than whitespace", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":link"], "InlineFormula"], ", ", Cell[BoxData[":any-link"], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["area", "TR"]], "InlineFormula"], " elements with an ", Cell[BoxData[StyleBox["href", "TR"]], "InlineFormula"], " attribute"}], "TableText"]},
{Cell["      ", "ModInfo"], ":checked", Cell["checked checkboxes and radio buttons, and selected options", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":first-child"], "InlineFormula"], ", ", Cell[BoxData[":last-child"], "InlineFormula"], ", ", Cell[BoxData[":only-child"], "InlineFormula"]}], "TableText"], Cell["elements that are the first, the last or the only element child of their parent", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":nth-child(An+B)"], "InlineFormula"], ", ", Cell[BoxData[":nth-last-child(An+B)"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements at a position An+B among the element children of their parent, for some n \[GreaterEqual] 0, counted from the first or from the last; with ", Cell[BoxData[StyleBox["of", "TR"]], "InlineFormula"], " and selectors ", Cell[BoxData[SubscriptBox[StyleBox["s", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], ", among the children that match one of the ", Cell[BoxData[SubscriptBox[StyleBox["s", "TI"], StyleBox["i", "TI"]]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":first-of-type"], "InlineFormula"], ", ", Cell[BoxData[":last-of-type"], "InlineFormula"], ", ", Cell[BoxData[":only-of-type"], "InlineFormula"], ", ", Cell[BoxData[":nth-of-type(An+B)"], "InlineFormula"], ", ", Cell[BoxData[":nth-last-of-type(An+B)"], "InlineFormula"]}], "TableText"], Cell["the same, among the children with the element's tag", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":root"], "InlineFormula"], ", ", Cell[BoxData[":scope"], "InlineFormula"]}], "TableText"], Cell["the top-level element of the tree, when there is only one", "TableText"]},
{Cell["      ", "ModInfo"], "s$1, s$2, $$", Cell["elements that any of the selectors describes", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"The arguments of ", Cell[BoxData[":not"], "InlineFormula"], ", ", Cell[BoxData[":is"], "InlineFormula"], " and ", Cell[BoxData[":where"], "InlineFormula"], " can hold descendant and ", Cell[BoxData[">"], "InlineFormula"], " combinators. ", Cell[BoxData["+"], "InlineFormula"], " and ", Cell[BoxData["~"], "InlineFormula"], " inside them are not translated, and nor are ", Cell[BoxData[":not(:has(+ $$))"], "InlineFormula"], " and ", Cell[BoxData[":not(:has(~ $$))"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData["[a~=v]"], "InlineFormula"], " works for ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " by default. For another attribute, add an entry to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], ", or give one with the ", Cell[BoxData["\"AttributeReadings\""], "InlineFormula"], " option."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " for a string that is not a valid CSS selector, for a valid selector that it cannot translate, such as ", Cell[BoxData[":lang(fr)"], "InlineFormula"], ", and for one that only a browser can match, such as ", Cell[BoxData[":hover"], "InlineFormula"], "."}], "Notes"]
