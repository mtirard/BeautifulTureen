Notebook[{

Cell[CellGroupData[{
Cell["FromCSSSelector", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/FromCSSSelector"], "[", "\"\<\!\(\*StyleBox[\"selector\", \"TI\"]\)\>\"", "]"}]], "InlineFormula"], " \[LineSeparator]gives the XML pattern that the CSS selector ", Cell[BoxData[StyleBox["selector", "TI"]], "InlineFormula"], " describes."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/FromCSSSelector"]], "InlineFormula"], " gives an ordinary XML pattern, for ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], ", or as a stage of ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A CSS selector string can be given directly wherever these take a pattern, including the left-hand side of a rule and of a rule in the ", Cell[BoxData[StyleBox["\"Roles\"", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["\"Constructs\"", "TR"]], "InlineFormula"], " options of ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], ". It means its translation."}], "Notes"],

Cell[TextData[{"The selector is matched as written, against the tree the importer gives: letter case matters in tag names, attribute names and attribute values, and attributes that the importer adds, such as ", Cell[BoxData["rowspan=\"1\""], "InlineFormula"], ", count as present."}], "Notes"],

Cell[TextData[{"The following parts of a selector are translated:

| selector | elements described |
| --- | --- |
| ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], ", ", Cell[BoxData["*"], "InlineFormula"], " | elements with the tag ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], ", or any element |
| ", Cell[BoxData[".c"], "InlineFormula"], ", ", Cell[BoxData[StyleBox["#x", "TR"]], "InlineFormula"], " | elements with the class ", Cell[BoxData[StyleBox["c", "TR"]], "InlineFormula"], ", or with the id ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData["[a]"], "InlineFormula"], ", ", Cell[BoxData["[a=v]"], "InlineFormula"], " | elements with the attribute ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], ", or with ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " equal to ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData["[a~=v]"], "InlineFormula"], " | elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " holds the token ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"], ", tested with the list key ", Cell[BoxData[StyleBox["\"aList\"", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData["[a|=v]"], "InlineFormula"], " | elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " is ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"], " or starts with ", Cell[BoxData["v-"], "InlineFormula"], " |
| ", Cell[BoxData["[a^=v]"], "InlineFormula"], ", ", Cell[BoxData["[a$=v]"], "InlineFormula"], ", ", Cell[BoxData["[a*=v]"], "InlineFormula"], " | elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " starts with, ends with or contains ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData["[a=v i]"], "InlineFormula"], ", ", Cell[BoxData["[a=v s]"], "InlineFormula"], " | the same, with the letters A to Z matched in either case, or as written |
| ", Cell[BoxData["E F"], "InlineFormula"], ", ", Cell[BoxData["E > F"], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["F", BaseStyle -> "Link", ButtonData -> "paclet:ref/F"]], "InlineFormula"], " elements inside an ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], " element, or children of one, as ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], " give |
| ", Cell[BoxData["E + F"], "InlineFormula"], ", ", Cell[BoxData["E ~ F"], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["F", BaseStyle -> "Link", ButtonData -> "paclet:ref/F"]], "InlineFormula"], " elements right after an ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], " sibling, or after one, as ", Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineFormula"], " give |
| ", Cell[BoxData[":not(s$1, s$2, $$)"], "InlineFormula"], " | elements that match none of the ", Cell[BoxData[StyleBox[SubscriptBox["s", StyleBox["i", "TI"]], "TI"]], "InlineFormula"], " |
| ", Cell[BoxData[":is(s$1, s$2, $$)"], "InlineFormula"], ", ", Cell[BoxData[":where(s$1, s$2, $$)"], "InlineFormula"], " | elements that match any of the ", Cell[BoxData[StyleBox[SubscriptBox["s", StyleBox["i", "TI"]], "TI"]], "InlineFormula"], " |
| ", Cell[BoxData[":has(r$1, r$2, $$)"], "InlineFormula"], " | elements with a descendant that an ", Cell[BoxData[StyleBox[SubscriptBox["r", StyleBox["i", "TI"]], "TI"]], "InlineFormula"], " describes, or a child for an ", Cell[BoxData[StyleBox[SubscriptBox["r", StyleBox["i", "TI"]], "TI"]], "InlineFormula"], " that starts with ", Cell[BoxData[">"], "InlineFormula"], " |
| ", Cell[BoxData[":empty"], "InlineFormula"], " | elements with no element and no text other than whitespace |
| ", Cell[BoxData[":link"], "InlineFormula"], ", ", Cell[BoxData[":any-link"], "InlineFormula"], " | ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["area", "TR"]], "InlineFormula"], " elements with an ", Cell[BoxData[StyleBox["href", "TR"]], "InlineFormula"], " attribute |
| ", Cell[BoxData[":checked"], "InlineFormula"], " | checked checkboxes and radio buttons, and selected options |
| ", Cell[BoxData[":only-child"], "InlineFormula"], ", ", Cell[BoxData[":only-of-type"], "InlineFormula"], " | elements with no element sibling, or with none of the same tag |
| ", Cell[BoxData["s$1, s$2, $$"], "InlineFormula"], " | elements that any of the selectors describes |"}], "Notes"],

Cell[TextData[{"The arguments of ", Cell[BoxData[":not"], "InlineFormula"], ", ", Cell[BoxData[":is"], "InlineFormula"], " and ", Cell[BoxData[":where"], "InlineFormula"], " must be selectors with no combinator. Each argument of ", Cell[BoxData[":has"], "InlineFormula"], " starts with a descendant combinator or ", Cell[BoxData[">"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[":only-child"], "InlineFormula"], " and ", Cell[BoxData[":only-of-type"], "InlineFormula"], " can be used in the first part of a selector or after ", Cell[BoxData[">"], "InlineFormula"], ". A list of selectors is translated when they have the same combinators and differ in one part."}], "Notes"],

Cell[TextData[{Cell[BoxData["[a~=v]"], "InlineFormula"], " needs a reading for ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], ", given with ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " or with the ", Cell[BoxData[StyleBox["\"AttributeReadings\"", "TR"]], "InlineFormula"], " option of the function that runs the query. The reading for ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " is in ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " by default."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/FromCSSSelector"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " for a string that is not a valid CSS selector, for a valid selector that it cannot translate, such as ", Cell[BoxData[":root"], "InlineFormula"], " or ", Cell[BoxData[":nth-child(2)"], "InlineFormula"], ", and for one that only a browser can match, such as ", Cell[BoxData[":hover"], "InlineFormula"], " or ", Cell[BoxData["::before"], "InlineFormula"], ". The message names a workaround where there is one."}], "Notes"]
}, Open  ]],

