Cell[CellGroupData[{
Cell["FromCSSSelector", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", "\"\<\!\(\*StyleBox[\"selector\", \"TI\"]\)\>\"", "]"}]], "InlineFormula"], " \[LineSeparator]gives the XML pattern that the CSS selector ", Cell[BoxData[StyleBox["selector", "TI"]], "InlineFormula"], " describes, when the selector looks only at the element it selects and below it.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", "n$ : \"selector$\"", "]"}]], "InlineFormula"], " \[LineSeparator]gives the pattern with the element that ", Cell[BoxData[StyleBox["selector", "TI"]], "InlineFormula"], " selects named ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], ", for any selector."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " gives an ordinary XML pattern, for ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFirstCase"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLFreeQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFreeQ"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A ", StyleBox["one-element selector", FontWeight->"Bold"], " looks only at the element it selects and below it, as ", Cell[BoxData["\"a.note\""], "InlineFormula"], " and ", Cell[BoxData["\"div:has(> table)\""], "InlineFormula"], " do. ", Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", "\"\<\!\(\*StyleBox[\"selector\", \"TI\"]\)\>\"", "]"}]], "InlineFormula"], " gives its pattern, and ", Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", "n : \"selector$\"", "]"}]], "InlineFormula"], " gives ", Cell[BoxData["n : pattern$"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"Any other selector matches its element by what is above or beside it, as ", Cell[BoxData["\"nav a\""], "InlineFormula"], " and ", Cell[BoxData["\"li:first-child\""], "InlineFormula"], " do. Its pattern is rooted higher up, so the element it selects needs a name: ", Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", "n : \"nav a\"", "]"}]], "InlineFormula"], " gives ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "\"nav\"", "]"}], "[", RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", "n : XMLPattern[\"a\"]", "]"}], "]"}]], "InlineFormula"], ". ", Cell[BoxData[RowBox[{ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"], "[", "\"nav a\"", "]"}]], "InlineFormula"], " gives ", Cell[BoxData["FromCSSSelector::name"], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The pattern is rooted at the first part of the selector. A parent that can be the document is written ", Cell[BoxData[RowBox[{ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"], "[", RowBox[{RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["_", "TR"], "]"}], "[", StyleBox["l", "TI"], "]"}], ",", RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", StyleBox["l", "TI"], "]"}]}], "]"}]], "InlineFormula"], ", and ", Cell[BoxData[":root"], "InlineFormula"], " and ", Cell[BoxData[":scope"], "InlineFormula"], " are rooted at ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], "."}], "Notes"],

Cell["A CSS selector string can be given directly wherever a pattern goes, and means its translation:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["where", "TableText"], FontSlant->"Italic"], StyleBox[Cell["one-element selector", "TableText"], FontSlant->"Italic"], StyleBox[Cell["other selector", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"the whole query of ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], ", etc."}], "TableText"], Cell["the elements it selects", "TableText"], Cell["the elements it selects", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"left of a rule, ", Cell[BoxData[RowBox[{"n : \"selector$\"", "\[RuleDelayed]", StyleBox["rhs", "TI"]}]], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["n", "TR"]], "InlineFormula"], " is the element"}], "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["n", "TR"]], "InlineFormula"], " is the selected element"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"left of a rule, ", Cell[BoxData[RowBox[{"\"\<\!\(\*StyleBox[\"selector\", \"TI\"]\)\>\"", "\[RuleDelayed]", StyleBox["rhs", "TI"]}]], "InlineFormula"]}], "TableText"], Cell["the element is the pattern root", "TableText"], Cell["not accepted", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"a key in ", Cell[BoxData["\"Roles\""], "InlineFormula"], " or ", Cell[BoxData["\"Constructs\""], "InlineFormula"]}], "TableText"], Cell["a test of each element", "TableText"], Cell["a query over the whole tree", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFreeQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFreeQ"]], "InlineFormula"], ", a list entry, ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"]}], "TableText"], Cell["a test of the element", "TableText"], Cell["not accepted", "TableText"]}
}]], "3ColumnTableMod"],

Cell[TextData[{"A selector list such as ", Cell[BoxData["\"h2, h3 > p\""], "InlineFormula"], " gives alternatives that share the name of the selected element. Each element it selects is given once, in document order."}], "Notes"],

Cell[TextData[{"The selector is matched as written, against the tree the importer gives: letter case matters in tag names, attribute names and attribute values, and attributes that the importer adds, such as ", Cell[BoxData["rowspan=\"1\""], "InlineFormula"], ", count as present."}], "Notes"],

Cell["The following parts of a selector are translated:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["selector", "TableText"], FontSlant->"Italic"], StyleBox[Cell["elements described", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], ", ", Cell[BoxData["*"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements with the tag ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], ", or any element"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[".c"], "InlineFormula"], ", ", Cell[BoxData[StyleBox["#x", "TR"]], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements with the class ", Cell[BoxData[StyleBox["c", "TR"]], "InlineFormula"], ", or with the id ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["[a]"], "InlineFormula"], ", ", Cell[BoxData["[a=v]"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements with the attribute ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], ", or with ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " equal to ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "[a~=v]", Cell[TextData[{"elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " holds the token ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"], ", tested with the list key ", Cell[BoxData["\"aList\""], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "[a|=v]", Cell[TextData[{"elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " is ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"], " or starts with ", Cell[BoxData["v-"], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["[a^=v]"], "InlineFormula"], ", ", Cell[BoxData["[a$=v]"], "InlineFormula"], ", ", Cell[BoxData["[a*=v]"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements whose ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " starts with, ends with or contains ", Cell[BoxData[StyleBox["v", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["[a=v i]"], "InlineFormula"], ", ", Cell[BoxData["[a=v s]"], "InlineFormula"]}], "TableText"], Cell["the same, with the letters A to Z matched in either case, or as written", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["E F"], "InlineFormula"], ", ", Cell[BoxData["E > F"], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[ButtonBox["F", BaseStyle -> "Link", ButtonData -> "paclet:ref/F"]], "InlineFormula"], " elements inside an ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], " element, or children of one"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData["E + F"], "InlineFormula"], ", ", Cell[BoxData["E ~ F"], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[ButtonBox["F", BaseStyle -> "Link", ButtonData -> "paclet:ref/F"]], "InlineFormula"], " elements right after an ", Cell[BoxData[ButtonBox["E", BaseStyle -> "Link", ButtonData -> "paclet:ref/E"]], "InlineFormula"], " sibling, or after one"}], "TableText"]},
{Cell["      ", "ModInfo"], ":not(s$1, s$2, $$)", Cell[TextData[{"elements that match none of the ", Cell[BoxData[SubscriptBox[StyleBox["s", "TI"], StyleBox["i", "TI"]]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":is(s$1, s$2, $$)"], "InlineFormula"], ", ", Cell[BoxData[":where(s$1, s$2, $$)"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements that match any of the ", Cell[BoxData[SubscriptBox[StyleBox["s", "TI"], StyleBox["i", "TI"]]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], ":has(r$1, r$2, $$)", Cell[TextData[{"elements with a descendant that an ", Cell[BoxData[SubscriptBox[StyleBox["r", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], " describes, a child for ", Cell[BoxData[">"], "InlineFormula"], ", or a later sibling for ", Cell[BoxData["+"], "InlineFormula"], " and ", Cell[BoxData["~"], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], ":empty", Cell["elements with no element and no text other than whitespace", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":link"], "InlineFormula"], ", ", Cell[BoxData[":any-link"], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["area", "TR"]], "InlineFormula"], " elements with an ", Cell[BoxData[StyleBox["href", "TR"]], "InlineFormula"], " attribute"}], "TableText"]},
{Cell["      ", "ModInfo"], ":checked", Cell["checked checkboxes and radio buttons, and selected options", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":first-child"], "InlineFormula"], ", ", Cell[BoxData[":last-child"], "InlineFormula"], ", ", Cell[BoxData[":only-child"], "InlineFormula"]}], "TableText"], Cell["elements that are the first, the last or the only element child of their parent", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":nth-child(An+B)"], "InlineFormula"], ", ", Cell[BoxData[":nth-last-child(An+B)"], "InlineFormula"]}], "TableText"], Cell[TextData[{"elements at a position a k + b among the element children of their parent, for some k \[GreaterEqual] 0, counted from the first or from the last; with ", Cell[BoxData["of s$1, s$2, $$"], "InlineFormula"], ", among the children that match one of the ", Cell[BoxData[SubscriptBox[StyleBox["s", "TI"], StyleBox["i", "TI"]]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":first-of-type"], "InlineFormula"], ", ", Cell[BoxData[":last-of-type"], "InlineFormula"], ", ", Cell[BoxData[":only-of-type"], "InlineFormula"], ", ", Cell[BoxData[":nth-of-type(An+B)"], "InlineFormula"], ", ", Cell[BoxData[":nth-last-of-type(An+B)"], "InlineFormula"]}], "TableText"], Cell["the same, among the children with the element's tag", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{Cell[BoxData[":root"], "InlineFormula"], ", ", Cell[BoxData[":scope"], "InlineFormula"]}], "TableText"], Cell["the top element of the tree, when there is only one", "TableText"]},
{Cell["      ", "ModInfo"], "s$1, s$2, $$", Cell["elements that any of the selectors describes", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"The arguments of ", Cell[BoxData[":not"], "InlineFormula"], ", ", Cell[BoxData[":is"], "InlineFormula"], " and ", Cell[BoxData[":where"], "InlineFormula"], " can hold descendant and ", Cell[BoxData[">"], "InlineFormula"], " combinators. ", Cell[BoxData["+"], "InlineFormula"], " and ", Cell[BoxData["~"], "InlineFormula"], " inside them are not translated, and nor are ", Cell[BoxData[":not(:has(+ $$))"], "InlineFormula"], " and ", Cell[BoxData[":not(:has(~ $$))"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData["[a~=v]"], "InlineFormula"], " needs a reading for ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " unless ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " is ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], ": the reading for ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " is in ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " by default. Give it with ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " or with the ", Cell[BoxData["\"AttributeReadings\""], "InlineFormula"], " option of the function that runs the query."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " for a string that is not a valid CSS selector, for a valid selector that it cannot translate, such as ", Cell[BoxData[":lang(fr)"], "InlineFormula"], ", and for one that only a browser can match, such as ", Cell[BoxData[":hover"], "InlineFormula"], "."}], "Notes"]
