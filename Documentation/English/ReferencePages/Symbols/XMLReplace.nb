Cell[CellGroupData[{
Cell["XMLReplace", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", RowBox[{"{", RowBox[{RowBox[{StyleBox["x", "TI"], "\[Rule]", StyleBox["new", "TI"]}], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]replaces what each name ", Cell[BoxData[StyleBox["x", "TI"]], "InlineFormula"], " of ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches by ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], ", for every result of ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", and gives the rewritten tree.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["new", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]replaces each match of ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " by ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{"{", RowBox[{SubscriptBox[StyleBox["rule", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["rule", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives each place the replacement of the first rule that names it."}], "Usage"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", RowBox[{"{", RowBox[{RowBox[{StyleBox["x", "TR"], "\[Rule]", StyleBox["new", "TI"]}], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}]}], "]"}]], "InlineFormula"], " replaces the places that the names ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"], ", etc. match, for every result of ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ". Only the names on the left of the rules count the results; names used only in ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], " are tests."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["new", "TI"]}]}], "]"}]], "InlineFormula"], ", with any other right-hand side, replaces each element that the pattern root of ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches, as ", Cell[BoxData[ButtonBox["Replace", BaseStyle -> "Link", ButtonData -> "paclet:ref/Replace"]], "InlineFormula"], " does."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", or a list of ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " objects. ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " can have the same forms as in ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{"{", RowBox[{SubscriptBox[StyleBox["rule", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["rule", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " gives each place the replacement of the first rule that names it."}], "Notes"],

Cell["A replacement must be of the kind that its place takes:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["place", "TableText"], FontSlant->"Italic"], StyleBox[Cell["replacement", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell["an element", "TableText"], Cell[TextData[{"an element, a string, ", Cell[BoxData[RowBox[{ButtonBox["Splice", BaseStyle -> "Link", ButtonData -> "paclet:ref/Splice"], "[", StyleBox["list", "TI"], "]"}]], "InlineFormula"], ", or ", Cell[BoxData[ButtonBox["Nothing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Nothing"]], "InlineFormula"], " to remove it"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["a tag", "TableText"], Cell["a string", "TableText"]},
{Cell["      ", "ModInfo"], Cell["the attribute list", "TableText"], Cell["a list of rules", "TableText"]},
{Cell["      ", "ModInfo"], Cell["an attribute value", "TableText"], Cell[TextData[{"a string, or ", Cell[BoxData[ButtonBox["Nothing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Nothing"]], "InlineFormula"], " to remove the attribute"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"a list key, such as ", Cell[BoxData["\"classList\""], "InlineFormula"]}], "TableText"], Cell["a list of strings", "TableText"]},
{Cell["      ", "ModInfo"], Cell["a token of a list key", "TableText"], Cell["a string", "TableText"]},
{Cell["      ", "ModInfo"], Cell["a run of tokens", "TableText"], Cell["a list of strings", "TableText"]},
{Cell["      ", "ModInfo"], Cell["the contents of an element", "TableText"], Cell["a list of nodes", "TableText"]},
{Cell["      ", "ModInfo"], Cell["a run of element children", "TableText"], Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["Splice", BaseStyle -> "Link", ButtonData -> "paclet:ref/Splice"], "[", StyleBox["list", "TI"], "]"}]], "InlineFormula"], ", a list, or ", Cell[BoxData[ButtonBox["Nothing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Nothing"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["the empty place between children", "TableText"], Cell["the nodes to insert", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"A replacement of the wrong kind gives ", Cell[BoxData["XMLReplace::kind"], "InlineFormula"], ", and that place is left unchanged. The other replacements are made."}], "Notes"],

Cell[TextData[{"Every place is found in the original ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ". The replacements are then made inside out: the contents of an element before the element, and later places before earlier ones."}], "Notes"],

Cell[TextData[{"Each ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], " is evaluated when its place is replaced, and the names it uses have their values in the tree as rewritten so far. So a rule for an element sees the replacements already made inside it."}], "Notes"],

Cell[TextData[{"When a place gets different replacements from different results, the first result wins, with ", Cell[BoxData["XMLReplace::conflict"], "InlineFormula"], ". When a name's place was removed by an earlier replacement, the name keeps its original value, with ", Cell[BoxData["XMLReplace::stale"], "InlineFormula"], "."}], "Notes"],

Cell["The document, and a named path, cannot be replaced.", "Notes"],

Cell[TextData[{"A bare pattern, with no replacement, gives ", Cell[BoxData["XMLReplace::bare"], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"],

Cell["The following option can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "\"AttributeReadings\"", StyleBox["<||>", "TR"], Cell[TextData[{"entries to add to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " for this call, as in ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"]
