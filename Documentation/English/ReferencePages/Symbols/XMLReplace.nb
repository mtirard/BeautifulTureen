Cell[CellGroupData[{
Cell["XMLReplace", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["new", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]replaces each element that ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches, at any depth, by ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", RowBox[{"{", RowBox[{RowBox[{StyleBox["x", "TI"], "\[Rule]", StyleBox["new", "TI"]}], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]replaces, for every match of ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", the part that each name ", Cell[BoxData[StyleBox["x", "TI"]], "InlineFormula"], " is bound to by its ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{"{", RowBox[{SubscriptBox[StyleBox["rule", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["rule", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}], "]"}]], "InlineFormula"], " \[LineSeparator]tries the rules in order, and replaces each part by the first rule that matches it."}], "Usage"],

Cell[TextData[{"With ", Cell[BoxData[RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["new", "TI"]}]], "InlineFormula"], ", each element that ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches is replaced by ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], ", unless ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], " is a list of rules for names in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"With ", Cell[BoxData[RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", RowBox[{"{", RowBox[{RowBox[{StyleBox["x", "TI"], "\[Rule]", StyleBox["new", "TI"]}], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}]], "InlineFormula"], ", only the parts bound to the names on the left of the rules are replaced. A name used only in ", Cell[BoxData[StyleBox["new", "TI"]], "InlineFormula"], " must match, but adds no replacements."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", or a list of elements and strings."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " can have any of the forms that ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " takes, such as an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or a CSS selector string."}], "Notes"],

Cell[TextData[{"A ", StyleBox["list key", FontWeight->"Bold"], " is a key such as ", Cell[BoxData["\"classList\""], "InlineFormula"], ", whose value is a list of tokens taken from an attribute."}], "Notes"],

Cell["A replacement must be of a kind that suits what the name is bound to:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["name for", "TableText"], FontSlant->"Italic"], StyleBox[Cell["replacement", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell["an element", "TableText"], Cell[TextData[{"an element, a string, ", Cell[BoxData[RowBox[{ButtonBox["Splice", BaseStyle -> "Link", ButtonData -> "paclet:ref/Splice"], "[", StyleBox["list", "TI"], "]"}]], "InlineFormula"], ", or ", Cell[BoxData[ButtonBox["Nothing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Nothing"]], "InlineFormula"], " to remove it"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["a tag", "TableText"], Cell["a string", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"a run of element children, such as ", Cell[BoxData["run___"], "InlineFormula"]}], "TableText"], Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["Splice", BaseStyle -> "Link", ButtonData -> "paclet:ref/Splice"], "[", StyleBox["list", "TI"], "]"}]], "InlineFormula"], ", a list, or ", Cell[BoxData[ButtonBox["Nothing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Nothing"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["a gap between children", "TableText"], Cell["the nodes to insert", "TableText"]},
{Cell["      ", "ModInfo"], Cell["the attribute list", "TableText"], Cell["a list of rules", "TableText"]},
{Cell["      ", "ModInfo"], Cell["an attribute value", "TableText"], Cell[TextData[{"a string, or ", Cell[BoxData[ButtonBox["Nothing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Nothing"]], "InlineFormula"], " to remove the attribute"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["the tokens of a list key", "TableText"], Cell["a list of strings", "TableText"]},
{Cell["      ", "ModInfo"], Cell["one token of a list key", "TableText"], Cell["a string", "TableText"]},
{Cell["      ", "ModInfo"], Cell["a run of tokens of a list key", "TableText"], Cell["a list of strings", "TableText"]},
{Cell["      ", "ModInfo"], Cell["the contents of an element", "TableText"], Cell["a list of nodes", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"Matches are found in the original ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", and replacements are made from the inside out. A name for an element is bound to the element with the replacements inside it already made."}], "Notes"],

Cell[TextData[{"When ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " is an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", it is never itself replaced."}], "Notes"],

Cell[TextData[{"The document, and a name on a ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], " constraint, as in ", Cell[BoxData["path : Descendant[XMLPattern[\"a\"]]"], "InlineFormula"], ", cannot be replaced, and give a message."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " when ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " has none of the forms above, when the second argument is a pattern with no replacement, when an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is malformed, or when a name to be replaced has no position, such as a name for text."}], "Notes"],

Cell["The following option can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "\"AttributeReadings\"", StyleBox["<||>", "TR"], Cell[TextData[{"attributes to split into lists of tokens for this call, in addition to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"]
