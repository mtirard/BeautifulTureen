Notebook[{

Cell[CellGroupData[{
Cell["$AttributeReadings", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " \[LineSeparator]is an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " that gives, for each attribute it names, how the attribute value is split into a list of tokens and the list key that gives that list in ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{"Each entry of ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " is called a ", StyleBox["reading", FontSlant->"Italic"], ". With a reading, the value of an attribute is split into a list of tokens, which ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " matches under a new key, called a ", StyleBox["list key", FontSlant->"Italic"], "."}], "Notes"],

Cell[TextData[{"By default, only ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " has a reading, with the list key ", Cell[BoxData["\"classList\""], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The option ", Cell[BoxData[RowBox[{"\"AttributeReadings\"", "\[Rule]", StyleBox["readings", "TI"]}]], "InlineFormula"], ", which ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]], "InlineFormula"], " and most other functions of this paclet take, adds ", Cell[BoxData[StyleBox["readings", "TI"]], "InlineFormula"], " for one call. It is the same as ", Cell[BoxData[RowBox[{ButtonBox["Block", BaseStyle -> "Link", ButtonData -> "paclet:ref/Block"], "[", RowBox[{RowBox[{"{", RowBox[{ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"], "=", RowBox[{ButtonBox["Join", BaseStyle -> "Link", ButtonData -> "paclet:ref/Join"], "[", RowBox[{ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"], ",", StyleBox["readings", "TI"]}], "]"}]}], "}"}], ",", StyleBox["call", "TI"]}], "]"}]], "InlineFormula"], ", so an entry for an attribute that already has a reading replaces that reading whole, and the readings hold for the whole call, including an ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFirstCase"]], "InlineFormula"], " in a condition or a rule body, and any function called from one."}], "Notes"],

Cell[TextData[{"Assigning to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " changes the readings for all later calls."}], "Notes"],

Cell[TextData[{"Each key is an attribute name given as a string. A namespaced attribute ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " cannot have a reading. Each value is an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " with any of the following fields:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["field", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"], "\"SpaceSeparated\"", Cell[TextData[{"how the value is split: ", Cell[BoxData["\"SpaceSeparated\""], "InlineFormula"], " or ", Cell[BoxData["\"CommaSeparated\""], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell["a string pattern to split the value on", "TableText"]},
{Cell["      ", "ModInfo"], "\"TrimWhitespace\"", ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"whether to trim HTML whitespace from each token: ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "\"ListKey\"", ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"the list key, a string; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " gives the attribute name followed by ", Cell[BoxData["\"List\""], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"],

Cell[TextData[{Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " sets the defaults of ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " and ", Cell[BoxData["\"TrimWhitespace\""], "InlineFormula"], ":"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], "\"SpaceSeparated\"", ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLWhitespace"], ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]},
{Cell["      ", "ModInfo"], "\"CommaSeparated\"", "\",\"", ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]}
}]], "3ColumnTableMod"],

Cell[TextData[{"An explicit ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " or ", Cell[BoxData["\"TrimWhitespace\""], "InlineFormula"], " setting overrides the one from ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A list key matches as ", Cell[BoxData["\"classList\""], "InlineFormula"], " does. With a reading for ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], ", ", Cell[BoxData[RowBox[{"\"relList\"", "\[Rule]", "\"nofollow\""}]], "InlineFormula"], " matches an element whose ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], " contains the token ", Cell[BoxData[StyleBox["nofollow", "TR"]], "InlineFormula"], ", and ", Cell[BoxData[RowBox[{"\"relList\"", "\[Rule]", "r_"}]], "InlineFormula"], " binds ", Cell[BoxData[StyleBox["r", "TR"]], "InlineFormula"], " to the list of tokens."}], "Notes"],

Cell[TextData[{"An element without the attribute, or with an empty or whitespace-only value, gives the list ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The attribute itself keeps its meaning. ", Cell[BoxData[RowBox[{"\"rel\"", "\[Rule]", "\"nofollow\""}]], "InlineFormula"], " matches only the exact value ", Cell[BoxData[StyleBox["nofollow", "TR"]], "InlineFormula"], ", and ", Cell[BoxData["\"rel\""], "InlineFormula"], " matches an element that has a ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], " attribute."}], "Notes"],

Cell[TextData[{"The readings are checked each time a function uses them. A malformed reading gives a message, such as ", Cell[BoxData["$AttributeReadings::badmethod"], "InlineFormula"], ", and the function returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLClassList"]], "InlineFormula"], " ignores ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

