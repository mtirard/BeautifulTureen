Notebook[{

Cell[CellGroupData[{
Cell["$AttributeReadings", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " \[LineSeparator]is an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " that gives, for each attribute it names, how the attribute value is split into a list of tokens and the list key that gives that list in ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{"Each entry of ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " is called a ", StyleBox["reading", FontSlant->"Italic"], ". With a reading, the value of an attribute is split into a list of tokens, which ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " matches under a new key, called a ", StyleBox["list key", FontSlant->"Italic"], "."}], "Notes"],

Cell[TextData[{"By default, only ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " has a reading, with the list key ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The option ", Cell[BoxData[RowBox[{StyleBox["\"AttributeReadings\"", "TR"], "\[Rule]", StyleBox["readings", "TI"]}]], "InlineFormula"], " of ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], " adds ", Cell[BoxData[StyleBox["readings", "TI"]], "InlineFormula"], " for one call. It is the same as ", Cell[BoxData[RowBox[{ButtonBox["Block", BaseStyle -> "Link", ButtonData -> "paclet:ref/Block"], "[", RowBox[{RowBox[{"{", "$AttributeReadings = Join[$AttributeReadings, readings$]", "}"}], ",", " ", StyleBox["call", "TI"]}], "]"}]], "InlineFormula"], ", so an entry for an attribute that already has a reading replaces that reading whole, and the readings hold for the whole call, including an ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], " in a condition or a rule body, and any function called from one."}], "Notes"],

Cell[TextData[{"Assigning to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " changes the readings for all later calls."}], "Notes"],

Cell[TextData[{"Each key is an attribute name given as a string. A namespaced attribute ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " cannot have a reading. Each value is an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " with any of the following fields:

| field | default | description |
| --- | --- | --- |
| ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " | ", Cell[BoxData[StyleBox["\"SpaceSeparated\"", "TR"]], "InlineFormula"], " | how the value is split: ", Cell[BoxData[StyleBox["\"SpaceSeparated\"", "TR"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["\"CommaSeparated\"", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " | a string pattern to split the value on |
| ", Cell[BoxData[StyleBox["\"TrimWhitespace\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " | whether to trim HTML whitespace from each token: ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], " |
| ", Cell[BoxData[StyleBox["\"ListKey\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " | the list key, a string; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " gives the attribute name followed by ", Cell[BoxData[StyleBox["\"List\"", "TR"]], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " sets the defaults of ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["\"TrimWhitespace\"", "TR"]], "InlineFormula"], ":

| ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " | ", Cell[BoxData[StyleBox["\"TrimWhitespace\"", "TR"]], "InlineFormula"], " |
| --- | --- | --- |
| ", Cell[BoxData[StyleBox["\"SpaceSeparated\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], " |
| ", Cell[BoxData[StyleBox["\"CommaSeparated\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[StyleBox["\",\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{"An explicit ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["\"TrimWhitespace\"", "TR"]], "InlineFormula"], " setting overrides the one from ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A list key matches as ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], " does. With a reading for ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], ", ", Cell[BoxData[RowBox[{StyleBox["\"relList\"", "TR"], "\[Rule]", StyleBox["\"nofollow\"", "TR"]}]], "InlineFormula"], " matches an element whose ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], " contains the token ", Cell[BoxData[StyleBox["nofollow", "TR"]], "InlineFormula"], ", and ", Cell[BoxData[RowBox[{StyleBox["\"relList\"", "TR"], "\[Rule]", "r_"}]], "InlineFormula"], " binds ", Cell[BoxData[StyleBox["r", "TR"]], "InlineFormula"], " to the list of tokens."}], "Notes"],

Cell[TextData[{"An element without the attribute, or with an empty or whitespace-only value, gives the list ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The attribute itself keeps its meaning. ", Cell[BoxData[RowBox[{StyleBox["\"rel\"", "TR"], "\[Rule]", StyleBox["\"nofollow\"", "TR"]}]], "InlineFormula"], " matches only the exact value ", Cell[BoxData[StyleBox["nofollow", "TR"]], "InlineFormula"], ", and ", Cell[BoxData[StyleBox["\"rel\"", "TR"]], "InlineFormula"], " matches an element that has a ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], " attribute."}], "Notes"],

Cell[TextData[{"The readings are checked each time a function uses them. A malformed reading gives a message, such as ", Cell[BoxData["$AttributeReadings::badmethod"], "InlineFormula"], ", and the function returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " ignores ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

