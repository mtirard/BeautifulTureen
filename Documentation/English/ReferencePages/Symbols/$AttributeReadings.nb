Notebook[{

Cell[CellGroupData[{
Cell["$AttributeReadings", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " \[LineSeparator]is an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " of the attributes whose values ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " can match as lists of tokens, such as ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " under the key ", Cell[BoxData["\"classList\""], "InlineFormula"], "."}], "Usage"],

Cell[TextData[{"For an attribute with an entry in ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " takes a ", StyleBox["list key", FontSlant->"Italic"], ": a key such as ", Cell[BoxData["\"classList\""], "InlineFormula"], ", whose value is a list of tokens taken from the attribute."}], "Notes"],

Cell[TextData[{"By default, only ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " has an entry, with the list key ", Cell[BoxData["\"classList\""], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"At a list key, a string, or alternatives of strings, matches one token among several, and any other value is matched against the whole list. With an entry for ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], ", ", Cell[BoxData[RowBox[{"\"relList\"", "\[Rule]", "\"nofollow\""}]], "InlineFormula"], " matches an element whose ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], " contains the token ", Cell[BoxData[StyleBox["nofollow", "TR"]], "InlineFormula"], ", and ", Cell[BoxData[RowBox[{"\"relList\"", "\[Rule]", "r_"}]], "InlineFormula"], " binds ", Cell[BoxData[StyleBox["r", "TR"]], "InlineFormula"], " to the list of tokens."}], "Notes"],

Cell[TextData[{"The option ", Cell[BoxData[RowBox[{"\"AttributeReadings\"", "\[Rule]", StyleBox["entries", "TI"]}]], "InlineFormula"], ", which ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]], "InlineFormula"], " and most other functions of this paclet take, adds ", Cell[BoxData[StyleBox["entries", "TI"]], "InlineFormula"], " for one call. An entry given in the option replaces the entry for the same attribute."}], "Notes"],

Cell[TextData[{"Each key is an attribute name given as a string. A namespaced attribute ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " cannot have an entry. Each value is an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " with any of the following fields:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["field", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"], "\"SpaceSeparated\"", Cell[TextData[{"how the value is split: ", Cell[BoxData["\"SpaceSeparated\""], "InlineFormula"], " or ", Cell[BoxData["\"CommaSeparated\""], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell["a string pattern to split the value on", "TableText"]},
{Cell["      ", "ModInfo"], "\"TrimWhitespace\"", ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"whether to trim HTML whitespace from each token: ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "\"ListKey\"", ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"the list key, a string; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " gives the attribute name followed by ", Cell[BoxData["\"List\""], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"],

Cell[TextData[{Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " sets the defaults of ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " and ", Cell[BoxData["\"TrimWhitespace\""], "InlineFormula"], ":"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], "\"SpaceSeparated\"", ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLWhitespace"], ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]},
{Cell["      ", "ModInfo"], "\"CommaSeparated\"", "\",\"", ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]}
}]], "3ColumnTableMod"],

Cell[TextData[{"An explicit ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " or ", Cell[BoxData["\"TrimWhitespace\""], "InlineFormula"], " setting overrides the one from ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"For an element without the attribute, or with an empty or whitespace-only value, the list is ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The key for the attribute itself still matches the whole value: with an entry for ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], ", ", Cell[BoxData[RowBox[{"\"rel\"", "\[Rule]", "\"nofollow\""}]], "InlineFormula"], " matches only the value ", Cell[BoxData[StyleBox["nofollow", "TR"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"Assigning to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " changes the entries for all later calls."}], "Notes"],

Cell[TextData[{"A malformed entry gives a message, such as ", Cell[BoxData["$AttributeReadings::badmethod"], "InlineFormula"], ", and the function returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLClassList"]], "InlineFormula"], " does not depend on ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], "."}], "Notes"]
}, Open  ]],

