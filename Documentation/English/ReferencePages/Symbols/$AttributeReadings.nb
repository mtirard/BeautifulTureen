Notebook[{

Cell[CellGroupData[{
Cell["$AttributeReadings", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " \[LineSeparator]is an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " that gives, for each attribute key with a reading, how its value is split into a token list and the list key under which ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " reaches that list."}], "Usage"],

Cell[TextData[{"By default, ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " has one entry, for ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], ", whose list key is ", Cell[BoxData[StyleBox["\"classList\"", "TR"]], "InlineFormula"], ". Every other attribute is reached only as its raw string value."}], "Notes"],

Cell[TextData[{"Each key of ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " is a literal attribute name. Each value is an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " with any of the following fields:

| field | default | description |
| --- | --- | --- |
| ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " | ", Cell[BoxData[StyleBox["\"SpaceSeparated\"", "TR"]], "InlineFormula"], " | the microsyntax: ", Cell[BoxData[StyleBox["\"SpaceSeparated\"", "TR"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["\"CommaSeparated\"", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " | the string pattern the value is split on |
| ", Cell[BoxData[StyleBox["\"TrimWhitespace\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " | whether to trim HTML whitespace from each token |
| ", Cell[BoxData[StyleBox["\"ListKey\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " | the list key; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " means the attribute name followed by ", Cell[BoxData[ButtonBox["List", BaseStyle -> "Link", ButtonData -> "paclet:ref/List"]], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " is shorthand for the defaults of ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["\"TrimWhitespace\"", "TR"]], "InlineFormula"], ":

| ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " | ", Cell[BoxData[StyleBox["\"TrimWhitespace\"", "TR"]], "InlineFormula"], " |
| --- | --- | --- |
| ", Cell[BoxData[StyleBox["\"SpaceSeparated\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], " |
| ", Cell[BoxData[StyleBox["\"CommaSeparated\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[StyleBox["\",\"", "TR"]], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"], " |"}], "Notes"],

Cell[TextData[{"An explicit ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["\"TrimWhitespace\"", "TR"]], "InlineFormula"], " setting overrides the one given by ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["Delimiters", BaseStyle -> "Link", ButtonData -> "paclet:ref/Delimiters"]], "InlineFormula"], " can be any string pattern."}], "Notes"],

Cell[TextData[{"Trimming removes ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineFormula"], " from both ends of each token, and nothing else: a no-break space stays part of a token."}], "Notes"],

Cell[TextData[{"A pattern naming a list key, such as ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["\"a\"", "TR"], ",", " ", RowBox[{StyleBox["\"relList\"", "TR"], "\[Rule]", StyleBox["\"nofollow\"", "TR"]}]}], "]"}]], "InlineFormula"], ", is matched against the token list of the raw attribute. An element without the raw attribute has the token list ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], ", as do an empty value and a value of whitespace only."}], "Notes"],

Cell[TextData[{"The raw key keeps its meaning: ", Cell[BoxData[RowBox[{StyleBox["\"rel\"", "TR"], "\[Rule]", StyleBox["\"nofollow\"", "TR"]}]], "InlineFormula"], " is still an exact match on the string, and a bare ", Cell[BoxData[StyleBox["\"rel\"", "TR"]], "InlineFormula"], " still asks whether the attribute is present. Adding a reading makes a new key available and never changes what an existing key means."}], "Notes"],

Cell[TextData[{"A namespaced key ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["namespace", "TI"], ",", " ", StyleBox["name", "TI"]}], "}"}]], "InlineFormula"], " never has a reading, and the keys of ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " must be strings."}], "Notes"],

Cell[TextData[{"The option ", Cell[BoxData[RowBox[{StyleBox["\"AttributeReadings\"", "TR"], "\[Rule]", StyleBox["readings", "TI"]}]], "InlineFormula"], " of ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], " adds ", Cell[BoxData[StyleBox["readings", "TI"]], "InlineFormula"], " to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " for one call. The table used is ", Cell[BoxData[RowBox[{ButtonBox["Join", BaseStyle -> "Link", ButtonData -> "paclet:ref/Join"], "[", RowBox[{ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"], ",", " ", StyleBox["readings", "TI"]}], "]"}]], "InlineFormula"], ", so an entry for a key that ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " already has replaces that entry whole; fields are not merged."}], "Notes"],

Cell[TextData[{"Assigning to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " changes the readings for every later query. Setting ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineFormula"], " in a ", Cell[BoxData[ButtonBox["Block", BaseStyle -> "Link", ButtonData -> "paclet:ref/Block"]], "InlineFormula"], " replaces the whole table, the ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " entry included."}], "Notes"],

Cell[TextData[{"The table in force is checked each time a consuming function is called. If it is malformed, the function issues one of the following messages and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], ":

| message | cause |
| --- | --- |
| ", Cell[BoxData["$AttributeReadings::notassoc"], "InlineFormula"], " | the table is not an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " |
| ", Cell[BoxData["$AttributeReadings::badkey"], "InlineFormula"], " | a key is not a string |
| ", Cell[BoxData["$AttributeReadings::badentry"], "InlineFormula"], " | an entry is not an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " |
| ", Cell[BoxData["$AttributeReadings::badfield"], "InlineFormula"], " | an entry has an unknown field |
| ", Cell[BoxData["$AttributeReadings::badmethod"], "InlineFormula"], " | ", Cell[BoxData[ButtonBox["Method", BaseStyle -> "Link", ButtonData -> "paclet:ref/Method"]], "InlineFormula"], " is not ", Cell[BoxData[StyleBox["\"SpaceSeparated\"", "TR"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["\"CommaSeparated\"", "TR"]], "InlineFormula"], " |
| ", Cell[BoxData["$AttributeReadings::badvalue"], "InlineFormula"], " | a field has a value of the wrong kind |
| ", Cell[BoxData["$AttributeReadings::duplistkey"], "InlineFormula"], " | two readings have the same list key |
| ", Cell[BoxData["$AttributeReadings::listkeyisreading"], "InlineFormula"], " | a list key is itself a key with a reading |"}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " always uses the built-in ", Cell[BoxData[StyleBox["class", "TR"]], "InlineFormula"], " reading."}], "Notes"]
}, Open  ]],

