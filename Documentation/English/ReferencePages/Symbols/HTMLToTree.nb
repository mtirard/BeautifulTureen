Notebook[{

Cell[CellGroupData[{
Cell["HTMLToTree", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"], "[", StyleBox["tree", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]draws ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " as a ", Cell[BoxData[ButtonBox["Tree", BaseStyle -> "Link", ButtonData -> "paclet:ref/Tree"]], "InlineFormula"], ", with one node per element and per text string.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["n", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]draws the elements of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " down to depth ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{"\"Focus\"", "\[Rule]", StyleBox["query", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]draws only the elements that ", Cell[BoxData[StyleBox["query", "TI"]], "InlineFormula"], " matches, with their contents, and collapses the rest of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ".", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{"\"Hide\"", "\[Rule]", StyleBox["query", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]leaves out the elements that ", Cell[BoxData[StyleBox["query", "TI"]], "InlineFormula"], " matches, with their contents."}], "Usage"],

Cell[TextData[{"Each element is drawn as a node labelled with its tag name. Its tooltip gives its compound selector, such as ", Cell[BoxData["\"div#main.note\""], "InlineFormula"], ", and its attributes."}], "Notes"],

Cell["Each text string is drawn as a leaf labelled with its text, with runs of whitespace collapsed and the text cut to 40 characters. Its tooltip gives the whole string.", "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " document, an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", or a list of ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " objects and strings. A document or a list is drawn under a root labelled \"#document\", and an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " is drawn as the root."}], "Notes"],

Cell[TextData[{"Strings made only of ", Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLWhitespace"]], "InlineFormula"], " characters are left out, unless ", Cell[BoxData[RowBox[{"\"IncludeWhitespace\"", "\[Rule]", ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]}]], "InlineFormula"], " is given. Comments and processing instructions are left out."}], "Notes"],

Cell[TextData[{"The result is a ", Cell[BoxData[ButtonBox["Tree", BaseStyle -> "Link", ButtonData -> "paclet:ref/Tree"]], "InlineFormula"], ", with the following node data:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["node", "TableText"], FontSlant->"Italic"], StyleBox[Cell["data", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell["element", "TableText"], Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attrs", "TI"], ",", RowBox[{"{", "}"}]}], "]"}]], "InlineFormula"], ", the element with its contents removed"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["text", "TableText"], Cell["the string", "TableText"]},
{Cell["      ", "ModInfo"], Cell["root of a document or a list", "TableText"], "\"#document\""},
{Cell["      ", "ModInfo"], Cell["collapsed leaf", "TableText"], Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["Missing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Missing"], "[", RowBox[{"\"Collapsed\"", ",", StyleBox["k", "TI"]}], "]"}]], "InlineFormula"], ", where ", Cell[BoxData[StyleBox["k", "TI"]], "InlineFormula"], " is the number of elements it stands for"}], "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"In ", Cell[BoxData[RowBox[{ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["n", "TI"]}], "]"}]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " is a non-negative integer or ", Cell[BoxData[ButtonBox["Infinity", BaseStyle -> "Link", ButtonData -> "paclet:ref/Infinity"]], "InlineFormula"], ", the default. The depth of an element is the number of generations of elements between it and the root, which is at depth 0. Text has the depth of its element."}], "Notes"],

Cell[TextData[{"An element at depth ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " that has element children is drawn with a single collapsed leaf, labelled \[Ellipsis], in place of all its contents."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["query", "TI"]], "InlineFormula"], " can be anything that ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " takes, such as an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " pattern, a CSS selector string, or a rule. A pattern focuses the elements that ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["query", "TI"]}], "]"}]], "InlineFormula"], " gives. A rule focuses the places of the names that its right-hand side uses."}], "Notes"],

Cell["Each focused element hangs from its nearest drawn ancestor. If elements are skipped between them, the edge is dashed, and its tooltip gives the path of skipped elements. Each run of consecutive siblings that are not drawn and hold no focused element is drawn as a single collapsed leaf, in its place.", "Notes"],

Cell[TextData[{"With ", Cell[BoxData["\"Focus\""], "InlineFormula"], ", depth counts from each focused element, and a focused element below depth ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " is still drawn."}], "Notes"],

Cell[TextData[{"Hidden elements leave no mark. Hiding wins over focus: a focused element that is hidden, or inside a hidden element, is not drawn. Both queries are matched against ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " as given. A name in a rule can be bound to the following places:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["place", "TableText"], FontSlant->"Italic"], StyleBox[Cell["``\"Hide\"``", "TableText"], FontSlant->"Italic"], StyleBox[Cell["``\"Focus\"``", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell["an element", "TableText"], Cell["hides the element and its contents", "TableText"], Cell["draws the element and its contents", "TableText"]},
{Cell["      ", "ModInfo"], Cell["a run of element children", "TableText"], Cell["hides each element of the run", "TableText"], Cell["draws each element of the run", "TableText"]},
{Cell["      ", "ModInfo"], Cell["the contents of an element", "TableText"], Cell["hides the contents, text included, and keeps the element", "TableText"], Cell["not accepted", "TableText"]},
{Cell["      ", "ModInfo"], Cell["an attribute, a tag, a token, an empty place, a named path", "TableText"], Cell["not accepted", "TableText"], Cell["not accepted", "TableText"]}
}]], "3ColumnTableMod"],

Cell[TextData[{"With ", Cell[BoxData[RowBox[{"\"MergeText\"", "\[Rule]", ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]}]], "InlineFormula"], ", an element whose contents hold elements, all of them inline, is drawn with a single text leaf in place of its contents. The text is what ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]], "InlineFormula"], " gives for the element, with the same ", Cell[BoxData["\"Roles\""], "InlineFormula"], " and ", Cell[BoxData["\"AttributeReadings\""], "InlineFormula"], ". ", Cell[BoxData[RowBox[{"\"MergeText\"", "\[Rule]", ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLTextContent"]}]], "InlineFormula"], " gives the text that ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLTextContent"]], "InlineFormula"], " gives instead."}], "Notes"],

Cell["The following options can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell["\"Focus\"", "TableText"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"elements to draw with their contents; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " is ", Cell[BoxData[ButtonBox["All", BaseStyle -> "Link", ButtonData -> "paclet:ref/All"]], "InlineFormula"], ", which draws all elements"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"Hide\"", "TableText"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"elements to leave out with their contents; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " is ", Cell[BoxData[ButtonBox["None", BaseStyle -> "Link", ButtonData -> "paclet:ref/None"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"CollapsePaths\"", "TableText"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"whether to draw the elements on the path to a focused element as a dashed edge, ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"], ", or as nodes, ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], "; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " is ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"MergeText\"", "TableText"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{Cell[BoxData[ButtonBox["None", BaseStyle -> "Link", ButtonData -> "paclet:ref/None"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]], "InlineFormula"], " or ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLTextContent"]], "InlineFormula"], ", the function that gives merged text; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " is ", Cell[BoxData[ButtonBox["None", BaseStyle -> "Link", ButtonData -> "paclet:ref/None"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"IncludeWhitespace\"", "TableText"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"whether to draw strings of only whitespace; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " is ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"Roles\"", "TableText"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"rules that set the role of elements for merging, as in ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]], "InlineFormula"], "; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " is ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["\"AttributeReadings\"", "TableText"], ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"], Cell[TextData[{"readings to add to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " for this call; ", Cell[BoxData[ButtonBox["Automatic", BaseStyle -> "Link", ButtonData -> "paclet:ref/Automatic"]], "InlineFormula"], " is ", Cell[BoxData[StyleBox["<||>", "TR"]], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"],

Cell[TextData[{"Any option of ", Cell[BoxData[ButtonBox["Tree", BaseStyle -> "Link", ButtonData -> "paclet:ref/Tree"]], "InlineFormula"], " can also be given, and is passed to ", Cell[BoxData[ButtonBox["Tree", BaseStyle -> "Link", ButtonData -> "paclet:ref/Tree"]], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"]], "InlineFormula"], " uses ", Cell[BoxData[RowBox[{ButtonBox["TreeLayout", BaseStyle -> "Link", ButtonData -> "paclet:ref/TreeLayout"], "\[Rule]", ButtonBox["Left", BaseStyle -> "Link", ButtonData -> "paclet:ref/Left"]}]], "InlineFormula"], ", and an ", Cell[BoxData[ButtonBox["ImageSize", BaseStyle -> "Link", ButtonData -> "paclet:ref/ImageSize"]], "InlineFormula"], " computed from the tree that is drawn, unless other values are given."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["MaxDisplayedChildren", BaseStyle -> "Link", ButtonData -> "paclet:ref/MaxDisplayedChildren"], "\[Rule]", StyleBox["m", "TI"]}]], "InlineFormula"], " limits the children of every node to ", Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula"], ", not only those of the root. Rules given for ", Cell[BoxData[ButtonBox["TreeElementLabelFunction", BaseStyle -> "Link", ButtonData -> "paclet:ref/TreeElementLabelFunction"]], "InlineFormula"], " replace the default labels only for the nodes they cover."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " when ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " or an option value has none of the forms above. A call with an option that neither ", Cell[BoxData[ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"]], "InlineFormula"], " nor ", Cell[BoxData[ButtonBox["Tree", BaseStyle -> "Link", ButtonData -> "paclet:ref/Tree"]], "InlineFormula"], " has is left unevaluated."}], "Notes"]
}, Open  ]],

