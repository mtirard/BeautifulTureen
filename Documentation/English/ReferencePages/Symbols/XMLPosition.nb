Cell[CellGroupData[{
Cell["XMLPosition", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives the positions in ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " of the elements that ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " for each result of ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], ", with each name it uses replaced by its position."}], "Usage"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], " gives one result for each result of ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], ", in the same order. Each name that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " uses is replaced by its position before ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " is evaluated."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " gives the positions of the elements that the pattern root of ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches, in document order. When nothing matches, it gives ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], ", which is also the position of the document: ", Cell[BoxData[ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"]], "InlineFormula"], " reads ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " as the document, as ", Cell[BoxData[RowBox[{ButtonBox["Extract", BaseStyle -> "Link", ButtonData -> "paclet:ref/Extract"], "[", RowBox[{StyleBox["expr", "TI"], ",", RowBox[{"{", "}"}]}], "]"}]], "InlineFormula"], " gives ", Cell[BoxData[StyleBox["expr", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " can have the same forms as in ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A position counts ", StyleBox["element children only", FontWeight->"Bold"], ", from the document. Text is not counted, so whitespace between elements does not change the indices."}], "Notes"],

Cell[TextData[{"The position of the document is ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], ". The root element of an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", and a bare ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " given as the tree, are at ", Cell[BoxData[RowBox[{"{", StyleBox["1", "TR"], "}"}]], "InlineFormula"], ". The ", Cell[BoxData[StyleBox["i", "TR"]], "InlineFormula"], "-th element of a list is at ", Cell[BoxData[RowBox[{"{", StyleBox["i", "TR"], "}"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A position for an element is a list of indices ", Cell[BoxData[RowBox[{"{", RowBox[{SubscriptBox[StyleBox["i", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["i", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]], "InlineFormula"], ". A name bound to another part of the tree gives a position that ends in one of the following:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["end", "TableText"], FontSlant->"Italic"], StyleBox[Cell["part", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "0", Cell["the tag", "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Key", BaseStyle -> "Link", ButtonData -> "paclet:ref/Key"], "[", ButtonBox["All", BaseStyle -> "Link", ButtonData -> "paclet:ref/All"], "]"}], Cell["the attribute list", "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Key", BaseStyle -> "Link", ButtonData -> "paclet:ref/Key"], "[", "\"\<\!\(\*StyleBox[\"key\", \"TI\"]\)\>\"", "]"}], Cell[TextData[{"the value of an attribute, or the list of tokens of a list key such as ", Cell[BoxData["\"classList\""], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "Key[\"key$\"], i$", Cell[TextData[{"the ", Cell[BoxData[StyleBox["i", "TI"]], "InlineFormula"], "-th token of a list key"}], "TableText"]},
{Cell["      ", "ModInfo"], ButtonBox["All", BaseStyle -> "Link", ButtonData -> "paclet:ref/All"], Cell["the contents, text included", "TableText"]},
{Cell["      ", "ModInfo"], "m$ ;; n$", Cell[TextData[{"the run of element children ", Cell[BoxData[StyleBox["m", "TI"]], "InlineFormula"], " to ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], "n$ ;; n$-1", Cell[TextData[{"the empty place before element child ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"]}], "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"A named path, as in ", Cell[BoxData["path : Descendant[p$]"], "InlineFormula"], ", gives ", Cell[BoxData["upper$ ;; lower$"], "InlineFormula"], ", the positions of its two ends. The path is the elements strictly between them."}], "Notes"],

Cell["A name used twice whose two values are compared for equality, such as a name used twice in one list, gives the list of its two positions.", "Notes"],

Cell[TextData[{"A name used in ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " is replaced by its position inside any expression, and ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " is then evaluated. Give ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " as a name, or a list of names, to get the positions themselves."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"]], "InlineFormula"], " gives the parts of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " at positions."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " when ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " has none of the forms that ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " accepts."}], "Notes"],

Cell["The following option can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "\"AttributeReadings\"", StyleBox["<||>", "TR"], Cell[TextData[{"entries to add to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " for this call, as in ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"]
