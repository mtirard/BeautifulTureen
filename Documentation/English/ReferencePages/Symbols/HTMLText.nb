Cell["HTMLText", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["HTMLText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLText"], "[", StyleBox["element", "TI"], "]"}]], "InlineFormula"], " \[LineSeparator]gives the text content of the element ", Cell[BoxData[StyleBox["element", "TI"]], "InlineFormula"], ".", "\[LineSeparator]"}], "Usage"],

Cell[TextData[{Cell[BoxData[TemplateBox[{Cell[TextData["HTMLText"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLText"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["element", "TI"]], "InlineFormula"], "] returns the concatenated text content of ", Cell[BoxData[StyleBox["element", "TI"]], "InlineFormula"], ", recursively joining the strings in its children and descendants with ", Cell[BoxData[TemplateBox[{Cell[TextData["StringJoin"]], "paclet:ref/StringJoin"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " and discarding all markup."}], "Notes"],

Cell[TextData[{"Given a bare string, ", Cell[BoxData[TemplateBox[{Cell[TextData["HTMLText"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLText"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " returns it unchanged; given anything other than an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " or a string, for example an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLObject"]], "paclet:ref/XMLObject"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " declaration, it returns the empty string \"\"."}], "Notes"],

Cell["Concatenation is naive: no whitespace is inserted at block boundaries and br elements do not become newlines, so adjacent inline text may run together.", "Notes"],

Cell[TextData[{Cell[BoxData[TemplateBox[{Cell[TextData["HTMLText"]], "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLText"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " is commonly applied to the results of ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLCases"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " or ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLFirstCase"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " to extract readable text from matched elements."}], "Notes"]
}, Open  ]],

