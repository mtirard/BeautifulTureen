Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{"XMLPattern", "[", RowBox[{"\"p\"", ",", RowBox[{"\"classList\"", "->", "\"lead\""}]}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", "\"First.\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Name the href value and use it on the right-hand side:", "ExampleText"], Cell[BoxData[{RowBox[{RowBox[{"tree", "=", RowBox[{"ImportString", "[", RowBox[{"\"<ul><li><a href=\\\"/miso\\\">Miso</a></li><li><a href=\\\"/pho\\\">Pho</a></li></ul>\"", ",", RowBox[{"{", RowBox[{"\"HTML\"", ",", "\"XMLObject\""}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"a\"", ",", RowBox[{"\"href\"", "->", "href_"}]}], "]"}], ":>", "href"}]}], "]"}]}], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/miso\"", ",", "\"/pho\""}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Get the date and the name of each bank holiday from one pattern for a table row:", "ExampleText"], Cell[BoxData[{RowBox[{RowBox[{"holidays", "=", RowBox[{"ImportString", "[", RowBox[{"\"<table><tr><th><time datetime=\\\"2026-12-25\\\">25 December</time></th><td>Friday</td><td>Christmas Day</td></tr><tr><th><time datetime=\\\"2026-12-28\\\">28 December</time></th><td>Monday</td><td>Boxing Day</td></tr></table>\"", ",", RowBox[{"{", RowBox[{"\"HTML\"", ",", "\"XMLObject\""}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{"XMLCases", "[", RowBox[{"holidays", ",", RowBox[{RowBox[{RowBox[{"XMLPattern", "[", "\"tr\"", "]"}], "[", RowBox[{"{", RowBox[{RowBox[{RowBox[{"XMLPattern", "[", "\"th\"", "]"}], "[", RowBox[{"{", RowBox[{"XMLPattern", "[", RowBox[{"\"time\"", ",", RowBox[{"\"datetime\"", "->", "date_"}]}], "]"}], "}"}], "]"}], ",", "___", ",", RowBox[{"name", ":", RowBox[{"XMLPattern", "[", "\"td\"", "]"}]}]}], "}"}], "]"}], ":>", RowBox[{"{", RowBox[{"date", ",", RowBox[{"HTMLTextContent", "[", "name", "]"}]}], "}"}]}]}], "]"}]}], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"2026-12-25\"", ",", "\"Christmas Day\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"2026-12-28\"", ",", "\"Boxing Day\""}], "}"}]}], "}"}]], "Output"]}, Open]]}, Open]],

