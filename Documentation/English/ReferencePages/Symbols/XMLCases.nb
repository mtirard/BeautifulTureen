Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"Home\"", ",", "\"outer\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"News\"", ",", "\"outer\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"About\"", ",", "\"outer\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"News\"", ",", "\"inner\""}], "}"}]}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Use a name twice in one list to require equal values, here the same class as an earlier sibling:", "ExampleText"], Cell[BoxData["list=ImportString[\"<ul><li class=\\\"x\\\">1</li><li class=\\\"y\\\">2</li><li class=\\\"x\\\">3</li></ul>\",{\"HTML\",\"XMLObject\"}];
