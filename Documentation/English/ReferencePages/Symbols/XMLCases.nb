Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Put a condition on an element pattern to select lists with at least two items:", "ExampleText"], Cell[BoxData["menu=ImportString[\"<ul><li>Miso</li><li>Pho</li></ul><ol><li>Ramen</li></ol>\",{\"HTML\",\"XMLObject\"}];
