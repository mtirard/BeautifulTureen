Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["When the tree is an XMLElement, it can be the pattern root:", "ExampleText"], Cell[BoxData["section=XMLElement[\"section\",{},{XMLElement[\"p\",{},{\"Direct\"}],XMLElement[\"div\",{},{XMLElement[\"p\",{},{\"Nested\"}]}]}];
