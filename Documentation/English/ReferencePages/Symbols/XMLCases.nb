Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Put a condition on the right-hand side to keep each item that some later item exceeds:", "ExampleText"], Cell[BoxData["ranks=ImportString[\"<ol><li>3</li><li>1</li><li>2</li></ol>\",{\"HTML\",\"XMLObject\"}];
