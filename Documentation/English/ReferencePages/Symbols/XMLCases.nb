Cell[CellGroupData[{
Cell["XMLCases", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", " ", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives a list of the elements of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " that match ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ".", "\[LineSeparator]"}], "Usage"],

Cell[TextData[{Cell[BoxData[TemplateBox[{Cell[TextData["XMLCases"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], "] returns a flat list of every element of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " matching ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", searched at all depths via ", Cell[BoxData[TemplateBox[{Cell[TextData["Cases"]], "paclet:ref/Cases"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " with an ", Cell[BoxData[TemplateBox[{Cell[TextData["Infinity"]], "paclet:ref/Infinity"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " level specification."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLObject"]], "paclet:ref/XMLObject"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " (as returned by ", Cell[BoxData[TemplateBox[{Cell[TextData["ImportString"]], "paclet:ref/ImportString"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["source", "TI"]], "InlineFormula"], ", {\"HTML\", \"XMLObject\"}]), a single ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], ", or a list of either."}], "Notes"],

Cell[TextData[{"The simplest ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " pattern, most conveniently built with ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLPattern"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], ". A bare ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLPattern"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["constraints", "TI"]], "InlineFormula"], "] expands to an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " pattern, so this case is effectively ", Cell[BoxData[TemplateBox[{Cell[TextData["Cases"]], "paclet:ref/Cases"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", ", Cell[BoxData[TemplateBox[{Cell[TextData["Infinity"]], "paclet:ref/Infinity"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "]."}], "Notes"],

Cell[TextData[{"An ", Cell[BoxData[TemplateBox[{Cell[TextData["Alternatives"]], "paclet:ref/Alternatives"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " of ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " patterns matches any of several element shapes in a single pass, and the alternatives may carry different attribute and class constraints."}], "Notes"],

Cell[TextData[{"Combinators express structural relationships between elements: ", Cell[BoxData[TemplateBox[{Cell[TextData["Child"]], "paclet:MaximilienTirard/BeautifulTureen/ref/Child"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["parent", "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["child", "TI"]], "InlineFormula"], "] matches direct children, ", Cell[BoxData[TemplateBox[{Cell[TextData["Descendant"]], "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["ancestor", "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["desc", "TI"]], "InlineFormula"], "] matches at any depth, ", Cell[BoxData[TemplateBox[{Cell[TextData["Adjacent"]], "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["before", "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["after", "TI"]], "InlineFormula"], "] matches an immediately following sibling, and ", Cell[BoxData[TemplateBox[{Cell[TextData["Sibling"]], "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], "[", Cell[BoxData[StyleBox["before", "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["after", "TI"]], "InlineFormula"], "] matches any following sibling."}], "Notes"],

Cell[TextData[{"A delayed rule ", Cell[BoxData[RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["body", "TI"]}]], "InlineFormula"], " returns the result of applying ", Cell[BoxData[StyleBox["body", "TI"]], "InlineFormula"], " to each match instead of the matched elements. Pattern names bound on the left-hand side\[LongDash]including those bound inside a combinator\[LongDash]are in scope in ", Cell[BoxData[StyleBox["body", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[TemplateBox[{Cell[TextData["XMLCases"]], "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " returns ", Cell[BoxData["$Failed"], "InlineFormula"], " and issues a message when ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " is not a valid XML expression (", Cell[BoxData["XMLCases::badtree"], "InlineFormula"], ") or when ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is neither an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " pattern, an ", Cell[BoxData[TemplateBox[{Cell[TextData["Alternatives"]], "paclet:ref/Alternatives"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " of them, nor a supported combinator (", Cell[BoxData["XMLCases::badpat"], "InlineFormula"], ")."}], "Notes"]
}, Open  ]],

