Cell[BoxData[RowBox[{"{", RowBox[{"\"/x\"", ",", "\"/x\""}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["An unused name is a test, so this gives each link that has a later link, once:", "ExampleText"], Cell[BoxData["links=ImportString[\"<p><a href=\\\"/a\\\">A</a><a href=\\\"/b\\\">B</a><a href=\\\"/c\\\">C</a></p>\",{\"HTML\",\"XMLObject\"}];
