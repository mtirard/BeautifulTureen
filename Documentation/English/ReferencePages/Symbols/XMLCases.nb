Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Name both the element and its classes:", "ExampleText"], Cell[BoxData["cards=ImportString[\"<p class=\\\"lead promo\\\">A</p><p>B</p>\",{\"HTML\",\"XMLObject\"}];
