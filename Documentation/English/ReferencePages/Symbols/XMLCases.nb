Notebook[{

Cell[CellGroupData[{
Cell["XMLCases", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives a list of the elements of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " that match ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", in document order.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives the value of ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " once for each distinct combination of the positions in ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " of the names that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " uses.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"], ",", StyleBox["n", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives the first ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " results."}], "Usage"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], " gives one result for each distinct combination of the positions of the names that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " uses:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["``rhs$`` uses", "TableText"], FontSlant->"Italic"], StyleBox[Cell["results", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"one name ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"]}], "TableText"], Cell[TextData[{"one for each position of ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"names ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["y", "TR"]], "InlineFormula"]}], "TableText"], Cell[TextData[{"one for each pair of positions of ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["y", "TR"]], "InlineFormula"], " matched together"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["no name", "TableText"], Cell["at most one", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"A name that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " does not use must match, but adds no results. A name that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " uses only in its condition, after ", Cell[BoxData["/;"], "InlineFormula"], ", adds no results either."}], "Notes"],

Cell[TextData[{"The results are in ", StyleBox["document order", FontWeight->"Bold"], ": an element comes before the elements nested in it, and an earlier sibling and its contents come before a later sibling. With several names, the results are ordered by the first name in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", then by the next, whatever their order in ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", or a list of elements and strings."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern, which matches exactly as written, an ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " pattern, a CSS selector string such as ", Cell[BoxData["\"div.note > p\""], "InlineFormula"], ", or alternatives of these. Each can be named, as in ", Cell[BoxData["x : XMLPattern[\"p\"]"], "InlineFormula"], ", have a condition, as in ", Cell[BoxData["x : XMLPattern[\"p\"] /; test"], "InlineFormula"], ", or have a test, as in ", Cell[BoxData["XMLPattern[\"p\"]?f"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attrs", "TI"]}], "]"}], "[", RowBox[{SubscriptBox[StyleBox["c", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " takes constraints on the elements below it: a list pattern over its element children, such as ", Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "\"li\"", "]"}], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], ", ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " for an element child, or ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " for an element anywhere below. The outermost pattern in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches an element of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", and the patterns in its constraints match elements below that element."}], "Notes"],

Cell[TextData[{"A CSS selector for one element, one that depends only on its element and what is below it, such as ", Cell[BoxData["\"a.note\""], "InlineFormula"], " or ", Cell[BoxData["\"ul:has(> li)\""], "InlineFormula"], ", can be used anywhere a pattern can. Other selectors depend on what is above or beside their element, such as ", Cell[BoxData["\"nav a\""], "InlineFormula"], ": give one as the whole pattern, or name it on the left of a rule, as in ", Cell[BoxData[RowBox[{"n : \"nav a\"", "\[RuleDelayed]", StyleBox["n", "TR"]}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A name used twice, in one list or once above and once below, must have equal values at both positions. A name for an element used in two constraints of one ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " must match the same element in both."}], "Notes"],

Cell["A condition can use only the names bound inside the pattern it is on.", "Notes"],

Cell[TextData[{"In ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"], ",", StyleBox["n", "TI"]}], "]"}]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " is a non-negative integer or ", Cell[BoxData[ButtonBox["Infinity", BaseStyle -> "Link", ButtonData -> "paclet:ref/Infinity"]], "InlineFormula"], ". With ", Cell[BoxData[RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " is evaluated only for the results given."}], "Notes"],

Cell[TextData[{"When ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " is an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", the outermost pattern can match it, but it is never itself a result. The root element of an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " and the elements of a list can be results."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " when ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " has none of the forms above, when an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is malformed, or when a name that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " uses has no position, such as a name for text."}], "Notes"],

Cell["The following option can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "\"AttributeReadings\"", StyleBox["<||>", "TR"], Cell[TextData[{"attributes to split into lists of tokens for this call, in addition to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"]
}, Open  ]],

