Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Find every paragraph in an HTML fragment:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<p class=\\\"lead\\\">First.</p><p>Second.</p>\",{\"HTML\",\"XMLObject\"}];
XMLCases[tree,XMLPattern[\"p\"]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", "\"First.\"", "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Second.\"", "}"}]}], "]"}]}], "}"}]], "Output"],

Cell["Find only the paragraphs that have the class lead:", "ExampleText"],

Cell[BoxData["XMLCases[tree,XMLPattern[\"p\",\"classList\"->\"lead\"]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", "\"First.\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Collect the target of each link with a rule:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<ul><li><a href=\\\"/miso\\\">Miso</a></li><li><a href=\\\"/pho\\\">Pho</a></li></ul>\",{\"HTML\",\"XMLObject\"}];
XMLCases[tree,XMLPattern[\"a\",\"href\"->href_]:>href]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/miso\"", ",", "\"/pho\""}], "}"}]], "Output"]}, Open]]}, Open]],

