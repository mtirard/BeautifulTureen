Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A match nested in another match is also returned, after the outer one:", "ExampleText"], Cell[BoxData["nested=ImportString[\"<div id=\\\"outer\\\"><div id=\\\"inner\\\">x</div></div>\",{\"HTML\",\"XMLObject\"}];
XMLCases[nested,XMLPattern[\"div\"]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"div\"", ",", RowBox[{"{", RowBox[{"\"id\"", "\[Rule]", "\"outer\""}], "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"div\"", ",", RowBox[{"{", RowBox[{"\"id\"", "\[Rule]", "\"inner\""}], "}"}], ",", RowBox[{"{", "\"x\"", "}"}]}], "]"}], "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"div\"", ",", RowBox[{"{", RowBox[{"\"id\"", "\[Rule]", "\"inner\""}], "}"}], ",", RowBox[{"{", "\"x\"", "}"}]}], "]"}]}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Whitespace is kept in the contents, but a list pattern over the children skips text:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<div><p>a</p>\\n<p>b</p></div>\",{\"HTML\",\"XMLObject\"}];
{First[XMLCases[tree,XMLPattern[\"div\"]]][[3]],XMLCases[tree,XMLPattern[\"div\",_,{XMLPattern[\"p\"],x:XMLPattern[\"p\"]}]:>x]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"a\"", "}"}]}], "]"}], ",", "\"\\n\"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"b\"", "}"}]}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"b\"", "}"}]}], "]"}], "}"}]}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A condition on a pattern cannot use a name bound later in the pattern, so this matches nothing:", "ExampleText"], Cell[BoxData["ranks=ImportString[\"<ol><li>3</li><li>1</li><li>2</li></ol>\",{\"HTML\",\"XMLObject\"}];
rank[XMLElement[_,_,{s_String}]]:=ToExpression[s];
XMLCases[ranks,XMLPattern[\"ol\",_,{___,(x:XMLPattern[\"li\"])/;rank[x]<rank[y],___,y:XMLPattern[\"li\"],___}]:>HTMLTextContent[x]]"], "Input"],

Cell[BoxData[RowBox[{"{", "}"}]], "Output"],

Cell["Put the condition on a pattern that contains both names:", "ExampleText"],

Cell[BoxData["XMLCases[ranks,XMLPattern[\"ol\",_,{___,x:XMLPattern[\"li\"],___,y:XMLPattern[\"li\"],___}/;rank[x]<rank[y]]:>HTMLTextContent[x]]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"1\"", "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["The function of a PatternTest cannot use pattern names:", "ExampleText"], Cell[BoxData["doc=ImportString[\"<div id=\\\"a\\\"><p id=\\\"a\\\">one</p><p id=\\\"x\\\">two</p></div>\",{\"HTML\",\"XMLObject\"}];
XMLCases[doc,XMLPattern[\"div\",\"id\"->d_,Descendant[x:XMLPattern[\"p\",\"id\"->_?(#===d&)]]]:>x]"], "Input"],

Cell[BoxData[RowBox[{"{", "}"}]], "Output"],

Cell["Use the name again to require an equal value:", "ExampleText"],

Cell[BoxData["XMLCases[doc,XMLPattern[\"div\",\"id\"->d_,Descendant[x:XMLPattern[\"p\",\"id\"->d_]]]:>x]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"id\"", "\[Rule]", "\"a\""}], "}"}], ",", RowBox[{"{", "\"one\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A name for text cannot be a result, since text has no place of its own:", "ExampleText"], Cell[BoxData["row=ImportString[\"<table><tr><th>Mon</th><td>Mon</td></tr></table>\",{\"HTML\",\"XMLObject\"}];
XMLCases[row,XMLPattern[\"tr\",_,{XMLElement[\"th\",_,{t_String}],___}]:>t]"], "Input"],

Cell["XMLCases::text: The name t binds text inside an XMLElement pattern, and text has no position, so the name cannot be a result. Name the element that holds the text instead, or use the name only in a test.", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["Name the element that holds the text:", "ExampleText"],

Cell[BoxData["XMLCases[row,XMLPattern[\"tr\",_,{h:XMLElement[\"th\",_,{_String}],___}]:>HTMLTextContent[h]]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"Mon\"", "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["A name bound inside Except has no value on the right-hand side:", "ExampleText"], Cell[BoxData["links=ImportString[\"<p><b>x</b><a href=\\\"/a\\\">A</a></p>\",{\"HTML\",\"XMLObject\"}];
XMLCases[links,XMLPattern[\"p\",_,{Except[x:XMLPattern[\"a\"]]...,___}]:>x]"], "Input"],

Cell["XMLCases::exceptname: The name x is bound inside Except, which matches only where its pattern does not, so it has no value in the right-hand side. A name inside Except can be used only by tests inside that Except.", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["XMLCases issues a message for a malformed XMLPattern, such as one with a string pattern as a value:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<p class=\\\"col-6\\\">x</p>\",{\"HTML\",\"XMLObject\"}];
XMLCases[tree,XMLPattern[\"p\",\"classList\"->\"col-\"~~__]]"], "Input"],

Cell["XMLPattern::strpat: \"col-\"~~__ is a string pattern, and in an XMLPattern it does not match any string. Write _?(StringMatchQ[\"col-\"~~__]) instead.", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["Write a string test as a PatternTest:", "ExampleText"],

Cell[BoxData["XMLCases[tree,XMLPattern[\"p\",\"classList\"->_?(AnyTrue[StringStartsQ[\"col-\"]])]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"col-6\""}], "}"}], ",", RowBox[{"{", "\"x\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell[TextData[{"The count is a ceiling, so ", Cell[BoxData[ButtonBox["UpTo", BaseStyle -> "Link", ButtonData -> "paclet:ref/UpTo"]], "InlineFormula"], " is not accepted, as in ", Cell[BoxData[ButtonBox["StringCases", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringCases"]], "InlineFormula"], ":"}], "ExampleText"], Cell[BoxData["tree=XMLElement[\"ol\",{},{XMLElement[\"li\",{},{\"Miso\"}],XMLElement[\"li\",{},{\"Pho\"}]}];
XMLCases[tree,XMLPattern[\"li\"],UpTo[2]]"], "Input"],

Cell["XMLCases::innf: Non-negative integer or Infinity expected at position 3 in XMLCases[XMLElement[\"ol\", {}, {XMLElement[\"li\", {}, {\"Miso\"}], XMLElement[\"li\", {}, {\"Pho\"}]}], XMLPattern[\"li\"], UpTo[2]].", "Message", "MSG"],

Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"ol\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Miso\"", "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Pho\"", "}"}]}], "]"}]}], "}"}]}], "]"}], ",", RowBox[{"XMLPattern", "[", "\"li\"", "]"}], ",", RowBox[{"UpTo", "[", "2", "]"}]}], "]"}]], "Output"],

Cell["Give the count as an integer:", "ExampleText"],

Cell[BoxData["XMLCases[tree,XMLPattern[\"li\"],2]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Miso\"", "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Pho\"", "}"}]}], "]"}]}], "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Child, Adjacent and Sibling were removed in version 4, and a query that uses one issues a message:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<p><a href=\\\"/about\\\">About</a></p><ul><li><a href=\\\"/miso\\\">Miso</a></li></ul>\",{\"HTML\",\"XMLObject\"}];
XMLCases[tree,Child[XMLPattern[\"li\"],XMLPattern[\"a\"]]]"], "Input"],

Cell["XMLCases::badpat: The second argument should be a pattern, or a rule pattern -> rhs or pattern :> rhs. A pattern is an XMLPattern, which can take constraints on the elements below it, an XMLDocument pattern, an XMLElement pattern, or a CSS selector string, or alternatives of these, any of them named, with a condition pat /; test or a test pat?f. A CSS selector that looks above or beside the element it selects, such as \"nav a\", gives that element when given alone; on the left of a rule, name the element, as in n : \"nav a\" :> n. Child, Adjacent and Sibling were removed in version 4; nest the patterns as the document is: XMLPattern[\"ul\", _, {___, x : XMLPattern[\"li\"], ___}] :> x gives the li children of each ul, XMLPattern[\"nav\", _, Descendant[x : XMLPattern[\"a\"]]] :> x the links inside a nav, XMLPattern[_, _, {___, XMLPattern[\"h2\"], ___, x : XMLPattern[\"p\"], ___}] :> x each p after an h2 among its siblings, and XMLPattern[_, _, {___, XMLPattern[\"h2\"], x : XMLPattern[\"p\"], ___}] :> x each p right after one. Got Child[XMLPattern[\"li\"], XMLPattern[\"a\"]].", "Message", "MSG"],

Cell[BoxData["$Failed"], "Output"],

Cell["Nest the patterns as the document is, and name what to give:", "ExampleText"],

Cell[BoxData["XMLCases[tree,XMLPattern[\"li\",_,{___,x:XMLPattern[\"a\"],___}]:>x]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/miso\""}]}], "}"}], ",", RowBox[{"{", "\"Miso\"", "}"}]}], "]"}], "}"}]], "Output"]}, Open]]}, Open]],

