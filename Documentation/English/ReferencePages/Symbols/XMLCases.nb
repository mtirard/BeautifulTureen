Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Match links that are direct children of a list item:", "ExampleText"], Cell[BoxData["tree=ImportString[\"<p><a href=\\\"/about\\\">About</a></p><ul><li><a href=\\\"/miso\\\">Miso</a></li></ul>\",{\"HTML\",\"XMLObject\"}];
