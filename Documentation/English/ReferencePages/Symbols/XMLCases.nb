Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell[TextData[{"A name bound only in an alternative that did not match is ", Cell[BoxData[RowBox[{ButtonBox["Sequence", BaseStyle -> "Link", ButtonData -> "paclet:ref/Sequence"], "[", "]"}]], "InlineFormula"], ", and drops out of a list:"}], "ExampleText"], Cell[BoxData["page=ImportString[\"<section id=\\\"s\\\"><div id=\\\"d\\\"><p>x</p></div></section>\",{\"HTML\",\"XMLObject\"}];
