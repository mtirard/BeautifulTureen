(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["XMLCases", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives a list of the elements of ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " that match ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", in document order.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives the value of ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " once for each distinct combination of places in ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " matched by the names that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " uses.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"], ",", StyleBox["n", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives the first ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " results."}], "Usage"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " searches ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " at all depths. With a bare pattern, it gives the matches in ", StyleBox["document order", FontWeight->"Bold"], ": an element comes before the elements nested in it, and an earlier sibling and its contents come before a later sibling."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", as given by ", Cell[BoxData[RowBox[{ButtonBox["ImportString", BaseStyle -> "Link", ButtonData -> "paclet:ref/ImportString"], "[", RowBox[{StyleBox["source", "TI"], ",", RowBox[{"{", RowBox[{"\"HTML\"", ",", "\"XMLObject\""}], "}"}]}], "]"}]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", or a list of ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " objects."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern, which matches exactly as written, an ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " pattern, a CSS selector string such as ", Cell[BoxData["\"div.note > p\""], "InlineFormula"], ", or alternatives of these. Each can be named, as in ", Cell[BoxData["x : XMLPattern[\"p\"]"], "InlineFormula"], ", have a condition, as in ", Cell[BoxData["pattern$ /; test$"], "InlineFormula"], ", or have a test, as in ", Cell[BoxData["XMLPattern[\"p\"]?f$"], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"Patterns are nested as the document is. ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attrs", "TI"], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " takes constraints on what is below the element: a list pattern over its element children, such as ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "\"li\"", "]"}], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], ", or ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " for an element anywhere below."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches at its top element, the ", StyleBox["pattern root", FontWeight->"Bold"], ". The names inside it can be bound to elements below the root, to attribute values, to class tokens, etc."}], "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], " gives one result for each distinct combination of the places matched by the names that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " uses, outside its conditions:"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["``rhs$`` uses", "TableText"], FontSlant->"Italic"], StyleBox[Cell["results", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"one name ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"]}], "TableText"], Cell[TextData[{"one for each place ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"], " matched"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"names ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["y", "TR"]], "InlineFormula"]}], "TableText"], Cell[TextData[{"one for each pair of places ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["y", "TR"]], "InlineFormula"], " matched together"}], "TableText"]},
{Cell["      ", "ModInfo"], Cell["no name", "TableText"], Cell["at most one", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"A name that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " does not use is a test, which needs one match. Two equal values at different places, such as two equal ", Cell[BoxData[StyleBox["href", "TR"]], "InlineFormula"], " values, give two results."}], "Notes"],

Cell[TextData[{"A bare pattern gives each element that its pattern root matches, as ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " does. ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " is ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{"x : pattern$", "\[RuleDelayed]", StyleBox["x", "TR"]}]}], "]"}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"The results are ordered by the first name used, in document order, then by the next name, and so on. The order of the names is the order in which they appear in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", not in ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"A CSS selector string given as the whole pattern gives the elements it selects. A selector that matches its element by what is above or beside it, such as ", Cell[BoxData["\"nav a\""], "InlineFormula"], ", is named on the left of a rule, as in ", Cell[BoxData[RowBox[{"n : \"nav a\"", "\[RuleDelayed]", StyleBox["n", "TR"]}]], "InlineFormula"], "."}], "Notes"],

Cell[TextData[{"When ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " is an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", it can be the pattern root, but it is never itself a result. The root element of an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " and the elements of a list can be results."}], "Notes"],

Cell[TextData[{"A name for the whole element, as in ", Cell[BoxData["e : XMLPattern[\"p\"]"], "InlineFormula"], ", gives the element as it appears in ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], ", without ", StyleBox["list keys", FontWeight->"Bold"], " such as ", Cell[BoxData["\"classList\""], "InlineFormula"], ", which give an attribute split into a list of tokens."}], "Notes"],

Cell[TextData[{"A name used twice in one list, or once above and once below, must have equal values at both places, as in ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], ". A name for an element used in two constraints of one ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " must match the same child in both."}], "Notes"],

Cell[TextData[{"A name bound only in an alternative that did not match is ", Cell[BoxData[RowBox[{ButtonBox["Sequence", BaseStyle -> "Link", ButtonData -> "paclet:ref/Sequence"], "[", "]"}]], "InlineFormula"], ", as in ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], "."}], "Notes"],

Cell["A condition can use the names bound inside the pattern it is on, and the names bound before it in a pattern that contains it.", "Notes"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[Rule]", StyleBox["rhs", "TI"]}]}], "]"}]], "InlineFormula"], " evaluates ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " once, before any matching, as ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " does."}], "Notes"],

Cell[TextData[{"In ", Cell[BoxData[RowBox[{ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"], ",", StyleBox["n", "TI"]}], "]"}]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " is a non-negative integer or ", Cell[BoxData[ButtonBox["Infinity", BaseStyle -> "Link", ButtonData -> "paclet:ref/Infinity"]], "InlineFormula"], ". It is a ceiling: if there are fewer than ", Cell[BoxData[StyleBox["n", "TI"]], "InlineFormula"], " results, all of them are given. With ", Cell[BoxData[RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " is evaluated only for the results given."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " when ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " has none of the forms above, when an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is malformed, or when a name that ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " uses has no place, such as a name for text."}], "Notes"],

Cell[TextData[{"Child, Adjacent and Sibling were removed in version 4. Nest the patterns as the document is, and name what to give. With tags ", Cell[BoxData[StyleBox["a", "TI"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["b", "TI"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["c", "TI"]], "InlineFormula"], ":"}], "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["version 3", "TableText"], FontSlant->"Italic"], StyleBox[Cell["version 4", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], RowBox[{"Child", "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["a", "TI"], "]"}], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["b", "TI"], "]"}]}], "]"}], RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["a", "TI"], ",", StyleBox["_", "TR"], ",", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", "x : XMLPattern[b$]", ",", StyleBox["___", "TR"]}], "}"}]}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]},
{Cell["      ", "ModInfo"], RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["a", "TI"], "]"}], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["b", "TI"], "]"}]}], "]"}], RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["a", "TI"], ",", StyleBox["_", "TR"], ",", RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", "x : XMLPattern[b$]", "]"}]}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]},
{Cell["      ", "ModInfo"], RowBox[{"Adjacent", "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["a", "TI"], "]"}], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["b", "TI"], "]"}]}], "]"}], Cell[TextData[{Cell[BoxData[RowBox[{RowBox[{ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"], "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["_", "TR"], ",", StyleBox["_", "TR"], ",", StyleBox["l", "TI"]}], "]"}], ",", RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", StyleBox["l", "TI"], "]"}]}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]], "InlineFormula"], ", with ", Cell[BoxData[StyleBox["l", "TI"]], "InlineFormula"], " = ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["a", "TI"], "]"}], ",", "x : XMLPattern[b$]", ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{"Sibling", "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["a", "TI"], "]"}], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["b", "TI"], "]"}]}], "]"}], Cell[TextData[{"the same, with ", Cell[BoxData[StyleBox["l", "TI"]], "InlineFormula"], " = ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["a", "TI"], "]"}], ",", StyleBox["___", "TR"], ",", "x : XMLPattern[b$]", ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"]}], "TableText"]},
{Cell["      ", "ModInfo"], RowBox[{"Child", "[", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["a", "TI"], "]"}], ",", RowBox[{"{", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["c", "TI"], "]"}], ",", StyleBox["___", "TR"]}], "}"}]}], "]"}], RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["a", "TI"], ",", StyleBox["_", "TR"], ",", RowBox[{"{", RowBox[{"x : XMLPattern[c$]", ",", StyleBox["___", "TR"]}], "}"}]}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]},
{Cell["      ", "ModInfo"], RowBox[{"Child", "[", RowBox[{RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", "]"}], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["b", "TI"], "]"}]}], "]"}], RowBox[{RowBox[{ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"], "[", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", "x : XMLPattern[b$]", ",", StyleBox["___", "TR"]}], "}"}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}]}
}]], "2ColumnTableMod"],

Cell["The following option can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "\"AttributeReadings\"", StyleBox["<||>", "TR"], Cell[TextData[{"entries to add to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], " for this call, to split further attributes into lists of tokens"}], "TableText"]}
}]], "3ColumnTableMod"]
}, Open  ]],

