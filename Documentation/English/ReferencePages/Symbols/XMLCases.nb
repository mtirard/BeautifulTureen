Cell[BoxData[RowBox[{"{", "\"found\"", "}"}]], "Output"]}, Open]],

Cell[CellGroupData[{Cell[BoxData[InterpretationBox[Cell["\t", "ExampleDelimiter"], $Line = 0; Null]], "ExampleDelimiter"], Cell["Give each link inside a nav once, including a link inside two nav elements:", "ExampleText"], Cell[BoxData["navs=ImportString[\"<nav id=\\\"outer\\\"><a>Home</a><nav id=\\\"inner\\\"><a>News</a></nav><a>About</a></nav>\",{\"HTML\",\"XMLObject\"}];
