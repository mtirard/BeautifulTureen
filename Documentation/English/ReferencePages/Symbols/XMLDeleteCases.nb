End</footer></body></html>\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<HTML\>\"", ",", " ", "\"\<XMLObject\>\""}], "}"}]}], "]"}],
    ",", " ", 
   RowBox[{"XMLPattern", "[", 
