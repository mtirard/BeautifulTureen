Notebook[{

Cell[CellGroupData[{
Cell["XMLDeleteCases", "ObjectName"],

Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " \[LineSeparator]gives ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " with every element that matches ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " removed, at any depth.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", StyleBox["x", "TI"]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]removes, for every match of ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], ", the part that its name ", Cell[BoxData[StyleBox["x", "TI"]], "InlineFormula"], " is bound to.", "\n", Cell["   ", "ModInfo"], Cell[BoxData[RowBox[{ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", RowBox[{StyleBox["pattern", "TI"], "\[RuleDelayed]", RowBox[{"{", RowBox[{StyleBox["x", "TI"], ",", StyleBox["y", "TI"], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}]}]}], "]"}]], "InlineFormula"], " \[LineSeparator]removes the parts that each of the names is bound to."}], "Usage"],

Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"], "[", RowBox[{StyleBox["tree", "TI"], ",", StyleBox["pattern", "TI"]}], "]"}]], "InlineFormula"], " removes each element that ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " matches, at any depth, together with its contents. Text and whitespace between the remaining elements are kept."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " can be an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], ", or a list of elements and strings."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " can have any of the forms that ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " takes, such as an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " or a CSS selector string."}], "Notes"],

Cell[TextData[{"The right-hand side must be a name in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " or a list of names, and can have a ", Cell[BoxData[ButtonBox["Condition", BaseStyle -> "Link", ButtonData -> "paclet:ref/Condition"]], "InlineFormula"], ". Use ", Cell[BoxData[":>"], "InlineFormula"], " so that the names are not evaluated."}], "Notes"],

Cell[TextData[{"A ", StyleBox["list key", FontWeight->"Bold"], " is a key such as ", Cell[BoxData["\"classList\""], "InlineFormula"], ", whose value is a list of tokens taken from an attribute."}], "Notes"],

Cell["What is removed depends on what the name is bound to:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["name for", "TableText"], FontSlant->"Italic"], StyleBox[Cell["removes", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], Cell["an element", "TableText"], Cell["the element and its contents", "TableText"]},
{Cell["      ", "ModInfo"], Cell[TextData[{"a run of element children, such as ", Cell[BoxData["run___"], "InlineFormula"]}], "TableText"], Cell["the elements of the run; the text between them is kept", "TableText"]},
{Cell["      ", "ModInfo"], Cell["a gap between children", "TableText"], Cell["nothing", "TableText"]},
{Cell["      ", "ModInfo"], Cell["the attribute list", "TableText"], Cell["every attribute", "TableText"]},
{Cell["      ", "ModInfo"], Cell["an attribute value", "TableText"], Cell["the attribute", "TableText"]},
{Cell["      ", "ModInfo"], Cell["the tokens of a list key", "TableText"], Cell["the whole attribute", "TableText"]},
{Cell["      ", "ModInfo"], Cell["one token of a list key", "TableText"], Cell["the token; the attribute is kept, even when empty", "TableText"]},
{Cell["      ", "ModInfo"], Cell["a run of tokens of a list key", "TableText"], Cell["the tokens", "TableText"]},
{Cell["      ", "ModInfo"], Cell["the contents of an element", "TableText"], Cell["all its contents, text included", "TableText"]}
}]], "2ColumnTableMod"],

Cell[TextData[{"A name for a tag, for the document, or on a ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], " constraint, as in ", Cell[BoxData["path : Descendant[XMLPattern[\"a\"]]"], "InlineFormula"], ", cannot be deleted, and gives a message."}], "Notes"],

Cell[TextData[{"Every match is found in the original ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " before anything is removed, so removing an element does not change whether its parent or an earlier sibling matches."}], "Notes"],

Cell[TextData[{Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " itself, and the root element of an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], ", are never removed."}], "Notes"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"]], "InlineFormula"], " issues a message and returns ", Cell[BoxData[ButtonBox["$Failed", BaseStyle -> "Link", ButtonData -> "paclet:ref/$Failed"]], "InlineFormula"], " when ", Cell[BoxData[StyleBox["tree", "TI"]], "InlineFormula"], " or ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " has none of the forms above, when an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " in ", Cell[BoxData[StyleBox["pattern", "TI"]], "InlineFormula"], " is malformed, or when a name on the right-hand side has no position, such as a name for text."}], "Notes"],

Cell["The following option can be given:", "Notes"],

Cell[BoxData[GridBox[{
{Cell["      ", "ModInfo"], StyleBox[Cell["option", "TableText"], FontSlant->"Italic"], StyleBox[Cell["default", "TableText"], FontSlant->"Italic"], StyleBox[Cell["description", "TableText"], FontSlant->"Italic"]},
{Cell["      ", "ModInfo"], "\"AttributeReadings\"", StyleBox["<||>", "TR"], Cell[TextData[{"attributes to split into lists of tokens for this call, in addition to ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"]}], "TableText"]}
}]], "3ColumnTableMod"]
}, Open  ]],

