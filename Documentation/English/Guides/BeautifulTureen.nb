(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["BeautifulTureen", "GuideTitle"],

Cell[TextData[{"BeautifulTureen selects elements from imported HTML and XML by pattern and extracts their text. An element is described by an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " over its tag and attribute map, in which the list key \"classList\" matches the class list; patterns are composed with the structural combinators ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineFormula"], ", and ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineFormula"], ", which nest as a CSS selector does, and are matched against a tree with ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], ", and ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ", or against a single element with ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " turn matched elements into raw or readable text, ", Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " gives an element's classes, and ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], " converts a whole tree into a notebook for export to Markdown, PDF, or RTF. Together they bring BeautifulSoup-style ergonomics to the Wolfram Language. In version 2.0.0, ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " became inert, so that ", Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " no longer interpret it; results come in document order; and ", Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], " was removed in favor of the \"classList\" key."}], "GuideAbstract"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection"],

Cell[CellGroupData[{Cell["Selecting Elements", "GuideFunctionsSubsection"], Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineGuideFunction"], " \[LongDash] find all elements of a tree matching a pattern, at any depth, in document order"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineGuideFunction"], " \[LongDash] give the first matching element in document order, stopping early"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineGuideFunction"], " \[LongDash] remove every element matching a pattern from a tree"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineGuideFunction"], " \[LongDash] test whether a single element matches an XML pattern"}], "GuideText"]}, Open]],

Cell["\t", "GuideDelimiter"],

Cell[CellGroupData[{Cell["Building Patterns", "GuideFunctionsSubsection"], Cell[TextData[{Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineGuideFunction"], " \[LongDash] an inert pattern for an element's tag and attribute map, interpreted by the XML* functions"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/$AttributeReadings"]], "InlineGuideFunction"], " \[LongDash] readings that split an attribute into a token list, reached through a list key such as \"classList\""}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLWhitespace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLWhitespace"]], "InlineGuideFunction"], " \[LongDash] the HTML whitespace delimiter a class attribute is split on"}], "GuideText"]}, Open]],

Cell["\t", "GuideDelimiter"],

Cell[CellGroupData[{Cell["Combinators", "GuideFunctionsSubsection"], Cell[TextData[{Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineGuideFunction"], " \[LongDash] match elements that are direct children of another match"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineGuideFunction"], " \[LongDash] match elements nested anywhere below another match"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineGuideFunction"], " \[LongDash] match an element immediately following a sibling match"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineGuideFunction"], " \[LongDash] match elements following a sibling match"}], "GuideText"]}, Open]],

Cell["\t", "GuideDelimiter"],

Cell[CellGroupData[{Cell["Extracting Content", "GuideFunctionsSubsection"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineGuideFunction"], " \[LongDash] extract the raw, lossless text content of a tree"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineGuideFunction"], " \[LongDash] extract readable text, with whitespace collapsed, blocks on their own lines, and scripts dropped"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineGuideFunction"], " \[LongDash] convert a tree into a notebook, for export to Markdown, PDF, RTF, or display"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineGuideFunction"], " \[LongDash] give the class list of an element"}], "GuideText"]}, Open]],

Cell["\t", "GuideDelimiter"],

Cell[CellGroupData[{Cell["Obsolete", "GuideFunctionsSubsection"], Cell[TextData[{Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineGuideFunction"], " \[LongDash] removed in 2.0.0; match classes with the \"classList\" key of XMLPattern"}], "GuideText"]}, Open]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tech Notes", "GuideTutorialsSection"],

Cell[TextData[ButtonBox["Scraping HTML with BeautifulTureen", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/tutorial/ScrapingHTMLWithBeautifulTureen"]], "GuideTutorial"],

Cell["XXXX", "GuideTutorial"]
}, Open  ]],

