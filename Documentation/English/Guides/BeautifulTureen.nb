(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["BeautifulTureen", "GuideTitle"],

Cell[TextData[{"BeautifulTureen selects elements from imported HTML and XML by pattern and extracts their text. Element patterns are built with ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineFormula"], ", composed with the structural combinators ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineFormula"], ", and ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineFormula"], ", and matched against a tree with ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], ", and ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " turn matched elements into raw or readable text, and ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], " converts a whole tree into a notebook for export to Markdown, PDF, or RTF. Together they bring BeautifulSoup-style ergonomics to the Wolfram Language."}], "GuideAbstract"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection"],

Cell[CellGroupData[{Cell["Selecting Elements", "GuideFunctionsSubsection"], Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineGuideFunction"], " \[LongDash] find all elements of a tree matching a pattern, at any depth"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineGuideFunction"], " \[LongDash] give the first matching element, short-circuiting on the first hit"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineGuideFunction"], " \[LongDash] remove every element matching a pattern from a tree"}], "GuideText"]}, Open]],

Cell["\t", "GuideDelimiter"],

Cell[CellGroupData[{Cell["Building Patterns", "GuideFunctionsSubsection"], Cell[TextData[{Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineGuideFunction"], " \[LongDash] construct an ", Cell[BoxData[TemplateBox[{Cell[TextData["XMLElement"]], "paclet:ref/XMLElement"}, "RefLink", BaseStyle->{"InlineFormula"}]], "InlineFormula"], " pattern from a tag and attribute constraints"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["CSSClass", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/CSSClass"]], "InlineGuideFunction"], " \[LongDash] constrain an element by the classes in its ", Cell[BoxData["class"], "InlineFormula"], " attribute"}], "GuideText"]}, Open]],

Cell["\t", "GuideDelimiter"],

Cell[CellGroupData[{Cell["Combinators", "GuideFunctionsSubsection"], Cell[TextData[{Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineGuideFunction"], " \[LongDash] match elements that are direct children of another match"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineGuideFunction"], " \[LongDash] match elements nested anywhere below another match"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineGuideFunction"], " \[LongDash] match an element immediately following a sibling match"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineGuideFunction"], " \[LongDash] match elements following a sibling match"}], "GuideText"]}, Open]],

Cell["\t", "GuideDelimiter"],

Cell[CellGroupData[{Cell["Extracting Content", "GuideFunctionsSubsection"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineGuideFunction"], " \[LongDash] extract the raw, lossless text content of a tree"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineGuideFunction"], " \[LongDash] extract readable text, with whitespace collapsed, blocks on their own lines, and scripts dropped"}], "GuideText"],

Cell[TextData[{Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineGuideFunction"], " \[LongDash] convert a tree into a notebook, for export to Markdown, PDF, RTF, or display"}], "GuideText"]}, Open]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tech Notes", "GuideTutorialsSection"],

Cell[TextData[ButtonBox["Scraping HTML with BeautifulTureen", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/tutorial/ScrapingHTMLWithBeautifulTureen"]], "GuideTutorial"],

Cell["XXXX", "GuideTutorial"]
}, Open  ]],

