Cell["Related Guides", "GuideMoreAboutSection"],

Cell["XXXX", "GuideMoreAbout"],

Cell["XXXX", "GuideMoreAbout"]
}, Open  ]],

Cell[CellGroupData[{Cell["Related Links", "GuideRelatedLinksSection"], Cell[TextData[ButtonBox["BeautifulTureen on GitHub", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://github.com/mtirard/BeautifulTureen"], None}]], "GuideRelatedLinks"]}, Open]],

