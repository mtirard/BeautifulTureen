411134378161, 0.574096681253161], AbsoluteThickness[1], Opacity[1]], RoundingRadius -> 0, FrameMargins -> {{2, 2}, {1, 1}}, ImageSize -> Automatic, StripOnInput -> False], StandardForm]], {1.6514456476895423, -0.9671716823950467}], "DynamicName", BoxID -> "VertexID$26"]}}]]], {AlignmentPoint -> Center, Axes -> False, AxesLabel -> None, AxesOrigin -> Automatic, AxesStyle -> {}, Background -> None, BaselinePosition -> Automatic, BaseStyle -> {FontFamily -> "Arial"}, ContentSelectable -> Automatic, Epilog -> {}, FormatType -> StandardForm, Frame -> False, FrameLabel -> None, FrameStyle -> {}, FrameTicks -> Automatic, FrameTicksStyle -> {}, GridLines -> None, GridLinesStyle -> {}, ImageMargins -> 0., ImagePadding -> All, ImageSize -> {683, 240}, LabelStyle -> {}, PlotLabel -> None, PlotRange -> All, PlotRangeClipping -> False, PlotRangePadding -> Automatic, PlotRegion -> Automatic, Prolog -> {}, RotateLabel -> True, Ticks -> Automatic, TicksStyle -> {}}, DefaultBaseStyle -> "TreeGraphics"]], "Output"],
Cell[TextData[{"The tree is an ordinary Wolfram Language expression. Each element is an ", Cell[BoxData[RowBox[{ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attributes", "TI"], ",", StyleBox["children", "TI"]}], "]"}]], "InlineFormula"], ": its tag name, its attributes as a list of rules, and its contents as a list. The contents hold the text of the element as strings and the elements nested in it as further ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " expressions, in source order. The whole tree is wrapped in ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"], "[", "\"Document\"", "]"}], "[", StyleBox["\[Ellipsis]", "TR"], "]"}]], "InlineFormula"], ", which also holds the XML declaration."}], "Text"],
Cell[TextData[{"The import made a few changes to the source. The ", Cell[BoxData[StyleBox["article", "TR"]], "InlineFormula"], " element has an ", Cell[BoxData[StyleBox["xmlns", "TR"]], "InlineFormula"], " attribute, which identifies the markup as XHTML. Each ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " element has an extra ", Cell[BoxData[RowBox[{"\"\<\!\(\*StyleBox[\"shape\", \"TI\"]\)\>\"", "\[Rule]", "\"\<\!\(\*StyleBox[\"rect\", \"TI\"]\)\>\""}]], "InlineFormula"], " attribute. The indentation of the source is kept, as strings between the elements, but ", Cell[BoxData[ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"]], "InlineFormula"], " leaves those strings out."}], "Text"],
Cell[TextData[{"Because the tree is an ordinary expression, the standard ", ButtonBox["pattern language", BaseStyle -> "Link", ButtonData -> "tutorial/Patterns"], " applies to it. List the tags in the document with ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " and the three-argument ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " form:"}], "Text"],
Cell[BoxData[RowBox[{"Union", "[", RowBox[{"Cases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"tag_", ",", "_", ",", "_"}], "]"}], ":>", "tag"}], ",", "Infinity"}], "]"}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"a\"", ",", "\"article\"", ",", "\"b\"", ",", "\"h1\"", ",", "\"li\"", ",", "\"nav\"", ",", "\"p\"", ",", "\"script\"", ",", "\"ul\""}], "}"}]], "Output"],
Cell[TextData[{"Elements can be nested at any depth, so this needs the level specification ", Cell[BoxData[ButtonBox["Infinity", BaseStyle -> "Link", ButtonData -> "paclet:ref/Infinity"]], "InlineFormula"], ". Without it, ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " matches only at level 1 of the document, which holds the ", Cell[BoxData[StyleBox["article", "TR"]], "InlineFormula"], " element:"}], "Text"],
Cell[BoxData["Cases[tree, XMLElement[tag_, _, _] :> tag]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"article\"", "}"}]], "Output"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " give a shorter form. ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " searches the whole tree, so it needs no level specification, and ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "tag_", "]"}]], "InlineFormula"], " matches any element, as ", Cell[BoxData[RowBox[{ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"], "[", RowBox[{"tag_", ",", StyleBox["_", "TR"], ",", StyleBox["_", "TR"]}], "]"}]], "InlineFormula"], " does:"}], "Text"],
Cell[BoxData[RowBox[{"Union", "[", RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", "tag_", "]"}], ":>", "tag"}]}], "]"}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"a\"", ",", "\"article\"", ",", "\"b\"", ",", "\"h1\"", ",", "\"li\"", ",", "\"nav\"", ",", "\"p\"", ",", "\"script\"", ",", "\"ul\""}], "}"}]], "Output"]}, Open]],
Cell[CellGroupData[{Cell["Selecting Elements", "Section"],
Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["tag", "TI"], "]"}]], "InlineFormula"], " matches any element with the tag ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], ". ", Cell[BoxData[StyleBox["tag", "TI"]], "InlineFormula"], " can be a string, alternatives such as ", Cell[BoxData["\"ul\" | \"li\""], "InlineFormula"], ", or a pattern such as ", Cell[BoxData[StyleBox["_", "TR"]], "InlineFormula"], ". ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attrs", "TI"]}], "]"}]], "InlineFormula"], " also matches the attributes of the element. ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " has one of these forms:"}], "Text"],
Cell[BoxData[GridBox[{
   {StyleBox["key", "TI"], Cell[
    TextData[{"has the attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"]}], "TableText"]},
   {RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}], Cell[
    TextData[{"has the attribute ", Cell[BoxData[StyleBox["key", "TI"]], "InlineFormula"], ", with a value that matches ", Cell[BoxData[StyleBox["val", "TI"]], "InlineFormula"]}], "TableText"]},
   {RowBox[{"{", RowBox[{SubscriptBox[StyleBox["a", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["a", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "}"}], Cell[
    TextData[{"matches every ", Cell[BoxData[SubscriptBox[StyleBox["a", "TI"], StyleBox["i", "TI"]]], "InlineFormula"]}], "TableText"]}
  }]], "DefinitionBox"],
Cell[TextData[{"The element can have other attributes as well. As with ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], ", a rule ", Cell[BoxData[RowBox[{StyleBox["patt", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]], "InlineFormula"], " gives a result computed from each match. Get the targets of the links:"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"a\"", ",", RowBox[{"\"href\"", "->", "target_"}]}], "]"}], ":>", "target"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/menu\"", ",", "\"/hours\"", ",", "\"/miso\"", ",", "\"/pho\"", ",", "\"/ramen\""}], "}"}]], "Output"],
Cell[TextData[{"The rule ", Cell[BoxData[RowBox[{"\"href\"", "\[Rule]", "target_"}]], "InlineFormula"], " matches only elements that have an ", Cell[BoxData["\"\<\!\(\*StyleBox[\"href\", \"TI\"]\)\>\""], "InlineFormula"], " attribute, and binds ", Cell[BoxData[StyleBox["target", "TR"]], "InlineFormula"], " to its value. A key on its own matches by the attribute alone. Get the tags of the elements that have a ", Cell[BoxData["\"\<\!\(\*StyleBox[\"class\", \"TI\"]\)\>\""], "InlineFormula"], " attribute:"}], "Text"],
Cell[BoxData["XMLCases[tree, XMLPattern[tag_, \"class\"] :> tag]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"p\"", ",", "\"nav\"", ",", "\"ul\"", ",", "\"li\""}], "}"}]], "Output"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " gives its matches in document order, the order in which their start tags appear in the source, as ", Cell[BoxData[StyleBox["querySelectorAll", "TR"]], "InlineFormula"], " does in a browser. So an element comes before the elements nested in it. ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " gives the elements nested in an element before the element itself. Compare the two on the ", Cell[BoxData[StyleBox["ul", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " elements, matched with the alternatives ", Cell[BoxData["\"ul\" | \"li\""], "InlineFormula"], ":"}], "Text"],
Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"Cases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLElement", "[", RowBox[{RowBox[{"tag", ":", RowBox[{"\"ul\"", "|", "\"li\""}]}], ",", "_", ",", "_"}], "]"}], ":>", "tag"}], ",", "Infinity"}], "]"}], ",", RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"tag", ":", RowBox[{"\"ul\"", "|", "\"li\""}]}], "]"}], ":>", "tag"}]}], "]"}]}], "}"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"li\"", ",", "\"li\"", ",", "\"li\"", ",", "\"ul\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"ul\"", ",", "\"li\"", ",", "\"li\"", ",", "\"li\""}], "}"}]}], "}"}]], "Output"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFirstCase"]], "InlineFormula"], " gives the first match in document order, or ", Cell[BoxData[RowBox[{ButtonBox["Missing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Missing"], "[", "\"NotFound\"", "]"}]], "InlineFormula"], " if there is none. A third argument sets a different default. Get the lead paragraph by its ", Cell[BoxData["\"\<\!\(\*StyleBox[\"class\", \"TI\"]\)\>\""], "InlineFormula"], " attribute:"}], "Text"],
Cell[BoxData[RowBox[{"XMLFirstCase", "[", RowBox[{"tree", ",", RowBox[{"XMLPattern", "[", RowBox[{"\"p\"", ",", RowBox[{"\"class\"", "->", "\"lead\""}]}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"Seasonal \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"b\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"bowls\"", "}"}]}], "]"}], ",", "\", made to order.\""}], "}"}]}], "]"}]], "Output"]}, Open]],
Cell[CellGroupData[{Cell["Matching Classes", "Section"],
Cell[TextData[{"That worked because the paragraph has only one class. HTML puts all the classes of an element into one ", Cell[BoxData["\"\<\!\(\*StyleBox[\"class\", \"TI\"]\)\>\""], "InlineFormula"], " attribute, separated by spaces, and an attribute rule matches the whole value. So ", Cell[BoxData[RowBox[{"\"class\"", "\[Rule]", "\"menu\""}]], "InlineFormula"], " does not match the ", Cell[BoxData[StyleBox["nav", "TR"]], "InlineFormula"], ", whose ", Cell[BoxData["\"\<\!\(\*StyleBox[\"class\", \"TI\"]\)\>\""], "InlineFormula"], " attribute is ", Cell[BoxData["\"menu compact\""], "InlineFormula"], ". To match one class among several, use the key ", Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], "InlineFormula"], " instead:"}], "Text"],
Cell[BoxData["{XMLFirstCase[tree, XMLPattern[tag_, \"class\" -> \"menu\"] :> tag], XMLFirstCase[tree, XMLPattern[tag_, \"classList\" -> \"menu\"] :> tag]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"Missing", "[", "\"NotFound\"", "]"}], ",", "\"nav\""}], "}"}]], "Output"],
Cell[TextData[{"The value at ", Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], "InlineFormula"], " is the list of the classes of the element, which is ", Cell[BoxData[RowBox[{"{", "}"}]], "InlineFormula"], " for an element without a ", Cell[BoxData["\"\<\!\(\*StyleBox[\"class\", \"TI\"]\)\>\""], "InlineFormula"], " attribute. ", Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLClassList"]], "InlineFormula"], " gives the same list:"}], "Text"],
Cell[BoxData[RowBox[{"HTMLClassList", "/@", RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{"XMLPattern", "[", RowBox[{"\"nav\"", "|", "\"ul\"", "|", "\"li\""}], "]"}]}], "]"}]}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"menu\"", ",", "\"compact\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"menu\"", ",", "\"specials\""}], "}"}], ",", RowBox[{"{", "\"specials\"", "}"}], ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "}"}]}], "}"}]], "Output"],
Cell[TextData[{"The value at ", Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], "InlineFormula"], " is a pattern matched against the whole list, except that a string, or alternatives of strings, matches one class among the others. So ", Cell[BoxData[RowBox[{"\"classList\"", "\[Rule]", "\"menu\""}]], "InlineFormula"], " selects the same elements as ", Cell[BoxData[RowBox[{"\"classList\"", "\[Rule]", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", "\"menu\"", ",", StyleBox["___", "TR"]}], "}"}]}]], "InlineFormula"], ":"}], "Text"],
Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"tag_", ",", RowBox[{"\"classList\"", "->", "\"menu\""}]}], "]"}], ":>", "tag"}]}], "]"}], ",", RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"tag_", ",", RowBox[{"\"classList\"", "->", RowBox[{"{", RowBox[{"___", ",", "\"menu\"", ",", "___"}], "}"}]}]}], "]"}], ":>", "tag"}]}], "]"}]}], "}"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"nav\"", ",", "\"ul\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"nav\"", ",", "\"ul\""}], "}"}]}], "}"}]], "Output"],
Cell[TextData[{"A list pattern depends on the order of the classes. ", Cell[BoxData[RowBox[{"{", RowBox[{"\"specials\"", ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], " matches the ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], ", whose first class is ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], ", but not the ", Cell[BoxData[StyleBox["ul", "TR"]], "InlineFormula"], ":"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"tag_", ",", RowBox[{"\"classList\"", "->", RowBox[{"{", RowBox[{"\"specials\"", ",", "___"}], "}"}]}]}], "]"}], ":>", "tag"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", "\"li\"", "}"}]], "Output"],
Cell[TextData[{"To check membership in any order, use ", Cell[BoxData[ButtonBox["MemberQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MemberQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsAll", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAll"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsAny", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAny"]], "InlineFormula"], ", etc. in a ", Cell[BoxData[ButtonBox["PatternTest", BaseStyle -> "Link", ButtonData -> "paclet:ref/PatternTest"]], "InlineFormula"], ". Find the elements that have both the class ", Cell[BoxData["\"\<\!\(\*StyleBox[\"menu\", \"TI\"]\)\>\""], "InlineFormula"], " and the class ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], ":"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"tag_", ",", RowBox[{"\"classList\"", "->", RowBox[{"_", "?", RowBox[{"(", RowBox[{"ContainsAll", "[", RowBox[{"{", RowBox[{"\"menu\"", ",", "\"specials\""}], "}"}], "]"}], ")"}]}]}]}], "]"}], ":>", "tag"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", "\"ul\"", "}"}]], "Output"],
Cell[TextData[{"To combine several tests on the classes, name the list and test it in a ", Cell[BoxData[ButtonBox["Condition", BaseStyle -> "Link", ButtonData -> "paclet:ref/Condition"]], "InlineFormula"], ". Find the elements that have the class ", Cell[BoxData["\"\<\!\(\*StyleBox[\"menu\", \"TI\"]\)\>\""], "InlineFormula"], " or ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], " but not ", Cell[BoxData["\"\<\!\(\*StyleBox[\"compact\", \"TI\"]\)\>\""], "InlineFormula"], ", which the CSS selector ", Cell[BoxData["\":is(.menu, .specials):not(.compact)\""], "InlineFormula"], " also selects:"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"tag_", ",", RowBox[{"\"classList\"", "->", RowBox[{"c_", "/;", RowBox[{RowBox[{"ContainsAny", "[", RowBox[{"c", ",", RowBox[{"{", RowBox[{"\"menu\"", ",", "\"specials\""}], "}"}]}], "]"}], "&&", RowBox[{"FreeQ", "[", RowBox[{"c", ",", "\"compact\""}], "]"}]}]}]}]}], "]"}], ":>", "tag"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"ul\"", ",", "\"li\""}], "}"}]], "Output"],
Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", "\"compact\"", "]"}]], "InlineFormula"], " excludes nothing, because a list of classes is never the string ", Cell[BoxData["\"\<\!\(\*StyleBox[\"compact\", \"TI\"]\)\>\""], "InlineFormula"], ". Use ", Cell[BoxData[ButtonBox["FreeQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/FreeQ"]], "InlineFormula"], " to exclude a class:"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{RowBox[{"tag", ":", RowBox[{"\"nav\"", "|", "\"ul\""}]}], ",", RowBox[{"\"classList\"", "->", RowBox[{"Except", "[", "\"compact\"", "]"}]}]}], "]"}], ":>", "tag"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"nav\"", ",", "\"ul\""}], "}"}]], "Output"],
Cell[TextData[{"Other attributes that hold a list of tokens, such as ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], ", can be split in the same way with ", Cell[BoxData[ButtonBox["$AttributeReadings", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/$AttributeReadings"]], "InlineFormula"], "."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Testing One Element", "Section"],
Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"], "[", RowBox[{StyleBox["elem", "TI"], ",", RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", StyleBox["\[Ellipsis]", "TR"], "]"}]}], "]"}]], "InlineFormula"], " is ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], " for every element, as ", Cell[BoxData[RowBox[{ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"], "[", RowBox[{StyleBox["string", "TI"], ",", "\"col-\" ~~ __"}], "]"}]], "InlineFormula"], " is for every string. To test a single element, use ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], ", as you use ", Cell[BoxData[ButtonBox["StringMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringMatchQ"]], "InlineFormula"], " for a string:"}], "Text"],
Cell[BoxData[{RowBox[{RowBox[{"lead", "=", RowBox[{"XMLFirstCase", "[", RowBox[{"tree", ",", RowBox[{"XMLPattern", "[", "\"p\"", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", RowBox[{"{", RowBox[{RowBox[{"MatchQ", "[", RowBox[{"lead", ",", RowBox[{"XMLPattern", "[", "\"p\"", "]"}]}], "]"}], ",", RowBox[{"XMLMatchQ", "[", RowBox[{"lead", ",", RowBox[{"XMLPattern", "[", RowBox[{"\"p\"", ",", RowBox[{"\"classList\"", "->", "\"lead\""}]}], "]"}]}], "]"}]}], "}"}]}], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"False", ",", "True"}], "}"}]], "Output"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLMatchQ"]], "InlineFormula"], " has an operator form, for use with ", Cell[BoxData[ButtonBox["Select", BaseStyle -> "Link", ButtonData -> "paclet:ref/Select"]], "InlineFormula"], ". Select the list items that have no class:"}], "Text"],
Cell[BoxData[RowBox[{"Select", "[", RowBox[{RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{"XMLPattern", "[", "\"li\"", "]"}]}], "]"}], ",", RowBox[{"XMLMatchQ", "[", RowBox[{"XMLPattern", "[", RowBox[{"\"li\"", ",", RowBox[{"\"classList\"", "->", RowBox[{"{", "}"}]}]}], "]"}], "]"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/pho\""}]}], "}"}], ",", RowBox[{"{", "\"Pho\"", "}"}]}], "]"}], "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/ramen\""}]}], "}"}], ",", RowBox[{"{", "\"Ramen (sold out)\"", "}"}]}], "]"}], "}"}]}], "]"}]}], "}"}]], "Output"]}, Open]],
Cell[CellGroupData[{Cell["Nested Patterns", "Section"],
Cell[TextData[{"An ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " matches an element wherever it is in the tree. To also match what is below an element, give ", StyleBox["constraints", FontSlant->"Italic"], " in a second bracket: ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", StyleBox["attrs", "TI"]}], "]"}], "[", RowBox[{SubscriptBox[StyleBox["c", "TI"], StyleBox["1", "TR"]], ",", SubscriptBox[StyleBox["c", "TI"], StyleBox["2", "TR"]], ",", StyleBox["\[Ellipsis]", "TR"]}], "]"}]], "InlineFormula"], " matches an element for which every constraint ", Cell[BoxData[SubscriptBox[StyleBox["c", "TI"], StyleBox["i", "TI"]]], "InlineFormula"], " holds."}], "Text"],
Cell[CellGroupData[{Cell["Child and Descendant", "Subsection"], Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " holds if a child element of the element matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], ", as the CSS pseudo-class ", Cell[BoxData["\":has(> p)\""], "InlineFormula"], " does. ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", StyleBox["p", "TI"], "]"}]], "InlineFormula"], " holds if an element at any depth below matches ", Cell[BoxData[StyleBox["p", "TI"]], "InlineFormula"], ", as ", Cell[BoxData["\":has(p)\""], "InlineFormula"], " does. To get an element below, name it, and use the name on the right-hand side of the rule. Get the targets of the links inside the ", Cell[BoxData[StyleBox["ul", "TR"]], "InlineFormula"], " list, which leaves out the links in the ", Cell[BoxData[StyleBox["nav", "TR"]], "InlineFormula"], ":"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"ul\"", ",", RowBox[{"\"classList\"", "->", "\"menu\""}]}], "]"}], "[", RowBox[{"Descendant", "[", RowBox[{"XMLPattern", "[", RowBox[{"\"a\"", ",", RowBox[{"\"href\"", "->", "target_"}]}], "]"}], "]"}], "]"}], ":>", "target"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/miso\"", ",", "\"/pho\"", ",", "\"/ramen\""}], "}"}]], "Output"],
Cell[TextData[{"The CSS selector ", Cell[BoxData["\"ul.menu a\""], "InlineFormula"], " selects the same ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " elements. A selector gives the last element in it, and a pattern gives what the names on the right-hand side are bound to."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Choosing What Is Returned", "Subsection"], Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases"]], "InlineFormula"], " gives one result for each element or value that the names on the right-hand side are bound to, or for each combination when there are several names, in document order. Name the ", Cell[BoxData[StyleBox["ul", "TR"]], "InlineFormula"], " instead, and the same pattern gives one result, not one for each link in the list:"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{"ul", ":", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"ul\"", ",", RowBox[{"\"classList\"", "->", "\"menu\""}]}], "]"}], "[", RowBox[{"Descendant", "[", RowBox[{"XMLPattern", "[", RowBox[{"\"a\"", ",", RowBox[{"\"href\"", "->", "_"}]}], "]"}], "]"}], "]"}]}], ":>", RowBox[{"HTMLClassList", "[", "ul", "]"}]}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{"\"menu\"", ",", "\"specials\""}], "}"}], "}"}]], "Output"],
Cell[TextData[{"Here the name ", Cell[BoxData[StyleBox["ul", "TR"]], "InlineFormula"], " is bound to one element, so there is one result."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Order Among Siblings", "Subsection"], Cell[TextData[{"A ", StyleBox["list pattern", FontSlant->"Italic"], ", such as ", Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "\"li\"", "]"}], ",", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], ", is a constraint matched against the list of child elements, without the text between them. It matches the order of the children, as the CSS combinators ", Cell[BoxData["+"], "InlineFormula"], " and ", Cell[BoxData["~"], "InlineFormula"], " do. To find an element by the element before it, match their parent. Get the paragraph that immediately follows the ", Cell[BoxData[StyleBox["h1", "TR"]], "InlineFormula"], " heading:"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{RowBox[{"XMLPattern", "[", "_", "]"}], "[", RowBox[{"{", RowBox[{"___", ",", RowBox[{"XMLPattern", "[", "\"h1\"", "]"}], ",", RowBox[{"p", ":", RowBox[{"XMLPattern", "[", "\"p\"", "]"}]}], ",", "___"}], "}"}], "]"}], ":>", "p"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"Seasonal \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"b\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"bowls\"", "}"}]}], "]"}], ",", "\", made to order.\""}], "}"}]}], "]"}], "}"}]], "Output"],
Cell[TextData[{"With ", Cell[BoxData[StyleBox["___", "TR"]], "InlineFormula"], " between ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "\"h1\"", "]"}]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["p", "TR"]], "InlineFormula"], ", the pattern would match a paragraph anywhere after the heading, as ", Cell[BoxData["\"h1 ~ p\""], "InlineFormula"], " does."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Conditions across Levels", "Subsection"], Cell[TextData[{"Constraints nest as the elements do: a pattern in a constraint can have constraints of its own. A ", Cell[BoxData[ButtonBox["Condition", BaseStyle -> "Link", ButtonData -> "paclet:ref/Condition"]], "InlineFormula"], " on an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " can use the names in that pattern and in the patterns below it, but not the names in the patterns above it. Find the links in list items that share a class with their list:"}], "Text"],
Cell[BoxData[RowBox[{"XMLCases", "[", RowBox[{"tree", ",", RowBox[{RowBox[{RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"ul\"", ",", RowBox[{"\"classList\"", "->", "outer_"}]}], "]"}], "[", RowBox[{"Child", "[", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"li\"", ",", RowBox[{"\"classList\"", "->", "inner_"}]}], "]"}], "[", RowBox[{"Child", "[", RowBox[{"XMLPattern", "[", RowBox[{"\"a\"", ",", RowBox[{"\"href\"", "->", "target_"}]}], "]"}], "]"}], "]"}], "]"}], "]"}], "/;", RowBox[{"IntersectingQ", "[", RowBox[{"outer", ",", "inner"}], "]"}]}], ":>", "target"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"{", "\"/miso\"", "}"}]], "Output"],
Cell[TextData[{"Only the ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], " item shares a class with its list. The condition is on the ", Cell[BoxData[StyleBox["ul", "TR"]], "InlineFormula"], " pattern, the one that contains both ", Cell[BoxData[StyleBox["outer", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["inner", "TR"]], "InlineFormula"], "."}], "Text"]}, Open]]}, Open]],
Cell[CellGroupData[{Cell["Using CSS Selectors", "Section"], Cell[TextData[{"A CSS selector string can be given wherever a pattern goes. Get the links in the list with the class ", Cell[BoxData["\"\<\!\(\*StyleBox[\"menu\", \"TI\"]\)\>\""], "InlineFormula"], ":"}], "Text"],
Cell[BoxData["XMLCases[tree, \"ul.menu a\"]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/miso\""}]}], "}"}], ",", RowBox[{"{", "\"Miso\"", "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/pho\""}]}], "}"}], ",", RowBox[{"{", "\"Pho\"", "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/ramen\""}]}], "}"}], ",", RowBox[{"{", "\"Ramen (sold out)\"", "}"}]}], "]"}]}], "}"}]], "Output"],
Cell[TextData[{"A CSS selector for one element depends only on its element and what is below it, such as ", Cell[BoxData["\"nav.menu\""], "InlineFormula"], " or ", Cell[BoxData["\"ul:has(> li)\""], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " gives its pattern. Other selectors depend on what is above or beside their element, such as ", Cell[BoxData["\"ul.menu a\""], "InlineFormula"], ". Their pattern also matches the elements above, so give ", Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " a name for the element they select:"}], "Text"],
Cell[BoxData["{FromCSSSelector[\"nav.menu\"], FromCSSSelector[x : \"ul.menu a\"]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"nav\"", ",", RowBox[{"\"classList\"", "\[Rule]", "\"menu\""}]}], "]"}], ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"ul\"", ",", RowBox[{"\"classList\"", "\[Rule]", "\"menu\""}]}], "]"}], "[", RowBox[{"Descendant", "[", RowBox[{"x", ":", RowBox[{"XMLPattern", "[", "\"a\"", "]"}]}], "]"}], "]"}]}], "}"}]], "Output"],
Cell["On the left of a rule, name the selected element in the same way. Get the text of the links in the list:", "Text"],
Cell[BoxData["XMLCases[tree, link : \"ul.menu a\" :> HTMLTextContent[link]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"Miso\"", ",", "\"Pho\"", ",", "\"Ramen (sold out)\""}], "}"}]], "Output"]}, Open]],
Cell[CellGroupData[{Cell["Changing the Tree", "Section"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"]], "InlineFormula"], " gives the tree with every matching element removed, together with its contents. Use it before extracting text, to remove navigation, scripts and other elements that are not part of the content. Remove the script and the navigation, and list the links that remain:"}], "Text"],
Cell[BoxData[RowBox[{RowBox[{"readable", "=", RowBox[{"XMLDeleteCases", "[", RowBox[{"tree", ",", RowBox[{"XMLPattern", "[", RowBox[{"\"script\"", "|", "\"nav\""}], "]"}]}], "]"}]}], ";", RowBox[{"XMLCases", "[", RowBox[{"readable", ",", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"a\"", ",", RowBox[{"\"href\"", "->", "target_"}]}], "]"}], ":>", "target"}]}], "]"}]}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/miso\"", ",", "\"/pho\"", ",", "\"/ramen\""}], "}"}]], "Output"],
Cell[TextData[{"Only the links in the ", Cell[BoxData[StyleBox["ul", "TR"]], "InlineFormula"], " list remain. With a ", Cell[BoxData[ButtonBox["Condition", BaseStyle -> "Link", ButtonData -> "paclet:ref/Condition"]], "InlineFormula"], ", only the elements for which the test gives ", Cell[BoxData[ButtonBox["True", BaseStyle -> "Link", ButtonData -> "paclet:ref/True"]], "InlineFormula"], " are removed. To test the text of an element, name the whole element. Remove the list item that is sold out:"}], "Text"],
Cell[BoxData["readable = XMLDeleteCases[readable, item : XMLPattern[\"li\"] /; StringContainsQ[HTMLTextContent[item], \"sold out\"]];
XMLCases[readable, XMLPattern[\"a\", \"href\" -> target_] :> target]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/miso\"", ",", "\"/pho\""}], "}"}]], "Output"],
Cell[TextData[{"Given a rule ", Cell[BoxData[RowBox[{StyleBox["patt", "TI"], "\[RuleDelayed]", StyleBox["x", "TR"]}]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDeleteCases"]], "InlineFormula"], " removes what ", Cell[BoxData[StyleBox["x", "TR"]], "InlineFormula"], " is bound to, so a nested pattern can remove an element by what is above it."}], "Text"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"]], "InlineFormula"], " replaces parts of the tree. Name each part to replace, and give its replacement in a rule on the right-hand side. Make the links absolute:"}], "Text"],
Cell[BoxData["absolute = XMLReplace[readable, XMLPattern[\"a\", \"href\" -> href_] :> {href -> \"https://example.com\" <> href}];
XMLCases[absolute, XMLPattern[\"a\", \"href\" -> target_] :> target]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"https://example.com/miso\"", ",", "\"https://example.com/pho\""}], "}"}]], "Output"],
Cell[TextData[{"With any other right-hand side, ", Cell[BoxData[ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"]], "InlineFormula"], " replaces each matching element."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Extracting Text", "Section"],
Cell[TextData[{"Two functions turn a tree into a string. They correspond to the ", Cell[BoxData[StyleBox["textContent", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["innerText", "TR"]], "InlineFormula"], " properties of an element in a browser. ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLTextContent"]], "InlineFormula"], " joins all the strings in the tree in document order, and keeps the whitespace of the source. ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]], "InlineFormula"], " gives the text as a browser displays it:"}], "Text"],
Cell[BoxData[GridBox[{
   {Cell[TextData[{"block-level elements, such as ", Cell[BoxData[StyleBox["p", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["h1", "TR"]], "InlineFormula"]}], "TableText"], Cell[
    "on their own lines", "TableText"]},
   {Cell[TextData[{"inline elements, such as ", Cell[BoxData[StyleBox["b", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["span", "TR"]], "InlineFormula"]}], "TableText"], Cell[
    "in the surrounding line", "TableText"]},
   {Cell[TextData[{Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"]}], "TableText"], Cell[
    "on its own lines, with whitespace kept as written", "TableText"]},
   {Cell[TextData[{Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"]}], "TableText"], Cell[
    "a newline", "TableText"]},
   {Cell[TextData[{"elements that are not displayed, such as ", Cell[BoxData[StyleBox["script", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"]}], "TableText"], Cell[
    "left out, with their contents", "TableText"]},
   {Cell["a run of whitespace", "TableText"], Cell[
    "one space, or nothing between blocks", "TableText"]}
  }]], "DefinitionBox"],
Cell["Compare the two on the pruned tree:", "Text"],
Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"HTMLTextContent", "[", "readable", "]"}], ",", RowBox[{"HTMLInnerText", "[", "readable", "]"}]}], "}"}]], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"\\n  Copper Soup Bar\\n  Seasonal bowls, made to order.\\n  \\n  MisoPho\\n  \\n\"", ",", "\"Copper Soup Bar\\nSeasonal bowls, made to order.\\nMiso\\nPho\""}], "}"}]], "Output"],
Cell[TextData[{"In ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]], "InlineFormula"], ", the layout of the text of an element depends only on its tag, as in a browser with its default styles. The CSS of the page, including ", Cell[BoxData[StyleBox["style", "TR"]], "InlineFormula"], " attributes, has no effect. Each element has a ", StyleBox["role", FontSlant->"Italic"], ", ", Cell[BoxData["\"Block\""], "InlineFormula"], ", ", Cell[BoxData["\"Inline\""], "InlineFormula"], ", ", Cell[BoxData["\"Preformatted\""], "InlineFormula"], ", ", Cell[BoxData["\"LineBreak\""], "InlineFormula"], " or ", Cell[BoxData["\"Skip\""], "InlineFormula"], ", which sets how its text is laid out. The ", Cell[BoxData["\"Roles\""], "InlineFormula"], " option sets the role of the elements you choose, and the ", Cell[BoxData["\"BlockSeparator\""], "InlineFormula"], " option sets the string inserted between blocks. Skip the list items with the class ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], ":"}], "Text"],
Cell[BoxData[RowBox[{"HTMLInnerText", "[", RowBox[{"readable", ",", RowBox[{"\"Roles\"", "->", RowBox[{"{", RowBox[{RowBox[{"XMLPattern", "[", RowBox[{"\"li\"", ",", RowBox[{"\"classList\"", "->", "\"specials\""}]}], "]"}], "->", "\"Skip\""}], "}"}]}]}], "]"}]], "Input"],

Cell[BoxData["\"Copper Soup Bar\\nSeasonal bowls, made to order.\\nPho\""], "Output"],
Cell[TextData[{"The next section shows how to choose elements in ", Cell[BoxData["\"Roles\""], "InlineFormula"], "."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Choosing Elements for Roles and Constructs", "Section"], Cell[TextData[{"The ", Cell[BoxData["\"Roles\""], "InlineFormula"], " option of ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToNotebook"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"]], "InlineFormula"], ", and the ", Cell[BoxData["\"Constructs\""], "InlineFormula"], " option of ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToNotebook"]], "InlineFormula"], ", take a list of rules ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["val", "TI"]}]], "InlineFormula"], " or ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[RuleDelayed]", StyleBox["val", "TI"]}]], "InlineFormula"], ", or an ", Cell[BoxData[ButtonBox["Association", BaseStyle -> "Link", ButtonData -> "paclet:ref/Association"]], "InlineFormula"], " of them. The key of each rule is one of two kinds:"}], "Text"],
Cell[BoxData[GridBox[{
   {Cell[TextData[{"an element test: an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", an ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " pattern, a CSS selector for one element, or alternatives of these, each of which can be named, have a condition or have a test"}], "TableText"], Cell[
    "each element that the outermost pattern matches", "TableText"]},
   {Cell[TextData[{"a query: a rule ", Cell[BoxData[RowBox[{StyleBox["patt", "TI"], "\[RuleDelayed]", StyleBox["rhs", "TI"]}]], "InlineFormula"], ", or any other CSS selector"}], "TableText"], Cell[
    TextData[{"the elements that the names in ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " are bound to, or that the selector selects, matched once against the whole tree"}], "TableText"]}
  }]], "DefinitionBox"],
Cell[TextData[{"An element test is matched against each element by itself, so it matches an element by what is below it. A query also depends on what is above the element. Skip the links in the navigation with the query ", Cell[BoxData["\"nav a\""], "InlineFormula"], ", and all the links with the element test ", Cell[BoxData["\"a\""], "InlineFormula"], ":"}], "Text"],
Cell[BoxData["{HTMLInnerText[tree, \"Roles\" -> {\"nav a\" -> \"Skip\"}], HTMLInnerText[tree, \"Roles\" -> {\"a\" -> \"Skip\"}]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"Copper Soup Bar\\nSeasonal bowls, made to order.\\nMiso\\nPho\\nRamen (sold out)\"", ",", "\"Copper Soup Bar\\nSeasonal bowls, made to order.\""}], "}"}]], "Output"],
Cell[TextData[{"To give a rule as a query, put it in parentheses, as in ", Cell[BoxData[RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"], "[", "\"nav\"", "]"}], "[", RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"], "[", "x : XMLPattern[\"a\"]", "]"}], "]"}], "\[RuleDelayed]", StyleBox["x", "TR"]}], ")"}], "\[Rule]", "\"Skip\""}]], "InlineFormula"], ", which skips the same links as ", Cell[BoxData[RowBox[{"\"nav a\"", "\[Rule]", "\"Skip\""}]], "InlineFormula"], ". The names in ", Cell[BoxData[StyleBox["rhs", "TI"]], "InlineFormula"], " must be bound to elements, not to attributes or text. An ", Cell[BoxData[ButtonBox["XMLDocument", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLDocument"]], "InlineFormula"], " pattern can be used only in a query."}], "Text"],
Cell["The first rule that selects an element applies, whichever kind its key is. An element that no rule selects keeps its default role, or its default construct. Compare the same two rules in both orders:", "Text"],
Cell[BoxData["{HTMLInnerText[readable, \"Roles\" -> {\"li.specials\" -> \"Skip\", \"ul > li\" -> \"Inline\"}], HTMLInnerText[readable, \"Roles\" -> {\"ul > li\" -> \"Inline\", \"li.specials\" -> \"Skip\"}]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"Copper Soup Bar\\nSeasonal bowls, made to order.\\nPho\"", ",", "\"Copper Soup Bar\\nSeasonal bowls, made to order.\\nMisoPho\""}], "}"}]], "Output"],
Cell[TextData[{"The names in an element test can be used in the value of a ", Cell[BoxData[":>"], "InlineFormula"], " rule. The names in a query cannot. Keys can also use list keys: keys such as ", Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], "InlineFormula"], ", whose value is a list of tokens taken from an attribute. The ", Cell[BoxData["\"AttributeReadings\""], "InlineFormula"], " option adds list keys for other attributes, such as ", Cell[BoxData["\"\<\!\(\*StyleBox[\"relList\", \"TI\"]\)\>\""], "InlineFormula"], " for ", Cell[BoxData[StyleBox["rel", "TR"]], "InlineFormula"], ". Skip the list items that have a class:"}], "Text"],
Cell[BoxData["HTMLInnerText[readable, \"Roles\" -> {XMLPattern[\"li\", \"classList\" -> classes_] :> If[classes === {}, \"Block\", \"Skip\"]}]"], "Input"],

Cell[BoxData["\"Copper Soup Bar\\nSeasonal bowls, made to order.\\nPho\""], "Output"],
Cell[TextData[{"A name for a whole element, such as ", Cell[BoxData[StyleBox["item", "TR"]], "InlineFormula"], " in ", Cell[BoxData["item : XMLPattern[\"li\"]"], "InlineFormula"], ", is bound to the element as it is in the tree, with its attributes as raw strings, such as ", Cell[BoxData[RowBox[{"\"class\"", "\[Rule]", "\"menu specials\""}]], "InlineFormula"], ", and without a ", Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], "InlineFormula"], " key."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Converting to a Notebook", "Section"],
Cell[TextData[{"To keep the headings, lists, links and emphasis, convert the tree to a ", Cell[BoxData[ButtonBox["Notebook", BaseStyle -> "Link", ButtonData -> "paclet:ref/Notebook"]], "InlineFormula"], " expression with ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToNotebook"]], "InlineFormula"], ". Block-level elements become cells, and inline elements become formatted text in those cells. ", Cell[BoxData[ButtonBox["Export", BaseStyle -> "Link", ButtonData -> "paclet:ref/Export"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["ExportString", BaseStyle -> "Link", ButtonData -> "paclet:ref/ExportString"]], "InlineFormula"], " can then write the notebook as Markdown, PDF, RTF, etc. Convert the pruned tree to Markdown:"}], "Text"],
Cell[BoxData[RowBox[{"ExportString", "[", RowBox[{RowBox[{"HTMLToNotebook", "[", "readable", "]"}], ",", "\"Markdown\""}], "]"}]], "Input"],

Cell[BoxData["\"# Copper Soup Bar\\n\\nSeasonal **bowls**, made to order.\\n\\n- [Miso](/miso)\\n\\n- [Pho](/pho)\""], "Output"],
Cell[TextData[{"The ", Cell[BoxData["\"Constructs\""], "InlineFormula"], " option sets what elements become: a cell style such as ", Cell[BoxData["\"Section\""], "InlineFormula"], ", a text style such as ", Cell[BoxData["\"Bold\""], "InlineFormula"], ", ", Cell[BoxData["\"Plain\""], "InlineFormula"], " for plain text, or a function that gives a ", Cell[BoxData[ButtonBox["Cell", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cell"]], "InlineFormula"], " or boxes. Its keys are chosen as in ", Cell[BoxData["\"Roles\""], "InlineFormula"], ". Make the heading a section, and the links in the list plain text:"}], "Text"],
Cell[BoxData["ExportString[HTMLToNotebook[readable, \"Constructs\" -> {\"h1\" -> \"Section\", \"ul a\" -> \"Plain\"}], \"Markdown\"]"], "Input"],

Cell[BoxData["\"### Copper Soup Bar\\n\\nSeasonal **bowls**, made to order.\\n\\n- Miso\\n\\n- Pho\""], "Output"]}, Open]],
Cell[CellGroupData[{Cell["Other Functions", "Section"], Cell[TextData[{Cell[BoxData[ButtonBox["XMLPosition", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPosition"]], "InlineFormula"], " gives the positions of the matches of a pattern, and ", Cell[BoxData[ButtonBox["XMLExtract", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLExtract"]], "InlineFormula"], " gives the parts at such positions. ", Cell[BoxData[ButtonBox["XMLFreeQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLFreeQ"]], "InlineFormula"], " tests whether no element of a tree matches a pattern. ", Cell[BoxData[ButtonBox["XMLReplace", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLReplace"]], "InlineFormula"], " can also replace tags, classes, attribute lists and the contents of elements. ", Cell[BoxData[ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"]], "InlineFormula"], " can draw only the elements that match a query, and ", Cell[BoxData[ButtonBox["FromCSSSelector", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/FromCSSSelector"]], "InlineFormula"], " lists the CSS selectors that it translates. The reference page of each function gives the details."}], "Text"]}, Open]],

