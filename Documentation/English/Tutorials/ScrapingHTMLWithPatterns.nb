(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["Scraping HTML with Patterns", "Title"],
Cell[TextData[{ButtonBox["HTMLPatterns", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/guide/HTMLPatterns"], " is a set of functions for querying HTML and XML in the Wolfram Language, in the style of the Python library BeautifulSoup. ", Cell[BoxData[ButtonBox["Import", BaseStyle -> "Link", ButtonData -> "paclet:ref/Import"]], "InlineFormula"], " gives an HTML page as an ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " expression: a tree of elements, each with a tag, attributes and contents. HTMLPatterns finds elements in this tree by ", StyleBox["pattern", FontSlant->"Italic"], ". An ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], " matches an element by its tag, its attributes and its classes, and by the elements below it, so a pattern is nested as the document is. Other functions extract the text of the elements you find, or convert them to a notebook."}], "Text"],
Cell[TextData[{"In this tutorial you import one small HTML document, find elements in it by tag, attribute and class, and test single elements. You then match what is below an element, with ", StyleBox["constraints", FontSlant->"Italic"], " such as ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Child"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/Descendant"]], "InlineFormula"], " that you give to an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern"]], "InlineFormula"], ", and use CSS selectors in place of patterns. Finally you remove and replace elements, and turn the rest into text or a notebook."}], "Text"],
Cell[CellGroupData[{Cell["Importing a Document", "Section"], Cell["Load the paclet:", "Text"],
Cell[BoxData[RowBox[{"Needs", "[", "\"MaximilienTirard`HTMLPatterns`\"", "]"}]], "Input"],
Cell[TextData[{"Import a small HTML document in the ", Cell[BoxData[RowBox[{"{", RowBox[{"\"HTML\"", ",", "\"XMLObject\""}], "}"}]], "InlineFormula"], " format. The rest of this tutorial uses this tree:"}], "Text"],


Cell[CellGroupData[{

Cell[BoxData[{RowBox[{RowBox[{"tree", "=", RowBox[{"ImportString", "[", RowBox[{"\"\n<article>\n  <h1>Copper Soup Bar</h1>\n  <p class=\\\"lead\\\">Seasonal <b>bowls</b>, made to order.</p>\n  <nav class=\\\"menu compact\\\">\n    <a href=\\\"/menu\\\">Menu</a>\n    <a href=\\\"/hours\\\">Hours</a>\n  </nav>\n  <ul class=\\\"menu specials\\\">\n    <li class=\\\"specials\\\"><a href=\\\"/miso\\\">Miso</a></li>\n    <li><a href=\\\"/pho\\\">Pho</a></li>\n    <li><a href=\\\"/ramen\\\">Ramen (sold out)</a></li>\n  </ul>\n  <script>track();</script>\n</article>\"", ",", RowBox[{"{", RowBox[{"\"HTML\"", ",", "\"XMLObject\""}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "tree"}], "Input",
 CellLabel->"In[1]:="],

Cell[BoxData[RowBox[{RowBox[{"XMLObject", "[", "\"Document\"", "]"}], "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"XMLObject", "[", "\"Declaration\"", "]"}], "[", RowBox[{RowBox[{"\"Version\"", "\[Rule]", "\"1.0\""}], ",", RowBox[{"\"Standalone\"", "\[Rule]", "\"yes\""}]}], "]"}], "}"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"article\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"http://www.w3.org/2000/xmlns/\"", ",", "\"xmlns\""}], "}"}], "\[Rule]", "\"http://www.w3.org/1999/xhtml\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"h1\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Copper Soup Bar\"", "}"}]}], "]"}], ",", "\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"Seasonal \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"b\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"bowls\"", "}"}]}], "]"}], ",", "\", made to order.\""}], "}"}]}], "]"}], ",", "\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"nav\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"menu compact\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"\\n    \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/menu\""}]}], "}"}], ",", RowBox[{"{", "\"Menu\"", "}"}]}], "]"}], ",", "\"\\n    \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/hours\""}]}], "}"}], ",", RowBox[{"{", "\"Hours\"", "}"}]}], "]"}], ",", "\"\\n  \""}], "}"}]}], "]"}], ",", "\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"ul\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"menu specials\""}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"specials\""}], "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/miso\""}]}], "}"}], ",", RowBox[{"{", "\"Miso\"", "}"}]}], "]"}], "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/pho\""}]}], "}"}], ",", RowBox[{"{", "\"Pho\"", "}"}]}], "]"}], "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/ramen\""}]}], "}"}], ",", RowBox[{"{", "\"Ramen (sold out)\"", "}"}]}], "]"}], "}"}]}], "]"}]}], "}"}]}], "]"}], ",", "\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"script\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"track();\"", "}"}]}], "]"}], ",", "\"\\n\""}], "}"}]}], "]"}], ",", RowBox[{"{", "}"}]}], "]"}]], "Output"]
}, Open  ]],
Cell[TextData[{"Draw its structure with ", Cell[BoxData[ButtonBox["HTMLToTree", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree"]], "InlineFormula"], ". Each element is a node labelled with its tag, and each string of text is a leaf:"}], "Text"],
Cell[BoxData["HTMLToTree[tree]"], "Input"],

Cell[BoxData[GraphicsBox[NamespaceBox["Trees", DynamicModuleBox[{Typeset`tree = HoldComplete[Tree["#document", {Tree[XMLElement["article", {{"http://www.w3.org/2000/xmlns/", "xmlns"} -> "http://www.w3.org/1999/xhtml"}, {}], {Tree[XMLElement["h1", {}, {}], {Tree["Copper Soup Bar", None]}], Tree[XMLElement["p", {"class" -> "lead"}, {}], {Tree["Seasonal ", None], Tree[XMLElement["b", {}, {}], {Tree["bowls", None]}], Tree[", made to order.", None]}], Tree[XMLElement["nav", {"class" -> "menu compact"}, {}], {Tree[XMLElement["a", {"shape" -> "rect", "href" -> "/menu"}, {}], {Tree["Menu", None]}], Tree[XMLElement["a", {"shape" -> "rect", "href" -> "/hours"}, {}], {Tree["Hours", None]}]}], Tree[XMLElement["ul", {"class" -> "menu specials"}, {}], {Tree[XMLElement["li", {"class" -> "specials"}, {}], {Tree[XMLElement["a", {"shape" -> "rect", "href" -> "/miso"}, {}], {Tree["Miso", None]}]}], Tree[XMLElement["li", {}, {}], {Tree[XMLElement["a", {"shape" -> "rect", "href" -> "/pho"}, {}], {Tree["Pho", None]}]}], Tree[XMLElement["li", {}, {}], {Tree[XMLElement["a", {"shape" -> "rect", "href" -> "/ramen"}, {}], {Tree["Ramen (sold out)", None]}]}]}], Tree[XMLElement["script", {}, {}], {Tree["track();", None]}]}]}, {TreeElementLabelFunction -> {{} -> MaximilienTirard`HTMLPatterns`Tree`Private`documentLabel, All -> MaximilienTirard`HTMLPatterns`Tree`Private`treeLabel}, TreeLayout -> Left, ImageSize -> {683, 240}, AspectRatio -> 240/683}]]}, NamespaceBox[{{Arrowheads[0.02582942231619772], Directive[Opacity[0.7], Hue[0.6, 0.7, 0.7], CapForm["Round"]], Directive[FontFamily -> "Arial"], StyleBox[LineBox[{{0., -0.4835858411975235}, {0.5504818825631803, -0.4835858411975234}}], {Directive[Directive[RGBColor[0.3231201179703305, 0.696411134378161, 0.574096681253161], AbsoluteThickness[1]], Directive[]]}, StripOnInput -> False], StyleBox[LineBox[{{0.5504818825631803, -0.4835858411975234}, {1.1009637651263589, 0.}}], {Directive[Directive[RGBColor[0.3231201179703305, 0.696411134378161, 0.57409668