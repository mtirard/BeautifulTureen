(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["Scraping HTML with BeautifulTureen", "Title"],
Cell[TextData[{ButtonBox["BeautifulTureen", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/guide/BeautifulTureen"], " brings BeautifulSoup-style ergonomics to the Wolfram Language. You select elements from an imported HTML or XML tree by ", StyleBox["pattern", FontSlant->"Italic"], ", compose those patterns with structural ", StyleBox["combinators", FontSlant->"Italic"], ", and extract the matched content as raw text, readable text, or a notebook ready to export. Every function operates on the static ", Cell[BoxData[ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"]], "InlineFormula"], " tree that ", Cell[BoxData[ButtonBox["Import", BaseStyle -> "Link", ButtonData -> "paclet:ref/Import"]], "InlineFormula"], " produces; there is no live DOM, no CSS engine, and no round-trip out to a browser."}], "Text"],
Cell[TextData[{"This tutorial walks the whole workflow on one small HTML document: import the tree, find elements with ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " and match their classes through its ", Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], "InlineFormula"], " key, test single elements with ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], ", narrow the search with the ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineFormula"], ", and ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineFormula"], " combinators, prune unwanted subtrees with ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ", and finally turn what remains into text with ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " or into a document with ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], "."}], "Text"],
Cell[TextData[{"Everything starts from the tree that ", Cell[BoxData[ButtonBox["Import", BaseStyle -> "Link", ButtonData -> "paclet:ref/Import"]], "InlineFormula"], " returns for the ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["\"HTML\"", "TR"], ",", " ", StyleBox["\"XMLObject\"", "TR"]}], "}"}]], "InlineFormula"], " format. Import a small HTML fragment to work with throughout, and look at what comes back:"}], "Text"],

Cell["XXXX", "Text"],

Cell[BoxData[GridBox[{
   {"XXXX", Cell[
    "XXXX", "TableText"]},
   {"XXXX", Cell[
    "XXXX", "TableText"]},
   {"XXXX", Cell[
    "XXXX", "TableText"]}
  }]], "DefinitionBox"],

Cell["XXXX.", "Caption"],

Cell[CellGroupData[{

Cell["XXXX", "MathCaption"],

Cell[CellGroupData[{

Cell[BoxData["tree=ImportString[\"
<article>
  <h1>Tureen Soup Bar</h1>
  <p class=\\\"lead\\\">Seasonal <b>bowls</b>, made to order.</p>
  <nav class=\\\"menu compact\\\">
    <a href=\\\"/menu\\\">Menu</a>
    <a href=\\\"/hours\\\">Hours</a>
  </nav>
  <ul class=\\\"menu specials\\\">
    <li class=\\\"specials\\\"><a href=\\\"/miso\\\">Miso</a></li>
    <li><a href=\\\"/pho\\\">Pho</a></li>
    <li><a href=\\\"/ramen\\\">Ramen (sold out)</a></li>
  </ul>
  <script>track();</script>
</article>\",{\"HTML\",\"XMLObject\"}];
tree"], "Input",
 CellLabel->"In[1]:="],

Cell[BoxData[RowBox[{RowBox[{"XMLObject", "[", "\"Document\"", "]"}], "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"XMLObject", "[", "\"Declaration\"", "]"}], "[", RowBox[{RowBox[{"\"Version\"", "\[Rule]", "\"1.0\""}], ",", RowBox[{"\"Standalone\"", "\[Rule]", "\"yes\""}]}], "]"}], "}"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"article\"", ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"http://www.w3.org/2000/xmlns/\"", ",", "\"xmlns\""}], "}"}], "\[Rule]", "\"http://www.w3.org/1999/xhtml\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"h1\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"Tureen Soup Bar\"", "}"}]}], "]"}], ",", "\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"Seasonal \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"b\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"bowls\"", "}"}]}], "]"}], ",", "\", made to order.\""}], "}"}]}], "]"}], ",", "\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"nav\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"menu compact\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"\\n    \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/menu\""}]}], "}"}], ",", RowBox[{"{", "\"Menu\"", "}"}]}], "]"}], ",", "\"\\n    \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/hours\""}]}], "}"}], ",", RowBox[{"{", "\"Hours\"", "}"}]}], "]"}], ",", "\"\\n  \""}], "}"}]}], "]"}], ",", "\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"ul\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"menu specials\""}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"specials\""}], "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/miso\""}]}], "}"}], ",", RowBox[{"{", "\"Miso\"", "}"}]}], "]"}], "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/pho\""}]}], "}"}], ",", RowBox[{"{", "\"Pho\"", "}"}]}], "]"}], "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/ramen\""}]}], "}"}], ",", RowBox[{"{", "\"Ramen (sold out)\"", "}"}]}], "]"}], "}"}]}], "]"}]}], "}"}]}], "]"}], ",", "\"\\n  \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"script\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"track();\"", "}"}]}], "]"}], ",", "\"\\n\""}], "}"}]}], "]"}], ",", RowBox[{"{", "}"}]}], "]"}]], "Output"]
}, Open  ]],
Cell[TextData[{"The Wolfram Language has a native representation for HTML, so the page is now an ordinary expression you can read. Every tag became an ", Cell[BoxData[RowBox[{ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", StyleBox["attributes", "TI"], ",", " ", StyleBox["children", "TI"]}], "]"}]], "InlineFormula"], ": a tag name, its attributes as a list of rules, and its contents as a list. The contents list holds the text inside the tag and, in place, the elements that tag contains, so the nesting of the HTML is the nesting of the expression. Wrapping all of it is an ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"], "[", StyleBox["\"Document\"", "TR"], "]"}], "[", StyleBox["\[Ellipsis]", "TR"], "]"}]], "InlineFormula"], ", which holds the document's XML declaration alongside the root element."}], "Text"],
Cell[TextData[{"A few oddities came from the import: ", Cell[BoxData[StyleBox["article", "TR"]], "InlineFormula"], " has an ", Cell[BoxData[StyleBox["xmlns", "TR"]], "InlineFormula"], " attribute, the long ", Cell[BoxData[StyleBox["\"http://www.w3.org/1999/xhtml\"", "TR"]], "InlineFormula"], " rule at the head of its attribute list, which names the dialect of the markup and says nothing about the page; each ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " has an extra ", Cell[BoxData[RowBox[{"\"\<\!\(\*StyleBox[\"shape\", \"TI\"]\)\>\"", "\[Rule]", "\"\<\!\(\*StyleBox[\"rect\", \"TI\"]\)\>\""}]], "InlineFormula"], " attribute; and the source's indentation is present as plain strings between the elements."}], "Text"],
Cell[TextData[{"Being an ordinary expression means the standard ", ButtonBox["pattern language", BaseStyle -> "Link", ButtonData -> "tutorial/Patterns"], " already applies. With nothing but built-in ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " and the three-argument ", Cell[BoxData[ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"]], "InlineFormula"], " form, take a census of the tags:"}], "Text"],
Cell[BoxData["Union[Cases[tree,XMLElement[tag_,_,_]:>tag,Infinity]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"a\"", ",", "\"article\"", ",", "\"b\"", ",", "\"h1\"", ",", "\"li\"", ",", "\"nav\"", ",", "\"p\"", ",", "\"script\"", ",", "\"ul\""}], "}"}]], "Output"],
Cell[TextData[{"Every tag in that list came from the source. Notice what plain ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " made you spell out: the ", Cell[BoxData[ButtonBox["Infinity", BaseStyle -> "Link", ButtonData -> "paclet:ref/Infinity"]], "InlineFormula"], " level specification, because elements nest arbitrarily deep, and the full three-argument ", Cell[BoxData[RowBox[{ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", StyleBox["_", "TR"], ",", " ", StyleBox["_", "TR"]}], "]"}]], "InlineFormula"], " shape."}], "Text"],
Cell["BeautifulTureen packages exactly this kind of query into a vocabulary that makes the common HTML queries concise. Load the paclet:", "Text"],
Cell[BoxData["Needs[\"MaximilienTirard`BeautifulTureen`\"]"], "Input"],
Cell["The same census, now through the paclet's vocabulary:", "Text"],
Cell[BoxData["Union[XMLCases[tree,XMLPattern[tag_]:>tag]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"a\"", ",", "\"article\"", ",", "\"b\"", ",", "\"h1\"", ",", "\"li\"", ",", "\"nav\"", ",", "\"p\"", ",", "\"script\"", ",", "\"ul\""}], "}"}]], "Output"],
Cell[TextData[{"Notice ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " became ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], "; ", Cell[BoxData[RowBox[{ButtonBox["XMLElement", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLElement"], "[", RowBox[{"tag_", ",", " ", StyleBox["_", "TR"], ",", " ", StyleBox["_", "TR"]}], "]"}]], "InlineFormula"], " became ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", "tag_", "]"}]], "InlineFormula"], "; and the ", Cell[BoxData[ButtonBox["Infinity", BaseStyle -> "Link", ButtonData -> "paclet:ref/Infinity"]], "InlineFormula"], " is gone. So for simple tasks, not much changes."}], "Text"]
}, Open  ]],
Cell[CellGroupData[{Cell["Selecting Elements", "Section"],
Cell[TextData[{Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", StyleBox["tag", "TI"], "]"}]], "InlineFormula"], " matches any element with the given tag; ", Cell[BoxData[RowBox[{ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"], "[", RowBox[{StyleBox["tag", "TI"], ",", " ", StyleBox["attrs", "TI"]}], "]"}]], "InlineFormula"], " also constrains its attributes. ", Cell[BoxData[StyleBox["attrs", "TI"]], "InlineFormula"], " is what ", Cell[BoxData[ButtonBox["KeyValuePattern", BaseStyle -> "Link", ButtonData -> "paclet:ref/KeyValuePattern"]], "InlineFormula"], " takes: a list of ", Cell[BoxData[RowBox[{StyleBox["key", "TI"], "\[Rule]", StyleBox["value", "TI"]}]], "InlineFormula"], " rules, a single rule, or a bare key. Keys are literal and values are ordinary patterns, and the element may carry attributes the pattern does not mention. Use a ", Cell[BoxData[ButtonBox["RuleDelayed", BaseStyle -> "Link", ButtonData -> "paclet:ref/RuleDelayed"]], "InlineFormula"], " inside ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], " to do transformations on each match, just like you would for ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], ":"}], "Text"],
Cell[BoxData["XMLCases[tree,XMLPattern[\"a\",\"href\"->target_]:>target]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/menu\"", ",", "\"/hours\"", ",", "\"/miso\"", ",", "\"/pho\"", ",", "\"/ramen\""}], "}"}]], "Output"],
Cell[TextData[{"The constraint expresses that the element must have an ", Cell[BoxData["\"\<\!\(\*StyleBox[\"href\", \"TI\"]\)\>\""], "InlineFormula"], " attribute and captures its value as ", Cell[BoxData[StyleBox["target", "TR"]], "InlineFormula"], " using a named ", Cell[BoxData[ButtonBox["Pattern", BaseStyle -> "Link", ButtonData -> "paclet:ref/Pattern"]], "InlineFormula"], "."}], "Text"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], " gives its matches in document order, the order in which the tags open in the source, as the browser's ", Cell[BoxData[StyleBox["querySelectorAll", "TR"]], "InlineFormula"], " does: an element comes before the elements nested in it. Plain ", Cell[BoxData[ButtonBox["Cases", BaseStyle -> "Link", ButtonData -> "paclet:ref/Cases"]], "InlineFormula"], " gives the opposite, visiting what is inside an element before the element itself:"}], "Text"],
Cell[BoxData["{Cases[tree,XMLElement[tag:\"ul\"|\"li\",_,_]:>tag,Infinity],XMLCases[tree,XMLPattern[tag:\"ul\"|\"li\"]:>tag]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"li\"", ",", "\"li\"", ",", "\"li\"", ",", "\"ul\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"ul\"", ",", "\"li\"", ",", "\"li\"", ",", "\"li\""}], "}"}]}], "}"}]], "Output"],
Cell[TextData[{"When you want just one element, ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], " stops at the first match in document order and returns ", Cell[BoxData[RowBox[{ButtonBox["Missing", BaseStyle -> "Link", ButtonData -> "paclet:ref/Missing"], "[", StyleBox["\"NotFound\"", "TR"], "]"}]], "InlineFormula"], " (or a supplied default) when nothing matches. Grab the lead paragraph by its ", Cell[BoxData["\"\<\!\(\*StyleBox[\"class\", \"TI\"]\)\>\""], "InlineFormula"], " attribute:"}], "Text"],
Cell[BoxData["XMLFirstCase[tree,XMLPattern[\"p\",\"class\"->\"lead\"]]"], "Input"],

Cell[BoxData[RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"Seasonal \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"b\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"bowls\"", "}"}]}], "]"}], ",", "\", made to order.\""}], "}"}]}], "]"}]], "Output"]}, Open]],
Cell[CellGroupData[{Cell["Matching Classes", "Section"],
Cell[TextData[{"That worked because the paragraph has exactly one class. An attribute rule matches the value as written, and CSS puts every class an element has into that one attribute, separated by spaces. The same rule on ", Cell[BoxData["\"\<\!\(\*StyleBox[\"menu\", \"TI\"]\)\>\""], "InlineFormula"], " finds nothing, because the ", Cell[BoxData[StyleBox["nav", "TR"]], "InlineFormula"], " carries the string ", Cell[BoxData["\"\<\!\(\*StyleBox[\"menu compact\", \"TI\"]\)\>\""], "InlineFormula"], ". To ask about one class among several, use the key ", Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], "InlineFormula"], " instead:"}], "Text"],
Cell[BoxData["Map[XMLFirstCase[tree,XMLPattern[tag_,#]:>tag]&,{\"class\"->\"menu\",\"classList\"->\"menu\"}]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"Missing", "[", "\"NotFound\"", "]"}], ",", "\"nav\""}], "}"}]], "Output"],
Cell[TextData[{Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], "InlineFormula"], " is a ", StyleBox["list key", FontSlant->"Italic"], ": it does not appear in the tree, but an ", Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " reaches through it to the class list, the list of tokens obtained by splitting the ", Cell[BoxData["\"\<\!\(\*StyleBox[\"class\", \"TI\"]\)\>\""], "InlineFormula"], " value on HTML whitespace. ", Cell[BoxData[ButtonBox["HTMLClassList", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLClassList"]], "InlineFormula"], " gives the same list for an element; an element without a ", Cell[BoxData["\"\<\!\(\*StyleBox[\"class\", \"TI\"]\)\>\""], "InlineFormula"], " attribute has the empty class list:"}], "Text"],
Cell[BoxData["HTMLClassList/@XMLCases[tree,XMLPattern[\"nav\"|\"ul\"|\"li\"]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"menu\"", ",", "\"compact\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"menu\"", ",", "\"specials\""}], "}"}], ",", RowBox[{"{", "\"specials\"", "}"}], ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "}"}]}], "}"}]], "Output"],
Cell[TextData[{"The value at a list key is an ordinary pattern, matched against that list, with one convenience: a literal string, or an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of them, can never match a list as written, so at a list key it means \"contains this token\". ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", StyleBox["\"menu\"", "TR"]}]], "InlineFormula"], " is shorthand for the list pattern ", Cell[BoxData[RowBox[{StyleBox["\"classList\"", "TR"], "\[Rule]", RowBox[{"{", RowBox[{StyleBox["___", "TR"], ",", " ", StyleBox["\"menu\"", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]}]], "InlineFormula"], ", and the two select the same elements:"}], "Text"],
Cell[BoxData["{XMLCases[tree,XMLPattern[tag_,\"classList\"->\"menu\"]:>tag],XMLCases[tree,XMLPattern[tag_,\"classList\"->{___,\"menu\",___}]:>tag]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"\"nav\"", ",", "\"ul\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"nav\"", ",", "\"ul\""}], "}"}]}], "}"}]], "Output"],
Cell[TextData[{"Any other list pattern is matched as written, so its elements are positional. ", Cell[BoxData[RowBox[{"{", RowBox[{StyleBox["\"specials\"", "TR"], ",", " ", StyleBox["___", "TR"]}], "}"}]], "InlineFormula"], " asks for a class list whose ", StyleBox["first", FontSlant->"Italic"], " token is ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], ", which the ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " has and the ", Cell[BoxData[StyleBox["ul", "TR"]], "InlineFormula"], " does not:"}], "Text"],
Cell[BoxData["XMLCases[tree,XMLPattern[tag_,\"classList\"->{\"specials\",___}]:>tag]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"li\"", "}"}]], "Output"],
Cell[TextData[{"Questions that do not depend on order are asked with the list predicates the Wolfram Language already has, such as ", Cell[BoxData[ButtonBox["MemberQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MemberQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["FreeQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/FreeQ"]], "InlineFormula"], ", ", Cell[BoxData[ButtonBox["ContainsAll", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAll"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["ContainsAny", BaseStyle -> "Link", ButtonData -> "paclet:ref/ContainsAny"]], "InlineFormula"], ", inside a ", Cell[BoxData[ButtonBox["PatternTest", BaseStyle -> "Link", ButtonData -> "paclet:ref/PatternTest"]], "InlineFormula"], ". Ask for the elements with both the ", Cell[BoxData["\"\<\!\(\*StyleBox[\"menu\", \"TI\"]\)\>\""], "InlineFormula"], " and the ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], " class:"}], "Text"],
Cell[BoxData["XMLCases[tree,XMLPattern[tag_,\"classList\"->_?(ContainsAll[{\"menu\",\"specials\"}])]:>tag]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"ul\"", "}"}]], "Output"],
Cell[TextData[{"Several questions about one list are combined in a single value pattern, here a named list with a ", Cell[BoxData[ButtonBox["Condition", BaseStyle -> "Link", ButtonData -> "paclet:ref/Condition"]], "InlineFormula"], ". Ask for the ", Cell[BoxData["\"\<\!\(\*StyleBox[\"menu\", \"TI\"]\)\>\""], "InlineFormula"], " or ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], " elements that are not ", Cell[BoxData["\"\<\!\(\*StyleBox[\"compact\", \"TI\"]\)\>\""], "InlineFormula"], ", the CSS selector ", Cell[BoxData[":is(.menu, .specials):not(.compact)"], "InlineFormula"], ":"}], "Text"],
Cell[BoxData["XMLCases[tree,XMLPattern[tag_,\"classList\"->c_/;ContainsAny[c,{\"menu\",\"specials\"}]&&FreeQ[c,\"compact\"]]:>tag]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"ul\"", ",", "\"li\""}], "}"}]], "Output"],
Cell[TextData[{"The test for \"not ", Cell[BoxData["\"\<\!\(\*StyleBox[\"compact\", \"TI\"]\)\>\""], "InlineFormula"], "\" is ", Cell[BoxData[ButtonBox["FreeQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/FreeQ"]], "InlineFormula"], ", not ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], ". ", Cell[BoxData[RowBox[{ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"], "[", StyleBox["\"compact\"", "TR"], "]"}]], "InlineFormula"], " is the ordinary ", Cell[BoxData[ButtonBox["Except", BaseStyle -> "Link", ButtonData -> "paclet:ref/Except"]], "InlineFormula"], ", and every class list, being a list, is not the string ", Cell[BoxData["\"\<\!\(\*StyleBox[\"compact\", \"TI\"]\)\>\""], "InlineFormula"], ", so it rules nothing out:"}], "Text"],
Cell[BoxData["XMLCases[tree,XMLPattern[tag:\"nav\"|\"ul\",\"classList\"->Except[\"compact\"]]:>tag]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"nav\"", ",", "\"ul\""}], "}"}]], "Output"]}, Open]],
Cell[CellGroupData[{Cell["Testing One Element", "Section"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLPattern", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLPattern"]], "InlineFormula"], " is inert: it has no definitions, and only this paclet's functions interpret it. To ", Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], " it is an ordinary expression, which no element matches, just as ", Cell[BoxData[ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"]], "InlineFormula"], " does not treat a string pattern as a test of a string. Test a single element with ", Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], " instead, as ", Cell[BoxData[ButtonBox["StringMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/StringMatchQ"]], "InlineFormula"], " tests a whole string:"}], "Text"],
Cell[BoxData["lead=XMLFirstCase[tree,XMLPattern[\"p\"]];
{MatchQ[lead,XMLPattern[\"p\"]],XMLMatchQ[lead,XMLPattern[\"p\",\"classList\"->\"lead\"]]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"False", ",", "True"}], "}"}]], "Output"],
Cell[TextData[{Cell[BoxData[ButtonBox["XMLMatchQ", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLMatchQ"]], "InlineFormula"], " has an operator form, which fits ", Cell[BoxData[ButtonBox["Select", BaseStyle -> "Link", ButtonData -> "paclet:ref/Select"]], "InlineFormula"], ". Keep the list items that have no class:"}], "Text"],
Cell[BoxData["Select[XMLCases[tree,XMLPattern[\"li\"]],XMLMatchQ[XMLPattern[\"li\",\"classList\"->{}]]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/pho\""}]}], "}"}], ",", RowBox[{"{", "\"Pho\"", "}"}]}], "]"}], "}"}]}], "]"}], ",", RowBox[{"XMLElement", "[", RowBox[{"\"li\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"a\"", ",", RowBox[{"{", RowBox[{RowBox[{"\"shape\"", "\[Rule]", "\"rect\""}], ",", RowBox[{"\"href\"", "\[Rule]", "\"/ramen\""}]}], "}"}], ",", RowBox[{"{", "\"Ramen (sold out)\"", "}"}]}], "]"}], "}"}]}], "]"}]}], "}"}]], "Output"]}, Open]],
Cell[CellGroupData[{Cell["Structural Combinators", "Section"],
Cell[TextData[{"A bare pattern ignores where an element sits in the tree. The four combinators add that structure, each mirroring a CSS selector: ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{StyleBox["parent", "TI"], ",", " ", StyleBox["child", "TI"]}], "]"}]], "InlineFormula"], " matches a direct child (CSS ", Cell[BoxData["parent > child"], "InlineFormula"], "); ", Cell[BoxData[RowBox[{ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"], "[", RowBox[{StyleBox["ancestor", "TI"], ",", " ", StyleBox["desc", "TI"]}], "]"}]], "InlineFormula"], " matches at any depth (CSS ", Cell[BoxData["ancestor desc"], "InlineFormula"], "); ", Cell[BoxData[RowBox[{ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"], "[", RowBox[{StyleBox["before", "TI"], ",", " ", StyleBox["after", "TI"]}], "]"}]], "InlineFormula"], " matches the element immediately following a sibling (CSS ", Cell[BoxData["before + after"], "InlineFormula"], "); and ", Cell[BoxData[RowBox[{ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"], "[", RowBox[{StyleBox["before", "TI"], ",", " ", StyleBox["after", "TI"]}], "]"}]], "InlineFormula"], " matches any following sibling (CSS ", Cell[BoxData["before ~ after"], "InlineFormula"], "). A combinator selects the elements its last pattern matches, each once, in document order."}], "Text"],
Cell[TextData[{"All four are accepted by ", Cell[BoxData[ButtonBox["XMLCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLCases"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["XMLFirstCase", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLFirstCase"]], "InlineFormula"], "; ", Cell[BoxData[ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Descendant", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Descendant"]], "InlineFormula"], " are also accepted by ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], ". Restrict the link search to the menu list, so that the ", Cell[BoxData[StyleBox["nav", "TR"]], "InlineFormula"], " links are left out:"}], "Text"],
Cell[BoxData["XMLCases[tree,Descendant[XMLPattern[\"ul\",\"classList\"->\"menu\"],XMLPattern[\"a\",\"href\"->target_]]:>target]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/miso\"", ",", "\"/pho\"", ",", "\"/ramen\""}], "}"}]], "Output"],
Cell[TextData[{Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineFormula"], " reaches for content by its position relative to a landmark. Here, the landmark is the paragraph that immediately follows the top heading:"}], "Text"],
Cell[BoxData["XMLCases[tree,Adjacent[XMLPattern[\"h1\"],XMLPattern[\"p\"]]]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"XMLElement", "[", RowBox[{"\"p\"", ",", RowBox[{"{", RowBox[{"\"class\"", "\[Rule]", "\"lead\""}], "}"}], ",", RowBox[{"{", RowBox[{"\"Seasonal \"", ",", RowBox[{"XMLElement", "[", RowBox[{"\"b\"", ",", RowBox[{"{", "}"}], ",", RowBox[{"{", "\"bowls\"", "}"}]}], "]"}], ",", "\", made to order.\""}], "}"}]}], "]"}], "}"}]], "Output"],
Cell[TextData[{"A combinator can itself be an argument of another, and the whole reads left to right as a chain, as a CSS selector does: ", Cell[BoxData[RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{RowBox[{ButtonBox["Child", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Child"], "[", RowBox[{StyleBox["a", "TI"], ",", " ", StyleBox["b", "TI"]}], "]"}], ",", " ", StyleBox["c", "TI"]}], "]"}]], "InlineFormula"], " is ", Cell[BoxData["a > b > c"], "InlineFormula"], ". Names follow the rules of an ordinary list pattern over the chain's elements. A ", Cell[BoxData[ButtonBox["Condition", BaseStyle -> "Link", ButtonData -> "paclet:ref/Condition"]], "InlineFormula"], " on one element pattern sees only that pattern's names, while a ", Cell[BoxData[ButtonBox["Condition", BaseStyle -> "Link", ButtonData -> "paclet:ref/Condition"]], "InlineFormula"], " on the whole combinator sees the names of every pattern inside it. Find the links in list items that share a class with their list:"}], "Text"],
Cell[BoxData["XMLCases[tree,Child[Child[XMLPattern[\"ul\",\"classList\"->outer_],XMLPattern[\"li\",\"classList\"->inner_]]/;IntersectingQ[outer,inner],XMLPattern[\"a\",\"href\"->target_]]:>target]"], "Input"],

Cell[BoxData[RowBox[{"{", "\"/miso\"", "}"}]], "Output"],
Cell[TextData[{"Only the ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], " item qualifies. Had the test been written on the ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " pattern instead, ", Cell[BoxData[StyleBox["outer", "TR"]], "InlineFormula"], " would have been unbound inside it, as in ", Cell[BoxData[RowBox[{ButtonBox["MatchQ", BaseStyle -> "Link", ButtonData -> "paclet:ref/MatchQ"], "[", RowBox[{RowBox[{"{", RowBox[{StyleBox["1", "TR"], ",", " ", StyleBox["2", "TR"]}], "}"}], ",", " ", RowBox[{"{", RowBox[{"a_", ",", " ", "b_ /; a == 1"}], "}"}]}], "]"}]], "InlineFormula"], ", which is ", Cell[BoxData[ButtonBox["False", BaseStyle -> "Link", ButtonData -> "paclet:ref/False"]], "InlineFormula"], "."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Pruning the Tree", "Section"],
Cell[TextData[{"Selection pulls elements ", StyleBox["out", FontSlant->"Italic"], "; ", Cell[BoxData[ButtonBox["XMLDeleteCases", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/XMLDeleteCases"]], "InlineFormula"], " removes them ", StyleBox["in place", FontSlant->"Italic"], ", returning the tree with every match (and its whole subtree) gone. It is the natural first step before reading a document as text: strip the chrome and the non-content tags, then extract. The tag argument takes a pattern, so an ", Cell[BoxData[ButtonBox["Alternatives", BaseStyle -> "Link", ButtonData -> "paclet:ref/Alternatives"]], "InlineFormula"], " of tags clears several categories in one pass. Remove the tracking script and the navigation, keeping the surrounding ", Cell[BoxData[RowBox[{RowBox[{ButtonBox["XMLObject", BaseStyle -> "Link", ButtonData -> "paclet:ref/XMLObject"], "[", StyleBox["\"Document\"", "TR"], "]"}], "[", StyleBox["\[Ellipsis]", "TR"], "]"}]], "InlineFormula"], " intact:"}], "Text"],
Cell[BoxData["readable=XMLDeleteCases[tree,XMLPattern[\"script\"|\"nav\"]];XMLCases[readable,XMLPattern[\"a\",\"href\"->target_]:>target]"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"/miso\"", ",", "\"/pho\"", ",", "\"/ramen\""}], "}"}]], "Output"],
Cell[TextData[{"The ", Cell[BoxData[StyleBox["nav", "TR"]], "InlineFormula"], " anchors are gone and only the menu links survive. A conditioned pattern ", Cell[BoxData["pat$ /; test$"], "InlineFormula"], " deletes selectively; names bind as in ordinary pattern matching, and a leading name on the whole matched element (", Cell[BoxData["el$ : pat$"], "InlineFormula"], ") lets the test call ", Cell[BoxData[RowBox[{ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"], "[", StyleBox["el", "TI"], "]"}]], "InlineFormula"], " on it. The ", Cell[BoxData[ButtonBox["Adjacent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Adjacent"]], "InlineFormula"], " and ", Cell[BoxData[ButtonBox["Sibling", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/Sibling"]], "InlineFormula"], " combinators are not accepted here, since deletion by relative position is ambiguous."}], "Text"]}, Open]],
Cell[CellGroupData[{Cell["Extracting Text", "Section"],
Cell[TextData[{"Two functions turn a tree into a string, and the choice between them is the same one the web platform draws between ", Cell[BoxData[StyleBox["textContent", "TR"]], "InlineFormula"], " and ", Cell[BoxData[StyleBox["innerText", "TR"]], "InlineFormula"], ". ", Cell[BoxData[ButtonBox["HTMLTextContent", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLTextContent"]], "InlineFormula"], " is the lossless concatenation of every descendant string in document order. It is faithful but verbose, preserving source whitespace and inserting nothing at block boundaries. ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " renders the tree as it is ", StyleBox["meant", FontSlant->"Italic"], " to read: whitespace runs collapse, block-level tags break onto their own lines, ", Cell[BoxData[StyleBox["br", "TR"]], "InlineFormula"], " becomes a newline, ", Cell[BoxData[StyleBox["pre", "TR"]], "InlineFormula"], " stays verbatim, and non-rendered tags are dropped. Those rules are a browser's: the markup keeps every space and newline an author typed, and the collapsing happens only at layout, where a run of whitespace comes out as a single space and whitespace between two blocks comes out as nothing. This is where the indentation strings of the imported tree go. Compare the two on the pruned page:"}], "Text"],
Cell[BoxData["{HTMLTextContent[readable],HTMLInnerText[readable]}"], "Input"],

Cell[BoxData[RowBox[{"{", RowBox[{"\"\\n  Tureen Soup Bar\\n  Seasonal bowls, made to order.\\n  \\n  MisoPhoRamen (sold out)\\n  \\n\"", ",", "\"Tureen Soup Bar\\nSeasonal bowls, made to order.\\nMiso\\nPho\\nRamen (sold out)\""}], "}"}]], "Output"],
Cell[TextData[{Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], " classifies each element by tag alone, using a frozen snapshot of the default user-agent stylesheet; it never reads a page's CSS. The ", Cell[BoxData[StyleBox["\"Roles\"", "TR"]], "InlineFormula"], " option overrides that classification with rules whose left-hand sides are XML patterns, and ", Cell[BoxData[StyleBox["\"BlockSeparator\"", "TR"]], "InlineFormula"], " sets the string that joins block boundaries. Skip the list items with the ", Cell[BoxData["\"\<\!\(\*StyleBox[\"specials\", \"TI\"]\)\>\""], "InlineFormula"], " class:"}], "Text"],
Cell[BoxData["HTMLInnerText[readable,\"Roles\"->{XMLPattern[\"li\",\"classList\"->\"specials\"]->\"Skip\"}]"], "Input"],

Cell[BoxData["\"Tureen Soup Bar\\nSeasonal bowls, made to order.\\nPho\\nRamen (sold out)\""], "Output"],
Cell["A rule is tried against one element at a time, so its left-hand side is an element pattern, never a combinator.", "Text"]}, Open]],
Cell[CellGroupData[{Cell["Converting to a Notebook", "Section"],
Cell[TextData[{"When plain text is too lossy (you want the headings, lists, links, and emphasis to survive), ", Cell[BoxData[ButtonBox["HTMLToNotebook", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLToNotebook"]], "InlineFormula"], " projects the tree into a ", Cell[BoxData[ButtonBox["Notebook", BaseStyle -> "Link", ButtonData -> "paclet:ref/Notebook"]], "InlineFormula"], " expression. Block tags become cells and inline tags become boxes; from that notebook, Markdown, PDF, RTF, and on-screen display all follow through ", Cell[BoxData[ButtonBox["Export", BaseStyle -> "Link", ButtonData -> "paclet:ref/Export"]], "InlineFormula"], ". The notebook is the common ancestor of every one of those outputs, which is why it, rather than a direct string emitter, is the primitive. Convert the pruned page to Markdown:"}], "Text"],
Cell[BoxData["ExportString[HTMLToNotebook[readable],\"Markdown\"]"], "Input"],

Cell[BoxData["\"# Tureen Soup Bar\\n\\nSeasonal **bowls**, made to order.\\n\\n- [Miso](/miso)\\n\\n- [Pho](/pho)\\n\\n- [Ramen (sold out)](/ramen)\""], "Output"],
Cell[TextData[{"Headings map to a descending ladder of cell styles, ", Cell[BoxData[StyleBox["li", "TR"]], "InlineFormula"], " to depth-aware ", Cell[BoxData[ButtonBox["Item", BaseStyle -> "Link", ButtonData -> "paclet:ref/Item"]], "InlineFormula"], " styles, and inline ", Cell[BoxData[StyleBox["b", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["i", "TR"]], "InlineFormula"], ", ", Cell[BoxData[StyleBox["code", "TR"]], "InlineFormula"], ", and ", Cell[BoxData[StyleBox["a", "TR"]], "InlineFormula"], " to their Markdown equivalents. Two option layers shape the result, each a list of rules from an XML pattern: ", Cell[BoxData[StyleBox["\"Roles\"", "TR"]], "InlineFormula"], " re-decides block-versus-inline placement (the layer shared with ", Cell[BoxData[ButtonBox["HTMLInnerText", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/ref/HTMLInnerText"]], "InlineFormula"], "), while ", Cell[BoxData[StyleBox["\"Constructs\"", "TR"]], "InlineFormula"], " supplies the concrete form: a cell style, an inline token, or a constructor function ", Cell[BoxData[RowBox[{StyleBox["element", "TI"], "\[RuleDelayed]", "Cell/boxes"}]], "InlineFormula"], " for anything bespoke, which receives the element as it is in the tree. With these verbs (pattern, combinator, delete, two text projections, and the notebook conversion), a page goes from imported markup to exactly the shape your computation needs."}], "Text"]}, Open]],

Cell[CellGroupData[{

Cell["Related Guides", "TutorialMoreAboutSection"],

Cell[TextData[ButtonBox["BeautifulTureen", BaseStyle -> "Link", ButtonData -> "paclet:MaximilienTirard/BeautifulTureen/guide/BeautifulTureen"]], "TutorialMoreAbout"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Related Tech Notes", "RelatedTutorialsSection"],

Cell["XXXX", "RelatedTutorials"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Metadata", "MetadataSection"],

Cell[TextData[{
 "New in: ",
 Cell["XX", "HistoryData",
  CellTags->"New"],
 " | Modified in: ",
 Cell[" ", "HistoryData",
  CellTags->"Modified"],
 " | Obsolete in: ",
 Cell[" ", "HistoryData",
  CellTags->"Obsolete"]
}], "History"],

Cell[CellGroupData[{

Cell["Categorization", "CategorizationSection"],

Cell["Tech Note", "Categorization",
 CellLabel->"Entity Type"],

Cell["MaximilienTirard/BeautifulTureen", "Categorization",
 CellLabel->"Paclet Name"],

Cell["MaximilienTirard`BeautifulTureen`", "Categorization",
 CellLabel->"Context"],

Cell["MaximilienTirard/BeautifulTureen/tutorial/ScrapingHTMLWithBeautifulTureen", "Categorization",
 CellLabel->"URI"]
}, Closed]],

Cell[CellGroupData[{

Cell["Keywords", "KeywordsSection"],

Cell["XXXX", "Keywords"]
}, Closed]]
}, Open  ]]
},
TaggingRules->Association["Paclet" -> "None"],
StyleDefinitions->FrontEnd`FileName[{"Wolfram"}, "TechNotePageStylesExt.nb", 
  CharacterEncoding -> "UTF-8"]
]
(* End of Notebook Content *)
